---
import { eventHref, monthYear, nextMeetup, pastEvents, eventTalks, talkAnchor, groupPartners } from '@zurichjs/events';
import { localBusinessSchema, organizationSchema, websiteSchema } from '@zurichjs/seo';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ConferenceModule from '@zurichjs/design/components/ConferenceModule.astro';
import HomeHero from '@zurichjs/design/components/HomeHero.astro';
import HostsSection from '@zurichjs/design/components/HostsSection.astro';
import SpeakCta from '@zurichjs/design/components/SpeakCta.astro';
import { SpeakerCarousel, type CarouselSpeaker } from '~/components/islands/home/SpeakerCarousel';
import { sizedSrc, srcsetFor } from '@zurichjs/design/images';
import { COUNTRIES_REACHED, PARTNERS_TO_DATE, SPEAKER_COMPANIES, speakersWithTalks } from '@zurichjs/content';
import AwardSection from '@zurichjs/design/components/AwardSection.astro';
import SpeakerCompanies from '@zurichjs/design/components/SpeakerCompanies.astro';
import TalkRow, { type TalkRowData } from '@zurichjs/design/components/TalkRow.astro';
import Photo from '@zurichjs/design/components/Photo.astro';
import PackedGrid from '@zurichjs/design/components/PackedGrid.astro';
import { BUILD_TIME, SITE, content, ticketing } from '~/lib/content';
import { HERO_PHOTOS } from '~/lib/hero';
import { COMMUNITY_GRID, PAGE_PHOTOS } from '~/lib/photos';

const { events, speakers, rating, award, conference, partners } = await content();
const next = nextMeetup(events, BUILD_TIME);
const byId = new Map(speakers.map((s) => [s.id, s]));

// The latest past talks, each linking straight to the talk on its event page.
const talks: TalkRowData[] = [];
outer: for (const ev of pastEvents(events, BUILD_TIME)) {
  for (const t of eventTalks(ev)) {
    talks.push({
      title: t.title,
      speakers: t.speakerIds.map((id) => byId.get(id)).filter((s) => !!s),
      date: ev.startsAt ? monthYear(ev.startsAt) : '',
      format: t.format === 'lightning' ? 'Lightning talk' : t.format === 'deep-dive' ? 'Deep dive' : 'Talk',
      href: `${eventHref(ev)}#${talkAnchor(t)}`,
    });
    if (talks.length === 4) break outer;
  }
}
// The carousel: speakers who gave a talk at an event, most recent first, photos sized for the card.
const lastTalk = (s: (typeof speakers)[number]) => s.talks.flatMap((t) => t.eventSlugs.map((x) => events.find((e) => e.slug === x)?.startsAt ?? '')).sort().pop() ?? '';
const carousel: CarouselSpeaker[] = speakersWithTalks(speakers)
  .sort((a, b) => lastTalk(b).localeCompare(lastTalk(a)) || a.name.localeCompare(b.name))
  .slice(0, 24)
  .map((s) => ({
    id: s.id,
    name: s.name,
    meta: s.tagline || s.role,
    initials: s.initials,
    photo: s.photo ? { src: sizedSrc(s.photo.src, 720), srcset: srcsetFor(s.photo.src), alt: s.photo.alt, position: s.photo.position } : undefined,
  }));
// The hero photos are set by hand in ~/lib/hero.ts (owner), never picked from ImageKit.
// The section photos are set by hand too (~/lib/photos.ts).
// Current sponsors (only those marked current) at their tier's logo size, then venue hosts and current partners.
const partnerGroups = groupPartners(partners);
// Everyone who supported ZurichJS before (sponsors, hosts and partners), by name; delisted partners never appear.
// The conference module is a development placeholder: shown locally, or on a build that sets
// SHOW_PREVIEW_MODULES=true (only for password-protected deploy previews), never on the public site.
const showPreviewModules = import.meta.env.DEV || process.env.SHOW_PREVIEW_MODULES === 'true';
const pastSupporters = [...partnerGroups.pastSponsors, ...partnerGroups.venues.filter((p) => !p.current), ...partnerGroups.pastPartners].sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout
  title="ZurichJS"
  fullTitle="ZurichJS · JavaScript & TypeScript meetups in Zurich, Switzerland"
  description="The JavaScript and TypeScript community in Zurich: free monthly meetups with talks on React, Node.js, Vue, Angular, AI and the web, run by volunteers."
  keywords={['JavaScript meetup Zurich', 'TypeScript meetup Zurich', 'Zurich tech events', 'React Zurich', 'Node.js Zurich', 'Vue Zurich', 'Angular Zurich', 'web development Zurich', 'developer community Switzerland', 'tech talks Zurich', 'ZurichJS']}
  geo
  jsonLd={[organizationSchema(), websiteSchema(), localBusinessSchema()]}
>
  <HomeHero slot="opening" next={next} now={BUILD_TIME} ticketing={ticketing} photos={HERO_PHOTOS} meetupGroupUrl={SITE.meetupGroupUrl} />
  <div class="flex flex-col gap-[clamp(64px,8vw,112px)] pt-[clamp(56px,7vw,104px)]">
    <div class="flex flex-col gap-[clamp(32px,4vw,56px)]">
      <AwardSection
        award={award}
        photo={PAGE_PHOTOS.award}
        rating={rating}
        storyUrl="https://conf.zurichjs.com/blog/how-zurichjs-got-here"
        stats={[
          { value: '1K+', label: 'Meetup members' },
          { value: PARTNERS_TO_DATE, label: 'partners and sponsors' },
          { value: COUNTRIES_REACHED, label: 'countries our speakers and attendees come from' },
        ]}
      />
      <PackedGrid items={COMMUNITY_GRID.map((g) => ({ id: g.id, sizes: g.sizes, priority: g.priority }))} columns={{ base: 4, md: 6 }} label="Photos from ZurichJS meetups" class="px-gut">
        {(id: string) => {
          const g = COMMUNITY_GRID.find((x) => x.id === id)!;
          return <Photo photo={g.photo} class="w-full h-full rounded-card!" sizes="(min-width: 800px) 50vw, 100vw" />;
        }}
      </PackedGrid>
    </div>

    {
      talks.length > 0 && (
        <section aria-labelledby="h-talks" class="px-gut flex flex-col gap-7">
          <div class="flex justify-between items-baseline gap-4 flex-wrap">
            <h2 id="h-talks" class="m-0 text-[clamp(30px,3.4vw,48px)] leading-[1.1] font-bold">
              Talks from past meetups
            </h2>
            <a href="/events?tab=past" class="font-bold text-[18px] underline underline-offset-4">
              All past events
            </a>
          </div>
          <div class="flex flex-col gap-2">
            {talks.map((t) => (
              <TalkRow t={t} />
            ))}
          </div>
        </section>
      )
    }

    {showPreviewModules && <ConferenceModule conference={conference} preview />}

    <section aria-labelledby="h-speakers" class="flex flex-col gap-7 overflow-x-clip">
      <div class="px-gut flex justify-between items-baseline gap-4 flex-wrap">
        <h2 id="h-speakers" class="m-0 text-[clamp(30px,3.4vw,48px)] leading-[1.1] font-bold">Meet the speakers</h2>
        <a href="/speakers" class="font-bold text-[18px] underline underline-offset-4">All speakers</a>
      </div>
      <SpeakerCarousel client:visible speakers={carousel} />
      <div class="px-gut pt-[clamp(24px,3vw,40px)]">
        <SpeakerCompanies companies={SPEAKER_COMPANIES} headingId="h-speaker-companies" as="h2" />
      </div>
    </section>

    <SpeakCta />
  </div>
  <div class="pt-[clamp(64px,8vw,112px)] pb-[clamp(64px,8vw,112px)]">
    <HostsSection
      sponsors={partnerGroups.currentSponsors}
      partners={[...partnerGroups.venues.filter((p) => p.current), ...partnerGroups.conferences, ...partnerGroups.communities, ...partnerGroups.supporting]}
      past={pastSupporters}
    />
  </div>
</BaseLayout>
