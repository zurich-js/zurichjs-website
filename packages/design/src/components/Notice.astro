---
/**
 * Feedback and important notes: replaces the success and error panels of the forms and static notes
 * like the code of conduct. Green only for success, red only for errors. The Preact twin is islands/Notice.tsx.
 */
import { noticeClass, type NoticeTone } from '../recipes';

interface Props {
  tone?: NoticeTone;
  title: string;
  /** For results of an action (form sent, form failed): announced to screen readers. */
  live?: boolean;
  /** The title as a heading, when the notice replaces a page's content (a form's result). */
  as?: 'p' | 'h2' | 'h3';
  id?: string;
  class?: string;
}
const { tone = 'note', title, live = false, as: Title = 'p', id, class: extra } = Astro.props;
const role = live ? (tone === 'danger' ? 'alert' : 'status') : undefined;
---

<div id={id} role={role} class={noticeClass(tone, extra)}>
  {
    Astro.slots.has('icon') && (
      <span aria-hidden="true" class="flex-none size-11 rounded-nested-min bg-grey-soft flex items-center justify-center">
        <slot name="icon" />
      </span>
    )
  }
  <div class="flex flex-col gap-1.5 min-w-0">
    <Title class="m-0 font-bold text-card-title">{title}</Title>
    <div class="flex flex-col gap-2 text-compact"><slot /></div>
  </div>
</div>
