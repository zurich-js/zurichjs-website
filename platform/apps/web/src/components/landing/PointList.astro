---
/** A list of points with a bold lead, as cards in a grid ("Consistent rhythm: monthly events …"). */
import { cx } from '~/lib/ui';

interface Props {
  items: { t: string; d: string }[];
  min?: number;
  class?: string;
}
const { items, min = 300, class: extra } = Astro.props;
---

<ul class={cx('m-0 p-0 list-none grid gap-4', extra)} style={`grid-template-columns: repeat(auto-fit, minmax(min(100%, ${min}px), 1fr))`}>
  {
    items.map((it) => (
      <li class="rounded-card bg-grey-soft p-6 flex flex-col gap-1.5">
        <strong class="text-[19px] leading-[1.3]">{it.t}</strong>
        <span class="text-[17px] leading-[1.55] text-ink-2 text-pretty">{it.d}</span>
      </li>
    ))
  }
</ul>
