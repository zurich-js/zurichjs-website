# The environment schema for running zurichjs.com on your machine (varlock, https://varlock.dev).
# `just up` and `just env` load it, then .env, then .env.local (which wins; both git-ignored),
# resolve 1Password references and check every value before anything starts.
#
# Values go in .env.local, never here: plain (KEY=value) or from 1Password
# (KEY=op("op://vault/item/field"), resolved through the signed-in `op` CLI and desktop app).
# What each variable does: docs/systems/operations/environment.md. Production values live in Netlify.
#
# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=true)
# @defaultRequired=false @defaultSensitive=false
# ---

# --- Stripe: the local stack always runs in a sandbox (test mode) ---

# The sandbox's secret key (Stripe dashboard › Developers › API keys). A live key is refused.
# @required @sensitive @type=string(matches=regex("^(sk|rk)_test_"))
STRIPE_SECRET_KEY=

# The billing portal configuration, printed by `pnpm membership:stripe-setup --apply`.
# @required @type=string(startsWith=bpc_)
STRIPE_MEMBER_PORTAL_CONFIG=

# A sponsor-only billing portal configuration (default: the member one).
# @type=string(startsWith=bpc_)
STRIPE_SPONSOR_PORTAL_CONFIG=

# The product donations are booked on, for /donate.
# @type=string(startsWith=prod_)
STRIPE_SUPPORT_PRODUCT_ID=

# The Stripe customer-portal login link for monthly donors.
# @type=url
PUBLIC_STRIPE_PORTAL_URL=

# --- Content ---

# `sample` (the default in docker-compose.yml) needs no network; `sanity` reads the real project.
# @type=enum(sample, sanity)
CONTENT_SOURCE=

SANITY_PROJECT_ID=
# Unset means `production`, which is public: reading it needs no token.
SANITY_DATASET=
# Writing to the `production` dataset is refused by the code unless this is 1. It is set by hand on
# the production deploy; leave it out here, so nothing on your machine changes production content.
# @type=enum(1)
SANITY_ALLOW_PRODUCTION_WRITES=
# @sensitive
SANITY_TOKEN=
# @sensitive
SANITY_READ_TOKEN=
# @sensitive
SANITY_WRITE_TOKEN=
# @type=enum(drafts, published)
SANITY_PERSPECTIVE=
# Fixes the build's clock, e.g. 2026-11-01T12:00:00+01:00.
BUILD_NOW=
# @type=boolean
SHOW_PREVIEW_MODULES=
# @sensitive
IMAGEKIT_PRIVATE_KEY=
# @type=url
SANE_API_URL=
# @type=url
SANE_WEB_URL=
PUBLIC_GOOGLE_MAPS_EMBED_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
# @type=url
NEXT_PUBLIC_POSTHOG_HOST=

# --- Membership, sponsorship and the admin area ---

# The board's password for /admin (default in docker-compose.yml: local-admin-password-docker).
# @sensitive
ADMIN_PASSWORD=
# A path inside the container, where the repository is /app, e.g. /app/.local/signature.png.
# @type=string(startsWith=/app/)
MEMBERSHIP_SIGNATURE_FILE=
MEMBERSHIP_FROM=
# @sensitive
JWT_SECRET=

# --- Forms and email (the local stack sends every email to Mailpit) ---

# @sensitive
RESEND_API_KEY=
FORMS_TO=
FORMS_FROM=
# @sensitive
EMAIL_OCTOPUS_API_KEY=
EMAIL_OCTOPUS_LIST_ID=

# --- Slack: form notifications, the content agent and the CFP bot ---

# @sensitive @type=string(startsWith=xoxb-)
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=
# @sensitive @type=url
SLACK_WEBHOOK_URL=
# @sensitive @type=string(startsWith=xoxb-)
SLACK_AGENT_BOT_TOKEN=
# @sensitive
SLACK_SIGNING_SECRET=
SLACK_AGENT_CHANNEL_ID=
SLACK_PUBLISHER_IDS=
SLACK_MEMBERSHIP_CHANNEL_ID=
SLACK_MEMBERSHIP_APPROVER_IDS=
SLACK_SPONSORSHIP_CHANNEL_ID=
# The dev app's app-level token: with it, the `slack` service bridges Socket Mode to the local site.
# @sensitive @type=string(startsWith=xapp-)
SLACK_APP_TOKEN=
# @sensitive @type=string(startsWith=xoxb-)
SLACK_CFP_BOT_TOKEN=
# @sensitive
SLACK_CFP_SIGNING_SECRET=
SLACK_CFP_CHANNEL_ID=
# The CFP dev app's app-level token, for the same bridge.
# @sensitive @type=string(startsWith=xapp-)
SLACK_CFP_APP_TOKEN=
# @sensitive
SANITY_AGENT_TOKEN=
# @type=url
SANITY_STUDIO_URL=
# @type=url
DRAFT_PREVIEW_URL=

# --- The model behind the bots ---

# @type=enum(openai, anthropic, openai-compatible)
LLM_PROVIDER=
LLM_MODEL=
# @sensitive
LLM_API_KEY=
# @type=url
LLM_BASE_URL=
CFP_LLM_MODEL=
# @type=number
CFP_MAX_MODEL_CALLS_PER_DAY=
