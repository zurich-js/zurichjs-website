---
import { confLink, trackAttrs } from '../analytics';
export interface FooterSite {
  association: string;
  uid: string;
  email: string;
  meetupGroupUrl: string;
  linkedinUrl: string;
  blueskyUrl: string;
  instagramUrl: string;
}
interface Props {
  site: FooterSite;
  /** Conference lifecycle state, for analytics. */
  confState: string;
}
const { site: SITE, confState } = Astro.props;
const COLS = [
  {
    h: 'Events',
    links: [
      { label: 'Upcoming events', href: '/events' },
      { label: 'Past events', href: '/events?tab=past' },
      { label: 'Photos', href: '/media' },
      { label: 'Today', href: '/today' },
    ],
  },
  {
    h: 'Take part',
    links: [
      { label: 'Speak at a meetup', href: '/cfp' },
      { label: 'Volunteer', href: '/cfv' },
      { label: 'Host or sponsor', href: '/partners' },
      { label: 'Membership', href: '/membership' },
      { label: 'Support us', href: '/donate' },
    ],
  },
  {
    h: 'About',
    links: [
      { label: 'About ZurichJS', href: '/about' },
      { label: 'Contact', href: '/contact' },
      { label: 'For AI assistants', href: '/ai-context' },
      { label: 'Code of conduct', href: '/policies/code-of-conduct' },
      { label: 'Privacy policy', href: '/policies/privacy-policy' },
      { label: 'Terms and conditions', href: '/policies/terms-and-conditions' },
      { label: 'Refund policy', href: '/policies/refund-policy' },
    ],
  },
];
const SOCIAL = [
  { label: 'Meetup', href: SITE.meetupGroupUrl },
  { label: 'LinkedIn', href: SITE.linkedinUrl },
  { label: 'Bluesky', href: SITE.blueskyUrl },
  { label: 'Instagram', href: SITE.instagramUrl },
];
---

<footer class="on-black bg-black text-white pt-[clamp(48px,6vw,88px)] pb-8 px-gut flex flex-col gap-[clamp(40px,5vw,64px)]">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,190px),1fr))] gap-x-10 gap-y-8">
    <div class="flex flex-col gap-4 col-span-full md:col-span-2 max-w-[420px]">
      <img src="/images/logo/wordmark-white.svg" alt="ZurichJS" width="274" height="40" loading="lazy" class="h-7 w-auto self-start max-w-full" />
      <p class="m-0 text-[17px] leading-[1.55]">JavaScript meetups in Zurich, run by volunteers. Part of the {SITE.association}, a non-profit association registered in Switzerland.</p>
      <a href={`mailto:${SITE.email}`} class="text-[17px] font-bold text-yellow no-underline hover:underline">{SITE.email}</a>
    </div>
    {
      COLS.map((c) => (
        <nav aria-label={c.h} class="flex flex-col gap-2.5">
          <h2 class="m-0 mb-1 text-[18px] font-bold">{c.h}</h2>
          {c.links.map((l) => (
            <a href={l.href} class="text-[16px] text-grey-mid no-underline hover:text-white hover:underline">
              {l.label}
            </a>
          ))}
        </nav>
      ))
    }
  </div>
  <div class="flex flex-wrap gap-x-8 gap-y-4 items-center justify-between">
    <div class="flex items-center gap-3.5 flex-wrap">
      <img src="/images/logo/wordmark-conf-white.svg" alt="ZurichJS Conf" width="300" height="40" loading="lazy" class="h-[22px] w-auto max-w-full" />
      <a href={confLink('/', 'footer')} target="_blank" rel="noopener" class="text-[16px] text-white underline underline-offset-[3px]" {...trackAttrs('conf_outbound_click', { placement: 'footer', confstate: confState })}>conf.zurichjs.com</a>
    </div>
    <div class="flex gap-[18px] flex-wrap text-[16px]">
      {
        SOCIAL.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" class="text-grey-mid no-underline hover:text-white">
            {s.label}
          </a>
        ))
      }
    </div>
  </div>
  <p class="m-0 text-[14px] text-grey-mid">© {new Date().getFullYear()} {SITE.association} ({SITE.uid})</p>
</footer>
