---
/** Not found. The search is a plain GET form to /events, so it works without JavaScript. */
import PageOpening from '@zurichjs/design/components/PageOpening.astro';
import Heading from '@zurichjs/design/components/Heading.astro';
import Button from '@zurichjs/design/components/Button.astro';
import Card from '@zurichjs/design/components/Card.astro';
import AutoGrid from '@zurichjs/design/components/AutoGrid.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE, nextMeetupHref } from '~/lib/content';

const nextHref = await nextMeetupHref();
const LINKS = [
  { h: 'Upcoming events', d: 'The next meetups in Zurich.', href: '/events' },
  { h: 'Past talks', d: 'Every talk and who gave it.', href: '/events?tab=past' },
  { h: 'Speakers', d: 'Everyone who has spoken.', href: '/speakers' },
  { h: 'Speak at a meetup', d: 'Propose a talk.', href: '/cfp' },
  { h: 'About ZurichJS', d: 'Who runs it and how.', href: '/about' },
  { h: 'Photos and videos', d: 'From past meetups.', href: '/media' },
  { h: 'Support ZurichJS', d: 'Donate once or monthly.', href: '/donate' },
  { h: 'Membership', d: 'Join the association.', href: '/membership' },
  { h: 'Contact', d: 'Reach the organisers.', href: '/contact' },
];
---

<BaseLayout title="Page not found" path="/404" description="This page does not exist. Find upcoming JavaScript meetups, past talks and speakers at ZurichJS, the JavaScript community in Zurich." noindex>
  <PageOpening
    slot="opening"
    title="We couldn’t find that page"
    sub="The link may be old, or the page moved when we rebuilt the site. Even JavaScript can’t find everything. Try a search or one of the pages below."
  >
    <div class="flex flex-col gap-4 pt-1 max-w-form">
      <form action="/events" method="get" role="search" class="flex items-center gap-2.5 bg-ink rounded-pill pl-5 pr-2 min-h-14">
        <label for="nf-q" class="sr-only">Search events, talks and speakers</label>
        <input id="nf-q" type="search" name="q" placeholder="Search events, talks, speakers" class="flex-1 min-w-0 border-0 bg-transparent text-white text-body outline-offset-6 placeholder:text-grey-mid" />
        <Button type="submit" variant="cta">Search</Button>
      </form>
      <div class="flex flex-wrap gap-3">
        <Button href="/" variant="secondary" inverse>Go to the homepage</Button>
        <Button href={nextHref} variant="secondary" inverse>See the next meetup</Button>
      </div>
    </div>
  </PageOpening>

  <div class="px-gut py-section flex flex-col gap-5">
    <Heading size="subsection">Popular pages</Heading>
    <AutoGrid min="sm" gap="sm">
      {
        LINKS.map((l) => (
          <Card href={l.href} title={l.h} surface="filled">
            <p class="m-0 text-compact text-ink-2">{l.d}</p>
          </Card>
        ))
      }
    </AutoGrid>
    <p class="m-0 mt-3 text-body text-ink-2">
      If you followed a link from our site, tell us at <a href={`mailto:${SITE.email}`} class="font-bold">{SITE.email}</a> and we will fix it.
    </p>
  </div>
</BaseLayout>
