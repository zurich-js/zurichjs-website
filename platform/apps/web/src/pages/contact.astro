---
import PageOpening from '@zurichjs/design/components/PageOpening.astro';
import ContactForm from '~/components/islands/forms/ContactForm';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { confLink } from '@zurichjs/design/analytics';
import { SITE } from '~/lib/content';
import { cx, isExternal } from '@zurichjs/design/recipes';

const ROUTES = [
  { h: 'Give a talk', d: 'Propose a talk for a meetup.', href: '/cfp', yellow: false },
  { h: 'Host or sponsor', d: 'Rooms, food and community partnerships.', href: '/partners', yellow: false },
  { h: 'Report a code of conduct concern', d: 'Handled in confidence by the organisers.', href: '/policies/code-of-conduct', yellow: true },
  { h: 'Conference questions', d: 'Tickets, invoices and the conference CFP.', href: confLink('/contact', 'contact'), yellow: false },
];
---

<BaseLayout
  image="/og/contact.png"
  title="Contact"
  fullTitle="Contact ZurichJS · JavaScript Community in Zurich"
  description="Contact the ZurichJS organisers about a meetup, speaking, hosting or sponsoring. Real people from the JavaScript community in Zurich reply by email."
  keywords={['contact ZurichJS', 'JavaScript community Zurich', 'JavaScript meetup Zurich', 'ZurichJS organisers']}
>
  <PageOpening
    slot="opening"
    title="Contact the organisers"
    sub="Questions about a meetup, speaking, hosting or anything else. Real people read these, usually between a day job and the next meetup."
  />
  <div class="px-gut pt-[clamp(56px,7vw,104px)] pb-[clamp(64px,8vw,112px)] grid grid-cols-[repeat(auto-fit,minmax(min(100%,360px),1fr))] gap-[clamp(40px,5vw,80px)] items-start">
    <section aria-labelledby="h-routes" class="flex flex-col gap-[18px]">
      <h2 id="h-routes" class="m-0 text-[clamp(26px,2.8vw,36px)] leading-[1.15] font-bold">Faster for these</h2>
      <div class="flex flex-col gap-2.5">
        {
          ROUTES.map((r) => (
            <a
              href={r.href}
              {...(isExternal(r.href) ? { target: '_blank', rel: 'noopener' } : {})}
              class={cx(
                'no-underline text-black text-left rounded-[20px] py-[18px] px-5 grid grid-cols-[minmax(0,1fr)_auto] gap-3 items-center',
                r.yellow ? 'bg-yellow hover:bg-yellow-hover' : 'bg-grey hover:bg-grey-hover',
              )}
            >
              <span class="flex flex-col gap-[3px]">
                <span class="text-[18px] font-bold">{r.h}</span>
                <span class="text-[16px] leading-[1.45] text-ink-2">{r.d}</span>
              </span>
              <span aria-hidden="true" class="w-10 h-10 rounded-pill flex items-center justify-center font-bold bg-white">→</span>
            </a>
          ))
        }
      </div>
      <p class="m-0 mt-1.5 text-[17px] leading-[1.55] text-ink-2">
        Or email <a href={`mailto:${SITE.email}`} class="font-bold">{SITE.email}</a>. The organisers are volunteers and reply between meetups.
      </p>
    </section>
    <section aria-labelledby="h-cform" class="flex flex-col gap-[18px]">
      <h2 id="h-cform" class="m-0 text-[clamp(26px,2.8vw,36px)] leading-[1.15] font-bold">Send a message</h2>
      <ContactForm client:load />
    </section>
  </div>
</BaseLayout>
