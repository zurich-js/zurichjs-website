---
/**
 * Event list: every meetup on one page, so every event link is in the HTML. Upcoming meetups come first,
 * in date order; past meetups follow, newest first, dimmed until hovered. A sticky bar holds the search, which
 * filters both and keeps its text in the URL (?q=…; ?search= is accepted as an alias because the WebSite
 * SearchAction points there). The #upcoming and #past anchors stay for old links.
 * Old links to ?tab=past land on the past section.
 */
import { pastEvents, upcomingEvents, type Event } from '@zurichjs/events';
import { breadcrumbSchema } from '@zurichjs/seo';
import PageOpening from '@zurichjs/design/components/PageOpening.astro';
import EventRow from '@zurichjs/design/components/EventRow.astro';
import Button from '@zurichjs/design/components/Button.astro';
import Card from '@zurichjs/design/components/Card.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import RetiredNotice from '~/components/RetiredNotice.astro';
import { BUILD_TIME, SITE, content, ticketing } from '~/lib/content';

const { events, speakers } = await content();
const byId = new Map(speakers.map((s) => [s.id, s.name]));
const upcoming = upcomingEvents(events, BUILD_TIME);
const past = pastEvents(events, BUILD_TIME);

/** Everything the search box matches: title, description, venue, talk titles and speaker names. */
const hay = (e: Event) =>
  [
    e.title,
    e.description,
    e.venue?.name,
    ...e.agenda.map((a) => a.title),
    ...e.agenda.flatMap((a) => [...(a.talk?.tags ?? []), ...(a.talk?.speakerIds ?? []).map((id) => byId.get(id))]),
    ...(e.recap?.talks.flatMap((t) => [t.title, ...t.speakerIds.map((id) => byId.get(id))]) ?? []),
  ]
    .filter(Boolean)
    .join(' ')
    // Case and accents ignored: "nicolo" finds "Nicolò".
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase();

const SECTIONS = [
  { k: 'upcoming', heading: 'Upcoming meetups', list: upcoming },
  { k: 'past', heading: 'Past meetups', list: past },
] as const;
---

<BaseLayout
  title="Events"
  fullTitle="Upcoming and past JavaScript events in Zurich · ZurichJS"
  description="Upcoming and past ZurichJS meetups: JavaScript and TypeScript talks in Zurich for developers of all levels. Every event keeps its page, speakers and photos."
  keywords={['JavaScript meetup Zurich', 'TypeScript meetup Zurich', 'Zurich tech events', 'JavaScript events Switzerland', 'ZurichJS events']}
  jsonLd={[breadcrumbSchema([{ name: 'Events', path: '/events' }])]}
>
  <PageOpening slot="opening" title="Events" sub="JavaScript meetups in Zurich. Every past event keeps its page, speakers and photos, so the talks live on long after the night." compact />
  <RetiredNotice />

  <div class="py-section flex flex-col gap-6" data-events>
    <div class="sticky top-header z-40 bg-white px-gut py-3">
      <label class="flex flex-col min-w-0">
        <span class="sr-only">Search events, talks and speakers</span>
        <input type="search" name="q" data-q placeholder="Search events, talks, speakers" autocomplete="off" class="min-h-control border border-grey-line rounded-pill px-5 text-body bg-white min-w-0" />
      </label>
    </div>

    <div class="flex flex-col gap-control">
    {
      SECTIONS.map((t) => (
        <section id={t.k} data-section={t.k} aria-labelledby={`h-${t.k}`} class="px-gut flex flex-col gap-6 scroll-mt-40">
          <h2 id={`h-${t.k}`} class="m-0 text-subsection font-bold">
            {t.heading}
          </h2>
          <div class="flex flex-col gap-3">
            {t.list.map((e) => (
              <div data-hay={hay(e)}>
                <EventRow ev={e} now={BUILD_TIME} ticketing={ticketing} dim={t.k === 'past'} />
              </div>
            ))}
          </div>
          <div class="[[hidden]]:hidden" data-empty hidden={t.list.length > 0}>
            {t.k === 'upcoming' ? (
              <Card padding="lg">
                <h3 slot="header" class="m-0 text-card-title font-bold" data-empty-title>
                  Nothing scheduled yet.
                </h3>
                <p class="m-0 text-body text-ink-2" data-empty-sub>
                  The next meetup is being planned. It is announced on Meetup first.
                </p>
                <Button slot="footer" variant="secondary" class="[[hidden]]:hidden" data-clear hidden>
                  Clear search
                </Button>
                <Button slot="footer" variant="cta" href={SITE.meetupGroupUrl}>
                  Follow the group on Meetup
                </Button>
              </Card>
            ) : (
              <p class="m-0 text-body text-ink-2" data-empty-title>
                No past events yet.
              </p>
            )}
          </div>
        </section>
      ))
    }
    </div>
  </div>
</BaseLayout>

<script>
  import { normalizeSearch } from '@zurichjs/events';

  const root = document.querySelector<HTMLElement>('[data-events]');
  if (root) {
    const sections = [...root.querySelectorAll<HTMLElement>('[data-section]')];
    const input = root.querySelector<HTMLInputElement>('[data-q]')!;
    const params = new URLSearchParams(location.search);
    let q = params.get('q') ?? params.get('search') ?? '';
    input.value = q;

    const syncUrl = () => {
      const u = new URL(location.href);
      u.searchParams.delete('search');
      u.searchParams.delete('tab');
      if (q) u.searchParams.set('q', q);
      else u.searchParams.delete('q');
      history.replaceState(history.state, '', u.pathname + u.search + u.hash);
    };

    const render = () => {
      const tokens = normalizeSearch(q).split(' ').filter(Boolean);
      const needle = tokens.join(' ');
      for (const s of sections) {
        let shown = 0;
        for (const row of s.querySelectorAll<HTMLElement>('[data-hay]')) {
          const match = tokens.every((t) => (row.dataset.hay ?? '').includes(t));
          row.hidden = !match;
          if (match) shown++;
        }
        const empty = s.querySelector<HTMLElement>('[data-empty]')!;
        empty.hidden = shown > 0;
        const upcoming = s.dataset.section === 'upcoming';
        empty.querySelector('[data-empty-title]')!.textContent = needle
          ? `No ${upcoming ? 'upcoming' : 'past'} events match “${q.trim()}”.`
          : upcoming
            ? 'Nothing scheduled yet.'
            : 'No past events yet.';
        const sub = empty.querySelector('[data-empty-sub]');
        if (sub) sub.textContent = needle ? 'Try a speaker name or a topic, or clear the search.' : 'The next meetup is being planned. It is announced on Meetup first.';
        const clear = empty.querySelector<HTMLElement>('[data-clear]');
        if (clear) clear.hidden = !needle;
      }
    };

    input.addEventListener('input', () => {
      q = input.value;
      syncUrl();
      render();
    });
    for (const b of root.querySelectorAll<HTMLButtonElement>('[data-clear]')) {
      b.addEventListener('click', () => {
        q = '';
        input.value = '';
        syncUrl();
        render();
        input.focus();
      });
    }
    render();
    // Old links (?tab=past) land on the past section.
    if (params.get('tab') === 'past') {
      document.getElementById('past')?.scrollIntoView();
      syncUrl();
    }
  }
</script>
