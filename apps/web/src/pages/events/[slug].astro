---
/**
 * Event page. One URL for the whole life of an event: upcoming (RSVP), live
 * (48 h feedback window with per-talk rating), then the recap. The state is
 * prerendered as of the build; islands follow the clock in the browser, and
 * scheduled rebuilds at doors and doors + 48 h refresh the HTML.
 */
import { dateLong, eventHref, eventSupporters, groupPartners, eventTalks, nextMeetup, presentEvent, recapSummary, resolveState, timesLine, type Event } from '@zurichjs/events';
import { breadcrumbSchema, canonicalUrl, eventSchema } from '@zurichjs/seo';
import PageOpening from '@zurichjs/design/components/PageOpening.astro';
import EventActions from '~/components/islands/event/EventActions';
import EventBanner from '~/components/islands/event/EventBanner';
import EventSummary from '~/components/islands/event/EventSummary';
import FeedbackGate from '~/components/islands/event/FeedbackGate';
import Programme from '~/components/islands/event/Programme';
import { avatarSrc } from '@zurichjs/design/images';
import VenueCard from '~/components/islands/event/VenueCard';
import SupporterList from '~/components/SupporterList.astro';
import Button from '@zurichjs/design/components/Button.astro';
import { Gallery } from '@zurichjs/design/islands/Gallery';
import { sizedSrc } from '@zurichjs/design/images';
import { eventPhotoState, mediaForEvent } from '@zurichjs/content';
import { countLabel, mediaHref, toGallery } from '~/lib/media';
import Surface from '@zurichjs/design/components/Surface.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { BUILD_TIME, MAPS_EMBED_KEY, PREVIEW, SITE, content, ticketing } from '~/lib/content';
import { clip } from '~/lib/text';

export async function getStaticPaths() {
  const { events } = await content();
  return events.map((ev) => ({ params: { slug: ev.slug }, props: { ev } }));
}

const { ev } = Astro.props as { ev: Event };
const c = await content();
const state = resolveState(ev, BUILD_TIME);
const p = presentEvent(ev, { now: BUILD_TIME, ticketing });
const url = canonicalUrl(eventHref(ev));
const byId = new Map(c.speakers.map((s) => [s.id, s]));
const speakerIds = [...new Set([...eventTalks(ev).flatMap((t) => t.speakerIds), ...(ev.recap?.talks.flatMap((t) => t.speakerIds) ?? [])])];
const speakers = speakerIds.map((id) => byId.get(id)).filter((s) => !!s);
const progSpeakers = speakers.map(({ id, name, role, initials, photo }) => ({ id, name, role, initials, avatar: photo ? avatarSrc(photo.src, 36) : undefined }));
const hosts = c.partners.filter((h) => ev.hosts?.includes(h.id));
const supporters = eventSupporters(ev, c.partners);
// Current sponsors appear on every upcoming meetup page (the /partners promise), after the event's own supporters.
const seasonSponsors = groupPartners(c.partners).currentSponsors.filter((p) => !supporters.some((x) => x.partner.id === p.id));
const gallery = mediaForEvent(c.media.items, ev.slug);
// Honest about missing photos: "unavailable" when this build could not read the archive, never "coming soon".
const evEnd = ev.endsAt ?? ev.startsAt;
const photoState = eventPhotoState(gallery.length, c.media, evEnd ? new Date(evEnd) : undefined, BUILD_TIME);
const isPast = state === 'past';
const next = nextMeetup(c.events, BUILD_TIME);
const nextP = next ? presentEvent(next, { now: BUILD_TIME, ticketing }) : null;
const description = clip(isPast ? `${recapSummary(ev, { photos: gallery.filter((m) => m.kind === 'photo').length })} ${ev.description}` : `${p.dateLineShort} · ${p.venueShort}. ${ev.description}`);
const jsonLd = [eventSchema(ev, c.speakers, hosts), breadcrumbSchema([{ name: 'Events', path: '/events' }, { name: ev.title, path: eventHref(ev) }])];
const firstPhoto = gallery.find((m) => m.kind === 'photo');
const image = firstPhoto ? sizedSrc(firstPhoto.src, 1200) : (ev.cover?.src ?? `/og/event-${ev.slug}.png`);
const times = timesLine(ev);
const summaries = Object.fromEntries((ev.recap?.talks ?? []).filter((t) => t.summary).map((t) => [t.title, t.summary]));
// Recap talks that are not in the programme (older events) still get listed.
const recapOnly = (ev.recap?.talks ?? []).filter((t) => !eventTalks(ev).some((x) => x.title === t.title));
const hasTalks = eventTalks(ev).length > 0;
const speakingOpen = !isPast && state !== 'cancelled' && (!hasTalks || ev.agenda.some((a) => /\b(tba|tbc|to be announced|open slot)\b/i.test(a.title)));
---

<BaseLayout title={ev.title} description={description} image={image} jsonLd={jsonLd}>
  {
    isPast ? (
      <PageOpening slot="opening" title={ev.title} crumb={{ label: 'Events', href: '/events?tab=past', here: ev.startsAt ? dateLong(ev.startsAt) : 'Past' }} sub={recapSummary(ev, { photos: gallery.filter((m) => m.kind === 'photo').length })} />
    ) : (
      <PageOpening slot="opening" title={ev.title} crumb={{ label: 'Events', href: '/events', here: p.crumb }} pills={p.pills}>
        <div class="flex flex-col gap-[18px] pt-1">
          <div class="text-[clamp(18px,1.6vw,21px)] leading-normal">
            <b class="text-yellow">{p.whenShort}</b>
            {p.dateKnown && times && (
              <>
                <br />
                <span>{times}</span>
              </>
            )}
            <br />
            <a href="#venue" class="text-grey-mid">{`${p.venueShort}${p.venueStreet}`}</a>
          </div>
          <EventActions client:load ev={ev} initial={state} url={url} />
        </div>
      </PageOpening>
    )
  }

  {
    isPast ? (
      <div class="px-gut pt-[clamp(40px,5vw,72px)] pb-[clamp(64px,8vw,104px)] flex flex-col gap-[clamp(48px,6vw,80px)]">
        <FeedbackGate client:load ev={ev} initial={state} preview={PREVIEW} />

        {ev.description && (
          <section class="flex flex-col gap-3.5">
            <h2 class="m-0 text-[clamp(26px,2.6vw,34px)] font-bold">About this meetup</h2>
            <p class="m-0 text-[18px] leading-[1.6] text-ink-2 max-w-[680px] text-pretty">{ev.description}</p>
          </section>
        )}

        {ev.agenda.length > 0 && <Programme client:load ev={ev} initial={state} speakers={progSpeakers} summaries={summaries} preview={PREVIEW} />}

        {recapOnly.length > 0 && (
          <section class="flex flex-col gap-6">
            <h2 class="m-0 text-[clamp(26px,2.6vw,34px)] font-bold">Talks</h2>
            {recapOnly.map((t) => (
              <div class="flex flex-col gap-2">
                <h3 class="m-0 text-[22px] font-bold leading-[1.3] text-pretty">{t.title}</h3>
                <div class="flex flex-wrap gap-x-3">
                  {t.speakerIds
                    .map((id) => byId.get(id))
                    .filter((s) => !!s)
                    .map((s) => (
                      <a href={`/speakers/${s.id}`} class="text-[17px] font-bold underline underline-offset-[3px]">
                        {s.name}
                      </a>
                    ))}
                </div>
                {t.summary && <p class="m-0 text-[17px] leading-[1.55] text-ink-2">{t.summary}</p>}
                <span class="text-[16px] font-bold text-ink-2">{t.format}</span>
              </div>
            ))}
          </section>
        )}

        {ev.venue && <VenueCard client:visible venue={ev.venue} mapsKey={MAPS_EMBED_KEY} past />}

        {supporters.length > 0 && (
          <section aria-labelledby="h-thanks" class="flex flex-col gap-4">
            <h2 id="h-thanks" class="m-0 text-[clamp(26px,2.6vw,34px)] font-bold">
              Thanks to
            </h2>
            <p class="m-0 text-[17px] text-ink-2">The companies that made this meetup possible.</p>
            <SupporterList items={supporters} />
          </section>
        )}

        <section id="photos" aria-labelledby="h-photos" class="flex flex-col gap-[18px] scroll-mt-6">
          <div class="flex justify-between items-baseline flex-wrap gap-2.5">
            <h2 id="h-photos" class="m-0 text-[clamp(26px,2.6vw,34px)] font-bold">
              Photos from the evening
            </h2>
            {gallery.length > 0 && (
              <a href={mediaHref(ev.slug)} class="font-bold text-[17px] underline underline-offset-[3px]">
                {`All ${countLabel(gallery)}`}
              </a>
            )}
          </div>
          {gallery.length > 0 ? (
            <>
              <Gallery client:visible items={toGallery(gallery)} label={`Photos and videos from ${ev.title}`} max={8} />
              {ev.photoCredit && <p class="m-0 text-[15px] text-ink-2">{ev.photoCredit}</p>}
            </>
          ) : (
            <Surface class="p-6 text-[17px] leading-[1.55] text-ink-2" data-photos={photoState}>
              {photoState === 'unavailable' && 'The photo archive could not be loaded for this version of the site, so photos from this evening are not shown here.'}
              {photoState === 'pending' && 'Photos from this evening aren’t online yet. They usually follow within a week.'}
              {photoState === 'none' && 'There are no photos from this evening in our archive.'}{' '}
              {photoState !== 'pending' && (
                <a href="/media" class="font-bold text-black">
                  See photos from other meetups
                </a>
              )}
            </Surface>
          )}
        </section>

        <section class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-4">
          <Surface class="p-7 flex flex-col gap-2.5">
            <h2 class="m-0 text-[24px] font-bold">Were you there?</h2>
            <p class="m-0 text-[17px] leading-normal text-ink-2">
              {hasTalks
                ? 'Rate the talks: each speaker reads the ratings and comments for their own talk. Or tell the organisers about the evening in a few open questions.'
                : 'Tell the organisers about the evening in a few open questions. Only the organisers read your answers.'}
            </p>
            <div class="flex flex-wrap gap-2.5">
              {hasTalks && (
                <Button href={`${eventHref(ev)}?feedback=true#programme`} variant="black" class="text-[17px]">
                  Rate the talks
                </Button>
              )}
              <Button href={`/feedback?event=${ev.slug}`} variant={hasTalks ? 'outline-black' : 'black'} class="text-[17px]">
                Feedback on the evening
              </Button>
            </div>
          </Surface>
          <Surface tone="yellow" class="p-7 flex flex-col gap-2.5">
            <h2 class="m-0 text-[24px] font-bold">{next ? `Next: ${next.title}` : 'The next meetup is being planned'}</h2>
            <p class="m-0 text-[17px] leading-normal">{next && nextP ? `${nextP.dateLineShort} · ${nextP.venueShort}` : 'It is announced on Meetup first.'}</p>
            <Button href={next ? eventHref(next) : SITE.meetupGroupUrl} variant="black" class="self-start text-[17px]">
              {next ? 'See the next meetup' : 'Follow the group on Meetup'}
            </Button>
          </Surface>
        </section>
      </div>
    ) : (
      <div class="px-gut pt-[clamp(40px,5vw,72px)] pb-[clamp(64px,8vw,104px)] grid grid-cols-[repeat(auto-fit,minmax(min(100%,340px),1fr))] gap-[clamp(40px,5vw,72px)] items-start">
        <div class="flex flex-col gap-[clamp(40px,5vw,64px)] col-span-full md:col-[1/-2] min-w-0">
          <FeedbackGate client:load ev={ev} initial={state} preview={PREVIEW} />

          <EventBanner client:load ev={ev} initial={state} />

          <section class="flex flex-col gap-3.5">
            <h2 class="m-0 text-[clamp(26px,2.6vw,34px)] font-bold">About this meetup</h2>
            <p class="m-0 text-[18px] leading-[1.6] text-ink-2 max-w-[680px] text-pretty">{ev.description}</p>
          </section>

          {ev.agenda.length > 0 && <Programme client:load ev={ev} initial={state} speakers={progSpeakers} preview={PREVIEW} />}

          {speakingOpen && (
            <Surface class="p-6 flex flex-col gap-2.5">
              <h2 class="m-0 text-[22px] font-bold">Speakers are still being confirmed</h2>
              <p class="m-0 text-[17px] leading-normal text-ink-2">Want to speak at a ZurichJS meetup? First-time speakers are welcome, and we help you prepare.</p>
              <Button href="/cfp" variant="outline-black" class="self-start text-[17px]">
                Send a talk proposal
              </Button>
            </Surface>
          )}

          {ev.venue && <VenueCard client:visible venue={ev.venue} mapsKey={MAPS_EMBED_KEY} />}

          {(supporters.length > 0 || seasonSponsors.length > 0) && (
            <section aria-labelledby="h-thanks" class="flex flex-col gap-4">
              <h2 id="h-thanks" class="m-0 text-[clamp(26px,2.6vw,34px)] font-bold">
                Thanks to
              </h2>
              {supporters.length > 0 && (
                <>
                  <p class="m-0 text-[17px] text-ink-2">The companies that make this meetup possible.</p>
                  <SupporterList items={supporters} />
                </>
              )}
              {seasonSponsors.length > 0 && (
                <>
                  <p class="m-0 text-[17px] text-ink-2">Supporting ZurichJS this season.</p>
                  <SupporterList items={seasonSponsors.map((partner) => ({ partner }))} />
                </>
              )}
            </section>
          )}

          {ev.practical.length > 0 && (
            <section class="flex flex-col gap-5">
              <h2 class="m-0 text-[clamp(26px,2.6vw,34px)] font-bold">Good to know</h2>
              <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-x-10 gap-y-[22px]">
                {ev.practical.map((x) => (
                  <div class="flex flex-col gap-1">
                    <h3 class="m-0 text-[18px] font-bold">{x.label}</h3>
                    <p class="m-0 text-[17px] leading-normal text-ink-2">
                      {x.label === 'Code of conduct' ? (
                        <>
                          All ZurichJS events follow our <a href="/policies/code-of-conduct">code of conduct</a>.
                        </>
                      ) : (
                        x.value
                      )}
                    </p>
                  </div>
                ))}
              </div>
            </section>
          )}
        </div>

        <EventSummary client:idle ev={ev} initial={state} url={url} />
      </div>
    )
  }
</BaseLayout>
