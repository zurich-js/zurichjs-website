---
/** A simple line icon (24 px grid) in a rounded tile. Decorative: the text beside it carries the meaning. */
interface Props {
  d: string;
  tone?: 'white' | 'yellow';
}
const { d, tone = 'white' } = Astro.props;
---

<span aria-hidden="true" class:list={['w-11 h-11 rounded-2xl flex items-center justify-center flex-none', tone === 'yellow' ? 'bg-yellow' : 'bg-white']}>
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d={d}></path>
  </svg>
</span>
