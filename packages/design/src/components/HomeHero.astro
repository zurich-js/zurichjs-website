---
/**
 * Black hero on the same surface as the header (Bogdan's review, 4th November 2026):
 * "JavaScript meets Zurich." as the H1, the mission as a smaller H2, one line of copy, and a square
 * composition on the right: a meetup photo and the workshop loop as two squares, and the next meetup as a
 * card across the full width below them, with the meetup's artwork from Sanity.
 *
 * The next-meetup card is one link card to the event page (owner, 12th November 2026): the meetup's artwork
 * flush to the card's edges, the title first, then date and venue in one wrapping facts row; the arrow is the
 * signifier, so there is no JS corner and no underlined "Details and RSVP" (screen readers still hear it).
 * Visitors continue to Meetup from the event page. The rating lives in the award section, not here.
 *
 * The tall tile can carry a short silent `video` loop: its photo is the poster and first paint, and the
 * loop only plays for visitors who allow motion and aren't saving data.
 */
import { eventHref, presentEvent, type Event, type Photo, type TicketingProvider } from '@zurichjs/events';
import { srcFor, srcsetFor } from '../images';
import Card from './Card.astro';
import Facts from './Facts.astro';
import Tag from './Tag.astro';
import Text from './Text.astro';
type HeroTile = Photo & { video?: string };
interface Props {
  /** The next meetup, if one is scheduled. */
  next?: Event;
  now: Date;
  ticketing?: TicketingProvider;
  photos: { audience: HeroTile; speaker: HeroTile };
  meetupGroupUrl: string;
}
const { next, now, ticketing, photos: PHOTOS, meetupGroupUrl } = Astro.props;
const p = next ? presentEvent(next, { now, ticketing }) : null;
// Only states that change whether to come are shown; "RSVP open" and the price are not (review).
const NOTICE: Partial<Record<string, string>> = { full: 'Full, waitlist open', postponed: 'Postponed', cancelled: 'Cancelled', live: 'Happening now', tbc: 'Date to be confirmed' };
const notice = p ? NOTICE[p.state] : undefined;
const tile = 'relative block min-h-0 rounded-card overflow-hidden bg-ink';
// The meetup's own artwork from Sanity, in the card (Bogdan's review: the graphics added so much).
const art = next?.cover;
---

<section class="relative px-gut pt-page-top pb-page-end grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-center">
  <div class="relative z-1 flex flex-col gap-4 min-w-0">
    <h1 class="m-0 text-display font-bold text-balance">JavaScript meets Zurich.</h1>
    <h2 class="m-0 text-subsection font-bold text-grey text-balance">Shaping the Zurich tech scene.</h2>
    <p class="m-0 mt-2 text-lead max-w-reading text-pretty text-grey-mid">
      Come for the talks, stay for the people: juniors to CTOs, every framework, and a room full of developers you wouldn’t otherwise meet.
    </p>
  </div>

  {/* The square composition: a photo, the loop, and the next meetup as a card. The card's artwork sits on its left at every width, so it stays short on phones; below 800px the composition stops at the form width. */}
  <div class="hero-squares grid gap-3 w-full max-md:max-w-form">
    <span class={`${tile} [grid-area:a]`}>
      <img src={srcFor(PHOTOS.audience.src)} srcset={PHOTOS.audience.srcset ?? srcsetFor(PHOTOS.audience.src)} sizes="(min-width: 800px) 25vw, 50vw" alt={PHOTOS.audience.alt} loading="eager" fetchpriority="high" decoding="async" class="absolute inset-0 h-full w-full object-cover" style={{ objectPosition: PHOTOS.audience.position ?? 'center' }} />
    </span>
    <span class={`${tile} [grid-area:v]`}>
      <img src={srcFor(PHOTOS.speaker.src)} srcset={PHOTOS.speaker.srcset ?? srcsetFor(PHOTOS.speaker.src)} sizes="(min-width: 800px) 25vw, 50vw" alt={PHOTOS.speaker.alt} loading="eager" decoding="async" class="absolute inset-0 h-full w-full object-cover" style={{ objectPosition: PHOTOS.speaker.position ?? 'center 25%' }} />
      {
        PHOTOS.speaker.video && (
          <video data-hero-video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700" style={{ objectPosition: PHOTOS.speaker.position ?? 'center 25%' }}>
            <source src={PHOTOS.speaker.video} type="video/mp4" />
          </video>
        )
      }
    </span>
    {/* The next meetup: a link card with the artwork flush to its edges, the title first, then date and venue on one wrapping line. */}
    {
      next && p ? (
        <Card surface="white" level="p" mediaLayout="side" title={next.title} href={eventHref(next)} linkHint="Details and RSVP" linkAttrs={{ 'data-next-meetup': '' }} class="[grid-area:c]">
          {art && <img slot="media" src={srcFor(art.src)} srcset={srcsetFor(art.src)} sizes="(min-width: 800px) 15vw, 30vw" alt="" loading="eager" decoding="async" />}
          <Facts
            slot="facts"
            items={[
              { label: 'Date', value: p.dateLineShort, hideLabel: true, strong: true },
              { label: 'Venue', value: p.venueShort, hideLabel: true },
            ]}
          />
          {notice && <Tag tone="black">{notice}</Tag>}
        </Card>
      ) : (
        <Card surface="white" level="p" title="The next meetup is being planned." href={meetupGroupUrl} linkHint="Follow ZurichJS on Meetup" linkAttrs={{ 'data-next-meetup': '' }} class="[grid-area:c]">
          <Text size="compact" tone="muted">We announce it on Meetup first.</Text>
        </Card>
      )
    }
  </div>
</section>

<style>
  /* Two photo squares on top, the next-meetup card across the full width below, at every size. */
  .hero-squares {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-areas:
      'a v'
      'c c';
  }
  .hero-squares > span {
    aspect-ratio: 1 / 1;
  }
</style>

<script>
  // Play the hero loop shortly after the page has loaded, only when motion is welcome and data isn't being saved.
  // Until it plays (or if it never does) the photo underneath shows.
  const start = () => {
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    if (calm || saveData) return;
    for (const v of document.querySelectorAll<HTMLVideoElement>('video[data-hero-video]')) {
      v.addEventListener('playing', () => v.classList.remove('opacity-0'), { once: true });
      v.play().catch(() => {});
    }
  };
  // A short wait after load: the poster is already showing, and the 1.5 MB clip then never competes
  // with the first paint on slow phones.
  const later = () => setTimeout(start, 2500);
  if (document.readyState === 'complete') later();
  else addEventListener('load', later, { once: true });
</script>
