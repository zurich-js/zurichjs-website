---
/** The member area: sign in by email link, join, manage the membership (docs/v2/MEMBERSHIP.md). Private, not indexed. */
import PageOpening from '@zurichjs/design/components/PageOpening.astro';
import MemberAccount from '~/components/islands/MemberAccount';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/lib/content';
---

<BaseLayout title="Your membership" description={`Join or manage your membership of the ${SITE.association}.`} noindex>
  <PageOpening slot="opening" title="Your membership" sub={`Your membership of the ${SITE.association}, the association behind ZurichJS.`} />
  <div class="px-gut py-section">
    <MemberAccount client:load contactEmail={SITE.email} />
  </div>
</BaseLayout>
