---
/**
 * The membership admin area for the board (docs/v2/MEMBERSHIP.md). Protected by
 * the site's admin password (MEMBERSHIP_ADMIN_PASSWORD), enforced by the API on
 * every deploy; this page holds no data itself. Not indexed.
 */
import PageOpening from '@zurichjs/design/components/PageOpening.astro';
import MembershipAdmin from '~/components/islands/MembershipAdmin';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/lib/content';
---

<BaseLayout title="Membership admin" description={`Members of the ${SITE.association}, for the board.`} noindex>
  <PageOpening slot="opening" title="Members" sub={`The ${SITE.association}'s members, for the board.`} />
  <div class="px-gut pt-[clamp(40px,5vw,72px)] pb-[clamp(64px,8vw,112px)]">
    <MembershipAdmin client:load />
  </div>
</BaseLayout>
