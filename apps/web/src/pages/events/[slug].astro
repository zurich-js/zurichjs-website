---
/**
 * Event page. One URL for the whole life of an event: upcoming (RSVP), live
 * (48 h feedback window with per-talk rating), then the recap. The state is
 * prerendered as of the build; islands follow the clock in the browser, and
 * scheduled rebuilds at doors and doors + 48 h refresh the HTML.
 */
import { eventCardAlt } from '~/lib/og';
import { ROLE_LABEL, type Partner, type SupporterRole, dateLong, eventHref, eventThanks, eventTalks, nextMeetup, presentEvent, recapSummary, resolveState, type Event } from '@zurichjs/events';
import { breadcrumbSchema, canonicalUrl, eventSchema } from '@zurichjs/seo';
import PageOpening from '@zurichjs/design/components/PageOpening.astro';
import EventActions from '~/components/islands/event/EventActions';
import EventBanner from '~/components/islands/event/EventBanner';
import EventSummary from '~/components/islands/event/EventSummary';
import FeedbackGate from '~/components/islands/event/FeedbackGate';
import Programme from '~/components/islands/event/Programme';
import { avatarSrc } from '@zurichjs/design/images';
import VenueCard from '~/components/islands/event/VenueCard';
import LogoRow from '@zurichjs/design/components/LogoRow.astro';
import Button from '@zurichjs/design/components/Button.astro';
import { Gallery } from '@zurichjs/design/islands/Gallery';
import { eventPhotoState, mediaForEvent } from '@zurichjs/content';
import { countLabel, mediaHref, toGallery } from '~/lib/media';
import Card from '@zurichjs/design/components/Card.astro';
import Photo from '@zurichjs/design/components/Photo.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { BUILD_TIME, MAPS_EMBED_KEY, PREVIEW, SITE, content, ticketing } from '~/lib/content';
import { clip } from '~/lib/text';

export async function getStaticPaths() {
  const { events } = await content();
  return events.map((ev) => ({ params: { slug: ev.slug }, props: { ev } }));
}

const { ev } = Astro.props as { ev: Event };
const c = await content();
const state = resolveState(ev, BUILD_TIME);
const p = presentEvent(ev, { now: BUILD_TIME, ticketing });
const url = canonicalUrl(eventHref(ev));
const byId = new Map(c.speakers.map((s) => [s.id, s]));
const speakerIds = [...new Set([...eventTalks(ev).flatMap((t) => t.speakerIds), ...(ev.recap?.talks.flatMap((t) => t.speakerIds) ?? [])])];
const speakers = speakerIds.map((id) => byId.get(id)).filter((s) => !!s);
const progSpeakers = speakers.map(({ id, name, role, initials, photo }) => ({ id, name, role, initials, avatar: photo ? avatarSrc(photo.src, 48) : undefined }));
const gallery = mediaForEvent(c.media.items, ev.slug);
// Honest about missing photos: "unavailable" when this build could not read the archive, never "coming soon".
const evEnd = ev.endsAt ?? ev.startsAt;
const photoState = eventPhotoState(gallery.length, c.media, evEnd ? new Date(evEnd) : undefined, BUILD_TIME);
const isPast = state === 'past';
// The event's own hosts and supporters. Current sponsors are added only while the meetup is upcoming:
// a past event thanks only who supported that evening, never today's sponsors.
// A cancelled or postponed meetup whose date has gone by counts as past here too.
const historic = isPast || (!!ev.startsAt && Date.parse(ev.startsAt) < BUILD_TIME.getTime());
const { own: supporters, season: seasonSponsors } = eventThanks(ev, c.partners, { past: historic });
const hosts = c.partners.filter((h) => ev.hosts?.includes(h.id) && (historic || !h.delisted));
const next = nextMeetup(c.events, BUILD_TIME);
const nextP = next ? presentEvent(next, { now: BUILD_TIME, ticketing }) : null;
const description = clip(isPast ? `${recapSummary(ev, { photos: gallery.filter((m) => m.kind === 'photo').length })} ${ev.description}` : `${p.dateLineShort} · ${p.venueShort}. ${ev.description}`);
const jsonLd = [eventSchema(ev, c.speakers, hosts), breadcrumbSchema([{ name: 'Events', path: '/events' }, { name: ev.title, path: eventHref(ev) }])];
// The event's own card (with its artwork when it has one), never a random photo (pages/og/[name].png.ts).
const image = `/og/event-${ev.slug}.png`;
const imageAlt = eventCardAlt(ev.title, ev.startsAt ? dateLong(ev.startsAt) : ev.dateText, ev.venue?.name);
const summaries = Object.fromEntries((ev.recap?.talks ?? []).filter((t) => t.summary).map((t) => [t.title, t.summary]));
// Recap talks that are not in the programme (older events) still get listed.
const recapOnly = (ev.recap?.talks ?? []).filter((t) => !eventTalks(ev).some((x) => x.title === t.title));
const hasTalks = eventTalks(ev).length > 0;
const speakingOpen = !isPast && state !== 'cancelled' && (!hasTalks || ev.agenda.some((a) => /\b(tba|tbc|to be announced|open slot)\b/i.test(a.title)));
// About this meetup on the left and the venue on the right on wide screens; stacked on phones.
const ABOUT_GRID = 'grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-14 items-start';
// "Thanks to": each logo with its name, role and note as a caption (only when there is a role or note).
const thanksRow = (items: { partner: Partner; role?: SupporterRole; note?: string }[]) =>
  items.map(({ partner, role, note }) => ({ partner, caption: role || note ? [partner.name, role ? ROLE_LABEL[role] : '', note].filter(Boolean).join(' · ') : undefined }));
---

<BaseLayout title={ev.title} description={description} image={image} imageAlt={imageAlt} jsonLd={jsonLd}>
  {
    isPast ? (
      <PageOpening slot="opening" title={ev.title} crumb={{ label: 'Events', href: '/events?tab=past', here: ev.startsAt ? dateLong(ev.startsAt) : 'Past' }} sub={recapSummary(ev, { photos: gallery.filter((m) => m.kind === 'photo').length })} />
    ) : (
      <PageOpening slot="opening" title={ev.title} crumb={{ label: 'Events', href: '/events', here: p.crumb }}>
        <div class="flex flex-col gap-4 pt-1">
          <div class="text-lead">
            <b>{p.whenShort}</b>
            <br />
            <a href="#venue" class="text-body text-grey-mid underline hover:text-white">{`${p.venueShort}${p.venueStreet}`}</a>
          </div>
          <EventActions client:load ev={ev} initial={state} url={url} />
        </div>
        {/* The event's own artwork beside the title from 800px, only when it has one: never the share card, which repeats the title. */}
        {ev.cover && (
          <div slot="media" class="aspect-video w-full">
            <Photo photo={ev.cover} priority class="size-full" />
          </div>
        )}
      </PageOpening>
    )
  }

  {
    isPast ? (
      <div class="px-gut py-section flex flex-col gap-section">
        <FeedbackGate client:load ev={ev} initial={state} preview={PREVIEW} />

        {(ev.description || ev.venue) && (
          <div class={ABOUT_GRID}>
            {ev.description && (
              <section class="flex flex-col gap-3.5">
                <h2 class="m-0 text-subsection font-bold">About this meetup</h2>
                <p class="m-0 text-body text-ink-2 max-w-reading text-pretty">{ev.description}</p>
              </section>
            )}
            {ev.venue && <VenueCard client:visible venue={ev.venue} mapsKey={MAPS_EMBED_KEY} compact />}
          </div>
        )}

        {ev.agenda.length > 0 && <Programme client:load ev={ev} initial={state} speakers={progSpeakers} summaries={summaries} preview={PREVIEW} />}

        {recapOnly.length > 0 && (
          <section class="flex flex-col gap-6">
            <h2 class="m-0 text-subsection font-bold">Talks</h2>
            {recapOnly.map((t) => (
              <div class="flex flex-col gap-2">
                <h3 class="m-0 text-card-title font-bold text-pretty">{t.title}</h3>
                <div class="flex flex-wrap gap-x-3">
                  {t.speakerIds
                    .map((id) => byId.get(id))
                    .filter((s) => !!s)
                    .map((s) => (
                      <a href={`/speakers/${s.id}`} class="text-body font-bold underline underline-offset-3">
                        {s.name}
                      </a>
                    ))}
                </div>
                {t.summary && <p class="m-0 text-body text-ink-2">{t.summary}</p>}
                <span class="text-compact font-bold text-ink-2">{t.format}</span>
              </div>
            ))}
          </section>
        )}

        {supporters.length > 0 && (
          <section aria-labelledby="h-thanks" class="flex flex-col gap-4">
            <h2 id="h-thanks" class="m-0 text-subsection font-bold">
              Thanks to
            </h2>
            <p class="m-0 text-body text-ink-2">The companies that made this meetup possible.</p>
            <LogoRow items={thanksRow(supporters)} />
          </section>
        )}

        <section id="photos" aria-labelledby="h-photos" class="flex flex-col gap-4 scroll-mt-6">
          <div class="flex justify-between items-baseline flex-wrap gap-2.5">
            <h2 id="h-photos" class="m-0 text-subsection font-bold">
              Photos from the evening
            </h2>
            {gallery.length > 0 && (
              <a href={mediaHref(ev.slug)} class="font-bold text-body underline underline-offset-3">
                {`All ${countLabel(gallery)}`}
              </a>
            )}
          </div>
          {gallery.length > 0 ? (
            <>
              <Gallery client:visible items={toGallery(gallery)} label={`Photos and videos from ${ev.title}`} max={8} />
              {ev.photoCredit && <p class="m-0 text-meta text-ink-2">{ev.photoCredit}</p>}
            </>
          ) : (
            <Card>
              <p class="m-0 text-body text-ink-2" data-photos={photoState}>
              {photoState === 'unavailable' && 'The photo archive could not be loaded for this version of the site, so photos from this evening are not shown here.'}
              {photoState === 'pending' && 'Photos from this evening aren’t online yet. They usually follow within a week.'}
              {photoState === 'none' && 'There are no photos from this evening in our archive.'}{' '}
              {photoState !== 'pending' && (
                <a href="/media" class="font-bold text-black">
                  See photos from other meetups
                </a>
              )}
              </p>
            </Card>
          )}
        </section>

        <section class="grid grid-cols-auto-md gap-4">
          <Card title="Were you there?" level="h2" padding="lg">
            <p class="m-0 text-body text-ink-2">
              {hasTalks
                ? 'Rate the talks: each speaker reads the ratings and comments for their own talk. Or tell the organisers about the evening in a few open questions.'
                : 'Tell the organisers about the evening in a few open questions. Only the organisers read your answers.'}
            </p>
            {hasTalks && (
              <Button slot="footer" href={`${eventHref(ev)}?feedback=true#programme`} variant="cta">
                Rate the talks
              </Button>
            )}
            <Button slot="footer" href={`/feedback?event=${ev.slug}`} variant={hasTalks ? 'secondary' : 'primary'}>
              Feedback on the evening
            </Button>
          </Card>
          <Card title={next ? `Next: ${next.title}` : 'The next meetup is being planned'} level="h2" padding="lg">
            <p class="m-0 text-body">{next && nextP ? `${nextP.dateLineShort} · ${nextP.venueShort}` : 'It is announced on Meetup first.'}</p>
            <Button slot="footer" href={next ? eventHref(next) : SITE.meetupGroupUrl} variant="primary">
              {next ? 'See the next meetup' : 'Follow the group on Meetup'}
            </Button>
          </Card>
        </section>
      </div>
    ) : (
      <div class="px-gut py-section grid grid-cols-auto-md gap-12 items-start">
        <div class="flex flex-col gap-8 col-span-full md:col-[1/-2] min-w-0">
          <FeedbackGate client:load ev={ev} initial={state} preview={PREVIEW} />

          <EventBanner client:load ev={ev} initial={state} />

          <section class="flex flex-col gap-3.5">
            <h2 class="m-0 text-subsection font-bold">About this meetup</h2>
            <p class="m-0 text-body text-ink-2 max-w-reading text-pretty">{ev.description}</p>
          </section>

          {ev.agenda.length > 0 && <Programme client:load ev={ev} initial={state} speakers={progSpeakers} preview={PREVIEW} />}

          {speakingOpen && (
            <Card title="Speakers are still being confirmed" level="h2">
              <p class="m-0 text-body text-ink-2">Want to speak at a ZurichJS meetup? First-time speakers are welcome, and we help you prepare.</p>
              <Button slot="footer" href="/cfp" variant="secondary">
                Send a talk proposal
              </Button>
            </Card>
          )}

          {(supporters.length > 0 || seasonSponsors.length > 0) && (
            <section aria-labelledby="h-thanks" class="flex flex-col gap-4">
              <h2 id="h-thanks" class="m-0 text-subsection font-bold">
                Thanks to
              </h2>
              {supporters.length > 0 && (
                <>
                  <p class="m-0 text-body text-ink-2">The companies that make this meetup possible.</p>
                  <LogoRow items={thanksRow(supporters)} />
                </>
              )}
              {seasonSponsors.length > 0 && (
                <>
                  <p class="m-0 text-body text-ink-2">Supporting ZurichJS this season.</p>
                  <LogoRow items={seasonSponsors.map((partner) => ({ partner }))} />
                </>
              )}
            </section>
          )}

          {ev.practical.length > 0 && (
            <section class="flex flex-col gap-5">
              <h2 class="m-0 text-subsection font-bold">Good to know</h2>
              <div class="grid grid-cols-auto-sm gap-x-10 gap-y-6">
                {ev.practical.map((x) => (
                  <div class="flex flex-col gap-1">
                    <h3 class="m-0 text-body font-bold">{x.label}</h3>
                    <p class="m-0 text-body text-ink-2">
                      {x.label === 'Code of conduct' ? (
                        <>
                          All ZurichJS events follow our <a href="/policies/code-of-conduct">code of conduct</a>.
                        </>
                      ) : (
                        x.value
                      )}
                    </p>
                  </div>
                ))}
              </div>
            </section>
          )}
        </div>

        {/* The venue on top, then the summary (when, cost, status, RSVP), which stays in view while scrolling. */}
        <div class="self-stretch flex flex-col gap-6 min-w-0">
          {ev.venue && <VenueCard client:visible venue={ev.venue} mapsKey={MAPS_EMBED_KEY} compact />}
          <EventSummary client:idle ev={ev} initial={state} url={url} />
        </div>
      </div>
    )
  }
</BaseLayout>
