{
  "mcpServers": {
    "sanity": {
      "type": "http",
      "url": "https://mcp.sanity.io",
      "headers": { "Authorization": "Bearer ${SANITY_API_TOKEN}" }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer ${GITHUB_TOKEN}" }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.83", "--headless", "--browser", "chromium"]
    }
  }
}
