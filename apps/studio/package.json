{
  "name": "@zurichjs/studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "schema": "tsx scripts/extract-schema.ts",
    "typegen": "pnpm run schema && sanity typegen generate",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint ."
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "3.79.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sanity": "3.79.0",
    "styled-components": "6.1.15",
    "@sanity/icons": "3.7.0",
    "@sanity/ui": "2.15.5",
    "@sanity/schema": "3.79.0"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "5.0.2",
    "@types/react": "18.3.18",
    "eslint": "9.22.0",
    "prettier": "3.5.3",
    "typescript": "5.7.3",
    "tsx": "4.23.15"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
}
