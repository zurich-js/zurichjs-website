---
import PageOpening from '@zurichjs/design/components/PageOpening.astro';
import Card from '@zurichjs/design/components/Card.astro';
import Notice from '@zurichjs/design/components/Notice.astro';
import AutoGrid from '@zurichjs/design/components/AutoGrid.astro';
import Button from '@zurichjs/design/components/Button.astro';
import ContactForm from '~/components/islands/forms/ContactForm';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { confLink } from '@zurichjs/design/analytics';
import { SITE, content } from '~/lib/content';
import Photo from '@zurichjs/design/components/Photo.astro';
import Monogram from '@zurichjs/design/components/Monogram.astro';
import { SocialIcon, socialKind } from '@zurichjs/design/islands/SocialLabel';
import { buttonClass } from '@zurichjs/design/recipes';
import { faqSchema, organizationSchema } from '@zurichjs/seo';

/** Simple line icons (24 px grid, drawn here), one per kind of question. */
const ICON = {
  talk: 'M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3zM5 11a7 7 0 0 0 14 0M12 18v3M8 21h8',
  host: 'M4 21V5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v16M14 9h5a1 1 0 0 1 1 1v11M3 21h18M8 8h2M8 12h2M8 16h2',
  volunteer: 'M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z',
  conference: 'M3 7h18v3a2 2 0 0 0 0 4v3H3v-3a2 2 0 0 0 0-4zM15 7v10',
  mail: 'M3 6h18v12H3zM3 7l9 7 9-7',
  meetup: 'M4 6h16v14H4zM4 10h16M8 3v4M16 3v4',
  conduct: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z',
} as const;

const ROUTES = [
  { h: 'Give a talk', d: 'Send a talk proposal for a meetup.', href: '/cfp', icon: ICON.talk },
  { h: 'Host or sponsor', d: 'Rooms, food and community partnerships.', href: '/partners', icon: ICON.host },
  { h: 'Volunteer', d: 'On meetup nights, with photos, or with the website.', href: '/cfv', icon: ICON.volunteer },
  { h: 'Conference questions', d: 'Tickets, invoices and the conference talk proposals.', href: confLink('/contact', 'contact'), icon: ICON.conference },
];

// The organisers come from the team on /about (photo, role, links). Production's /contact
// (origin/main src/pages/contact.tsx) gave Faris's and Bogdan's emails; Nadja's is from the owner (3rd November 2026).
const EMAIL: Record<string, string> = {
  'Faris Aziz': 'faris@zurichjs.com',
  'Bogdan Mihai Ilie': 'bogdan@zurichjs.com',
  'Nadja Hesselbjerg': 'nadja@zurichjs.com',
};
const { team } = await content();
const ORGANISERS = team.filter((m) => m.group === 'organisers');

/**
 * Production's FAQ, in plain words. Travel: meetup speakers' travel and accommodation are not covered
 * (owner, 3rd November 2026), as the /cfp checkbox says. `link` is shown after the answer; the JSON-LD
 * uses the answer text only.
 */
const FAQS: { question: string; answer: string; link?: { label: string; href: string } }[] = [
  {
    question: 'How can I speak at a ZurichJS meetup?',
    answer:
      'Send a talk proposal through our call for papers (CFP). It is open all year and needs no account. First-time speakers are welcome: tick the box in the form and an organiser helps you prepare.',
    link: { label: 'Propose a talk', href: '/cfp' },
  },
  {
    question: 'Do you cover travel and accommodation for speakers?',
    answer:
      'No. Our meetups are free, so we can’t cover travel or accommodation for meetup speakers. We’re happy to help with travel tips and local recommendations.',
  },
  {
    question: 'Are ZurichJS meetups suitable for beginners?',
    answer:
      'Yes. We want every meetup to be welcoming and useful for developers at any level. Talks are a mix of beginner-friendly, intermediate and advanced topics.',
  },
  {
    question: 'Can my company host or sponsor a meetup?',
    answer: 'Yes. We are always looking for venues and sponsors. The partners page explains the options and has an inquiry form.',
    link: { label: 'Hosting and sponsoring', href: '/partners' },
  },
  {
    question: 'How can I get involved?',
    answer: 'Join the Meetup group and come to a meetup. If you’d like to help on the night, with photos and video, or with the website, tell us on the volunteer page.',
    link: { label: 'Volunteer with us', href: '/cfv' },
  },
  {
    question: 'When will I hear back?',
    answer: 'The organisers are volunteers and read every message. Replies come by email, between day jobs and meetups, so it can take a little while.',
  },
];
---

<BaseLayout
  title="Contact"
  fullTitle="Contact ZurichJS · JavaScript Community in Zurich"
  description="Contact the ZurichJS organisers about a meetup, speaking, hosting or sponsoring. Real people from the JavaScript community in Zurich reply by email."
  keywords={['contact ZurichJS', 'JavaScript community Zurich', 'JavaScript meetup Zurich', 'ZurichJS organisers']}
  jsonLd={[organizationSchema(), faqSchema(FAQS.map(({ question, answer }) => ({ question, answer })))]}
>
  <PageOpening
    slot="opening"
    title="Contact the organisers"
    sub="Questions about a meetup, speaking, hosting or anything else. Real people read these, usually between a day job and the next meetup."
  />
  <div class="px-gut py-section flex flex-col gap-section">
    <div class="grid grid-cols-auto-lg gap-10 md:gap-16 items-start">
      <section aria-labelledby="h-routes" class="flex flex-col gap-4">
        <h2 id="h-routes" class="m-0 text-subsection font-bold">Faster for these</h2>
        <div class="flex flex-col gap-2.5">
          {
            ROUTES.map((r) => (
              <Card href={r.href} title={r.h} surface="filled">
                <svg slot="icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={r.icon} />
                </svg>
                <p class="m-0 text-compact text-ink-2">{r.d}</p>
              </Card>
            ))
          }
        </div>
        <Notice id="conduct" as="h3" title="Report a code of conduct concern" class="scroll-mt-6">
          <svg slot="icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d={ICON.conduct} />
          </svg>
          <p class="m-0">
            Please don’t use the form for this. Email <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Code of conduct concern')}`} class="font-bold"
              >{SITE.email}</a
            >, or speak to any ZurichJS team member at an event. The organisers review every report and respect the privacy and security of the person reporting.
          </p>
          <a href="/policies/code-of-conduct#reporting-guidelines" class="font-bold self-start">Read the code of conduct</a>
        </Notice>
      </section>
      <section aria-labelledby="h-cform" class="flex flex-col gap-4">
        <h2 id="h-cform" class="m-0 text-subsection font-bold">Send a message</h2>
        <ContactForm client:load />
      </section>
    </div>

    <section aria-labelledby="h-reach" class="flex flex-col gap-4">
      <h2 id="h-reach" class="m-0 text-subsection font-bold">Other ways to reach us</h2>
      <AutoGrid min="sm" gap="sm">
        {
          [
            { h: 'Email', d: 'For anything at all.', href: `mailto:${SITE.email}`, label: SITE.email, line: ICON.mail },
            { h: 'LinkedIn', d: 'Updates from the community. You can message us there too.', href: SITE.linkedinUrl, label: 'linkedin.com/company/zurichjs', social: 'linkedin' as const },
            { h: 'Meetup', d: 'Join the group to RSVP for meetups and message the organisers.', href: SITE.meetupGroupUrl, label: 'meetup.com/zurich-js', line: ICON.meetup },
            { h: 'Slack', d: 'Talk with the community between meetups.', href: SITE.slackInviteUrl, label: 'Join our Slack', social: 'slack' as const },
          ].map((c) => (
            // The destination is part of the title, so the link's name says where it goes.
            <Card href={c.href} title={`${c.h}: ${c.label}`} surface="filled">
              <span slot="icon" class="flex">
                {c.social ? (
                  <SocialIcon kind={c.social} size={20} />
                ) : (
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d={c.line} />
                  </svg>
                )}
              </span>
              <p class="m-0 text-compact text-ink-2">{c.d}</p>
            </Card>
          ))
        }
      </AutoGrid>
      <h3 class="m-0 mt-4 text-card-title font-bold">The organisers</h3>
      <AutoGrid min="md" gap="sm">
        {
          ORGANISERS.map((o) => {
            const email = EMAIL[o.name];
            const socials = (o.links ?? []).filter((l) => socialKind(l.label));
            return (
              <Card>
                <div class="flex items-center gap-4">
                  <span class="w-16 h-16 flex-none">
                    {o.photo ? (
                      <Photo photo={o.photo} class="w-16 h-16 rounded-full!" sizes="64px" />
                    ) : (
                      <Monogram initials={o.initials} size="avatar" label={o.name} />
                    )}
                  </span>
                  <div class="flex flex-col gap-0.5 min-w-0">
                    <h4 class="m-0 text-card-title font-bold">{o.name}</h4>
                    <p class="m-0 text-compact text-ink-2">{o.role}</p>
                  </div>
                </div>
                {/* Email on its own line, then one row of icons: the same two rows on every card, at the bottom. */}
                <div slot="footer" class="w-full flex flex-col items-start gap-2.5">
                  {email && (
                    <Button href={`mailto:${email}`} variant="secondary" icon={ICON.mail}>
                      {email}
                    </Button>
                  )}
                  {socials.length > 0 && (
                    <ul class="m-0 p-0 list-none flex flex-nowrap items-center gap-2" aria-label={`${o.name} online`}>
                      {socials.map((l) => (
                        <li>
                          <a
                            href={l.url}
                            target="_blank"
                            rel="noopener"
                            title={l.label}
                            aria-label={`${o.name} on ${l.label} (opens in a new tab)`}
                            class={buttonClass({ variant: 'secondary', iconOnly: true })}
                          >
                            <SocialIcon kind={socialKind(l.label)!} size={17} />
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </Card>
            );
          })
        }
      </AutoGrid>
    </section>

    <section aria-labelledby="h-faq" class="flex flex-col gap-4 max-w-wide">
      <h2 id="h-faq" class="m-0 text-subsection font-bold">Frequently asked questions</h2>
      <div class="flex flex-col gap-3">
        {
          FAQS.map((f) => (
            <Card title={f.question}>
              <p class="m-0 text-body text-ink-2 text-pretty">{f.answer}</p>
              {f.link && (
                <a href={f.link.href} class="font-bold text-body self-start">
                  {f.link.label}
                </a>
              )}
            </Card>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
