# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
package-lock.json

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.idea/

# V2 reference site and platform workspace (each has its own pnpm root)
/v2/node_modules
/v2/.next
/v2/out
/platform/**/node_modules
/platform/**/dist
/platform/**/.astro
/platform/**/.netlify
/platform/node_modules
/platform/test-results
/platform/playwright-report
# Vendored package with a security fix (platform/vendor/deepmerge/README.md) ships its dist.
!/platform/vendor/**/dist
