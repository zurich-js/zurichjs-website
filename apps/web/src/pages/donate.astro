---
/**
 * Support ZurichJS at the production URL /donate (301s from /buy-us-a-coffee
 * and /support keep working, with their query strings).
 *
 * Online donations, one-time or monthly, go through Stripe Checkout (owner
 * decision 2026-11-01, docs/v2/DECISIONS.md). Twint (QR from Sanity Site
 * settings) and email stay as alternatives. Membership of the association is
 * separate: /membership.
 */
import DonateForm from '~/components/islands/forms/DonateForm';
import PageOpening from '@zurichjs/design/components/PageOpening.astro';
import Surface from '@zurichjs/design/components/Surface.astro';
import Button from '@zurichjs/design/components/Button.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import RetiredNotice from '~/components/RetiredNotice.astro';
import { SITE, content } from '~/lib/content';
import { isExternal } from '@zurichjs/design/recipes';

const { support } = await content();
const qr = support.twintQr;
const portalUrl = import.meta.env.PUBLIC_STRIPE_PORTAL_URL || process.env.PUBLIC_STRIPE_PORTAL_URL || undefined;

const GOES = [
  ['Venues', 'Room hire and equipment on nights without a host.'],
  ['Food and drinks', 'Evenings that no sponsor covers.'],
  ['Speakers', 'Travel for speakers from outside Zurich.'],
  ['Tools', 'Storage, the website and the tools volunteers use to run meetups.'],
];
/**
 * Supporters production thanked by name on /buy-us-a-coffee ("Recent
 * Supporters", origin/main getStaticProps), with the links they gave. Listed
 * by hand, never from Stripe: a donation does not publish anyone's name.
 */
const THANKS = [
  { name: 'MountainAsh', href: 'https://mountainash.id.au/' },
  { name: 'Patrick Stillhart', href: 'https://stillh.art/' },
  { name: 'Mario Vasile', href: 'https://www.linkedin.com/in/mariovasile/' },
];
const WAYS = [
  { h: 'Become a member', d: 'Join the Swiss JavaScript Group, the association behind ZurichJS.', href: '/membership', yellow: true },
  { h: 'Host or sponsor a meetup', d: 'For companies: a room, food and drinks, or a contribution.', href: '/partners' },
  { h: 'Speak at a meetup', d: 'First-time speakers are welcome, and we help you prepare.', href: '/cfp' },
  { h: 'Volunteer', d: 'Help on the night or behind the scenes.', href: '/cfv' },
];
---

<BaseLayout
  image="/og/donate.png"
  title="Support ZurichJS"
  fullTitle="Support ZurichJS · Help the JavaScript Community in Zurich"
  description="Donate to ZurichJS once or monthly, or support it as a member, host, sponsor, speaker or volunteer. Meetups are free and run by volunteers."
  keywords={['donate ZurichJS', 'support ZurichJS', 'sponsor ZurichJS', 'JavaScript community Zurich', 'ZurichJS membership', 'non-profit meetup Switzerland']}
>
  <PageOpening slot="opening" title="Support ZurichJS" sub="Meetups are free to attend. We started on personal savings; donations, members and partners now cover the evenings.">
    <div class="flex flex-wrap gap-3 pt-1">
      <Button href="#donate" variant="yellow" grow>Donate</Button>
      <Button href="/membership" variant="outline-white" grow>Become a member</Button>
    </div>
  </PageOpening>
  <RetiredNotice />
  <div class="px-gut pt-[clamp(56px,7vw,104px)] pb-[clamp(64px,8vw,112px)] grid grid-cols-[repeat(auto-fit,minmax(min(100%,360px),1fr))] gap-[clamp(40px,5vw,80px)] items-start">
    <section id="donate" aria-labelledby="h-donate" class="flex flex-col gap-[18px] scroll-mt-6 col-span-full md:col-span-2">
      <div class="flex flex-col gap-2">
        <h2 id="h-donate" class="m-0 text-[clamp(26px,2.8vw,36px)] leading-[1.15] font-bold">Donate</h2>
        <p class="m-0 text-[17px] leading-[1.55] text-ink-2 max-w-[640px]">
          A donation is a gift to ZurichJS; it doesn’t make you a member. To join the association with a vote, see <a href="/membership" class="font-bold text-black">membership</a>.
        </p>
      </div>
      <DonateForm client:load portalUrl={portalUrl} email={SITE.email} twint={!!qr} />
    </section>

    <section aria-labelledby="h-ways" class="flex flex-col gap-3">
      <h2 id="h-ways" class="m-0 mb-1 text-[clamp(26px,2.8vw,36px)] leading-[1.15] font-bold">Ways to help</h2>
      {
        WAYS.map((o) => (
          <a
            href={o.href}
            {...(isExternal(o.href) ? { target: '_blank', rel: 'noopener' } : {})}
            class={`no-underline text-black text-left rounded-[20px] py-[18px] px-5 grid grid-cols-[minmax(0,1fr)_auto] gap-3 items-center ${o.yellow ? 'bg-yellow hover:bg-yellow-hover' : 'bg-grey hover:bg-grey-hover'}`}
          >
            <span class="flex flex-col gap-[3px]">
              <span class="text-[18px] font-bold">{o.h}</span>
              <span class="text-[16px] leading-[1.45] text-ink-2">{o.d}</span>
            </span>
            <span aria-hidden="true" class="w-10 h-10 rounded-pill flex items-center justify-center font-bold bg-white">→</span>
          </a>
        ))
      }
    </section>

    <section id="other-ways" aria-labelledby="h-oneoff" class="flex flex-col gap-[18px] scroll-mt-6">
      <h2 id="h-oneoff" class="m-0 text-[clamp(26px,2.8vw,36px)] leading-[1.15] font-bold">Other ways to give</h2>
      {
        qr && (
          <Surface class="p-6 flex flex-col gap-4 items-start">
            <img
              src={`${qr.src}?w=480&fm=png`}
              alt={qr.alt}
              width="240"
              height="240"
              loading="eager"
              decoding="async"
              class="w-[240px] h-[240px] rounded-[16px] bg-white p-3 box-border shrink-0"
              data-twint-qr
            />
            <div class="flex flex-col gap-1.5">
              <div class="text-[19px] font-bold">Twint</div>
              <p class="m-0 text-[17px] leading-[1.55] text-ink-2">{support.twintNote ?? 'Scan with the Twint app. Any amount helps.'}</p>
            </div>
          </Surface>
        )
      }
      <p class="m-0 text-[17px] leading-[1.55] text-ink-2">
        {qr ? 'Or write to ' : 'For a bank transfer or anything else, write to '}
        <a href={`mailto:${SITE.email}`} class="font-bold text-black">{SITE.email}</a>.
        {portalUrl ? (
          <>
            {' '}
            Already giving monthly?{' '}
            <a href={portalUrl} class="font-bold text-black">
              Manage or cancel your donation
            </a>
            .
          </>
        ) : (
          <> To change or cancel a monthly donation, write to the same address.</>
        )}
      </p>
    </section>

    <section aria-labelledby="h-goes" class="flex flex-col gap-[18px]">
      <h2 id="h-goes" class="m-0 text-[clamp(26px,2.8vw,36px)] leading-[1.15] font-bold">What support pays for</h2>
      {
        GOES.map(([h, d]) => (
          <div class="flex flex-col gap-1">
            <div class="text-[19px] font-bold">{h}</div>
            <div class="text-[17px] leading-[1.55] text-ink-2">{d}</div>
          </div>
        ))
      }
    </section>

    <section aria-labelledby="h-faq" class="flex flex-col gap-[18px]">
      <h2 id="h-faq" class="m-0 text-[clamp(26px,2.8vw,36px)] leading-[1.15] font-bold">Questions</h2>
      <div class="flex flex-col gap-1">
        <h3 class="m-0 text-[19px] font-bold">Do I get a receipt?</h3>
        <p class="m-0 text-[17px] leading-[1.55] text-ink-2">Yes. Stripe emails it to the address you give, here or on the payment page.</p>
      </div>
      <div class="flex flex-col gap-1" data-faq-cancel>
        <h3 class="m-0 text-[19px] font-bold">How do I cancel a monthly donation?</h3>
        <p class="m-0 text-[17px] leading-[1.55] text-ink-2">
          {
            portalUrl ? (
              <>
                At any time, <a href={portalUrl} class="font-bold text-black">in the Stripe customer portal</a>, or by writing to{' '}
              </>
            ) : (
              <>At any time: write to </>
            )
          }
          <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Cancel my monthly donation')}`} class="font-bold text-black">{SITE.email}</a> from the address you used,
          and we cancel it. No questions asked.
        </p>
      </div>
      <div class="flex flex-col gap-1">
        <h3 class="m-0 text-[19px] font-bold">My company wants to sponsor. Is this the right place?</h3>
        <p class="m-0 text-[17px] leading-[1.55] text-ink-2">
          This page is for individual donations. Sponsorship, with logo placement and other benefits, is on <a href="/partners" class="font-bold text-black">Host or sponsor</a>.
        </p>
      </div>
    </section>

    <section aria-labelledby="h-thanks" class="flex flex-col gap-[18px]">
      <h2 id="h-thanks" class="m-0 text-[clamp(26px,2.8vw,36px)] leading-[1.15] font-bold">Thank you</h2>
      <p class="m-0 text-[17px] leading-[1.55] text-ink-2">To everyone who has given so far, including:</p>
      <ul class="m-0 p-0 list-none flex flex-col gap-2">
        {
          THANKS.map((t) => (
            <li class="text-[18px] font-bold">
              <a href={t.href} target="_blank" rel="noopener" class="text-black">
                {t.name}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
