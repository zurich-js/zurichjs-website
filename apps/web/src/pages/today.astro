---
/**
 * /today, "Today": the phone-first page for a meetup evening.
 *
 * The meetup is picked at build time (one whose 48-hour feedback window is
 * open, else the next dated one); scheduled rebuilds at doors and doors + 48 h
 * move it on. Whether it is upcoming, on the day, live or over is decided by
 * the browser clock (islands/today/Tonight), so a future meetup is never
 * called "tonight".
 */
import { ROLE_LABEL, type Partner, type SupporterRole, dateLong, eventHref, eventThanks, pickTodayEvent, presentEvent, resolveState, todayPhase, upcomingEvents } from '@zurichjs/events';
import { SITE_URL } from '@zurichjs/seo';
import Tonight from '~/components/islands/today/Tonight';
import VenueCard from '~/components/islands/event/VenueCard';
import Programme from '~/components/islands/event/Programme';
import Button from '@zurichjs/design/components/Button.astro';
import Card from '@zurichjs/design/components/Card.astro';
import LogoRow from '@zurichjs/design/components/LogoRow.astro';
import { buttonClass } from '@zurichjs/design/recipes';
import { avatarSrc } from '@zurichjs/design/images';
import { SocialIcon } from '@zurichjs/design/islands/SocialLabel';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { BUILD_TIME, MAPS_EMBED_KEY, PREVIEW, SITE, content, slackLink } from '~/lib/content';

const { events, speakers, partners, settings } = await content();
const slack = slackLink(settings);
const ev = pickTodayEvent(events, BUILD_TIME);
const phase = todayPhase(ev, BUILD_TIME);
const names = Object.fromEntries(speakers.map((s) => [s.id, s.name]));
// Tonight is about an evening that has not ended its feedback window, so this season's sponsors are current for it.
const { own: supporters, season: seasonSponsors } = eventThanks(ev ?? {}, partners, { past: false });
// Each logo with its name, role and note as a caption (only when there is a role or note).
const thanksRow = (items: { partner: Partner; role?: SupporterRole; note?: string }[]) =>
  items.map(({ partner, role, note }) => ({ partner, caption: role || note ? [partner.name, role ? ROLE_LABEL[role] : '', note].filter(Boolean).join(' · ') : undefined }));
const after = ev
  ? upcomingEvents(events, BUILD_TIME).find((e) => e.id !== ev.id && resolveState(e, BUILD_TIME) !== 'cancelled' && (!ev.startsAt || !e.startsAt || e.startsAt > ev.startsAt))
  : undefined;
const afterP = after ? presentEvent(after, { now: BUILD_TIME }) : undefined;
const eventUrl = ev ? `${SITE_URL}${eventHref(ev)}?utm_source=today` : '';
const postText = ev ? `At ${ev.title} with @ZurichJS, the JavaScript community in Zurich. ${eventUrl}` : '';
// Share links with the event prefilled. Instagram has no share link, so it gets the handle instead.
const SHARE = ev
  ? [
      { kind: 'linkedin' as const, label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(eventUrl)}` },
      { kind: 'x' as const, label: 'X', href: `https://x.com/intent/post?text=${encodeURIComponent(postText)}` },
      { kind: 'bluesky' as const, label: 'Bluesky', href: `https://bsky.app/intent/compose?text=${encodeURIComponent(postText)}` },
    ]
  : [];
const FOLLOW = [
  { kind: 'linkedin' as const, label: 'LinkedIn', href: SITE.linkedinUrl },
  { kind: 'instagram' as const, label: 'Instagram', href: SITE.instagramUrl },
  { kind: 'x' as const, label: 'X', href: SITE.xUrl },
  { kind: 'bluesky' as const, label: 'Bluesky', href: SITE.blueskyUrl },
  { kind: 'meetup' as const, label: 'Meetup', href: SITE.meetupGroupUrl },
  { kind: 'slack' as const, label: 'Slack', href: slack.href },
]
// The programme is the event page's own (talk cards, ratings in the feedback window), so it reads the same here.
const progSpeakers = speakers.map(({ id, name, role, initials, photo }) => ({ id, name, role, initials, avatar: photo ? avatarSrc(photo.src, 48) : undefined }));
const description = ev
  ? `ZurichJS on the evening of a meetup: arrival and directions, the running order with times, and talk ratings. Next: ${ev.title}${ev.startsAt ? `, ${dateLong(ev.startsAt)}` : ''}.`
  : 'ZurichJS on the evening of a meetup: arrival and directions, the running order with times, and talk ratings.';
---

<BaseLayout title="Today" description={description}>
  <section slot="opening" class="px-gut flex flex-col justify-center gap-4 min-h-opening pt-4 md:pt-10 pb-9 md:pb-16">
    <Tonight client:load part="opening" ev={ev} names={names} now={BUILD_TIME.toISOString()} />
  </section>

  <div class="flex flex-col gap-section pt-section pb-6 md:pb-14">
    {ev && <Tonight client:load part="feedback" ev={ev} now={BUILD_TIME.toISOString()} />}

    {/* The old /today layout: what to do on the left (feedback, sharing, staying in touch), the evening itself on the
        right (programme, getting there, who made it possible). On phones the programme comes first, then the rest. Then supporting ZurichJS, full width. */}
    <div class="px-gut grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)] gap-section md:gap-10 items-start">
      <div class="flex flex-col gap-10">
        {
          ev && (
            <section aria-labelledby="h-feedback" class="flex flex-col gap-4">
              <h2 id="h-feedback" class="m-0 text-subsection font-bold">
                Your feedback
              </h2>
              <div class="flex flex-col gap-4">
                <Card title="Rate the talks" padding="lg">
                  <p class="m-0 text-body">Rate each talk on the event page once it has started. Speakers read the ratings for their own talk.</p>
                  <Button slot="footer" href={`${eventHref(ev)}?feedback=true#programme`} variant="cta">
                    Rate the talks
                  </Button>
                </Card>
                <Card title="Tell us about the evening" padding="lg">
                  <p class="m-0 text-body">A few open questions for the organisers. Only they read your answers.</p>
                  <Button slot="footer" href={`/feedback?event=${ev.slug}`} variant="primary">
                    Give feedback
                  </Button>
                </Card>
              </div>
            </section>
          )
        }

        <section aria-labelledby="h-share" class="flex flex-col gap-4">
          <h2 id="h-share" class="m-0 text-subsection font-bold">Share the evening</h2>
        {
          ev && (
            <Card title="Post about it" padding="lg">
              <p class="m-0 text-body">
                A photo, your favourite takeaway or a thank-you to a speaker. Tag ZurichJS: it helps more people find the community, and the speakers love seeing it.
              </p>
              <ul class="m-0 p-0 list-none flex flex-wrap gap-2" aria-label="Post about this meetup">
                {SHARE.map((x) => (
                  <li>
                    <a
                      href={x.href}
                      target="_blank"
                      rel="noopener"
                      class={buttonClass({ variant: 'secondary' })}
                    >
                      <SocialIcon kind={x.kind} size={16} />
                      Post on {x.label}
                    </a>
                  </li>
                ))}
              </ul>
              <p class="m-0 text-compact">
                On Instagram, tag <a href={SITE.instagramUrl} target="_blank" rel="noopener" class="font-bold">@zurich.js</a>.
              </p>
            </Card>
          )
        }
        <Card title="Stay connected" padding="lg">
          <p class="m-0 text-body">Talk between meetups on Slack, and follow us for the next dates and the photos.</p>
          <ul class="m-0 p-0 list-none flex flex-wrap items-center gap-2" aria-label="ZurichJS online">
            {
              FOLLOW.map((x) => (
                <li>
                  <a
                    href={x.href}
                    target="_blank"
                    rel="noopener"
                    title={x.label}
                    aria-label={`ZurichJS on ${x.label} (opens in a new tab)`}
                    class={buttonClass({ variant: 'secondary', iconOnly: true })}
                  >
                    <SocialIcon kind={x.kind} size={17} />
                  </a>
                </li>
              ))
            }
          </ul>
        </Card>
        </section>
      </div>
      {/* On phones this wrapper dissolves (contents) so the programme leads the page; from 800px it is the right column. */}
      <div class="contents md:flex md:flex-col md:gap-10">
        {
          ev && ev.agenda.length > 0 && (
            <div class="order-first md:order-none min-w-0">
              <Programme client:load ev={ev} initial={resolveState(ev, BUILD_TIME)} speakers={progSpeakers} heading={phase === 'upcoming' ? 'Programme and talks' : 'Today’s programme'} preview={PREVIEW} />
            </div>
          )
        }

        {
          ev?.venue && <VenueCard client:visible venue={ev.venue} mapsKey={MAPS_EMBED_KEY} heading="Getting there" compact />
        }

        {
          (supporters.length > 0 || seasonSponsors.length > 0) && (
            <section aria-labelledby="h-made" class="flex flex-col gap-4">
              <h2 id="h-made" class="m-0 text-subsection font-bold">
                Thanks to
              </h2>
              {supporters.length > 0 && (
                <>
                  <p class="m-0 text-body text-ink-2">The companies supporting this meetup.</p>
                  <LogoRow items={thanksRow(supporters)} />
                </>
              )}
              {seasonSponsors.length > 0 && (
                <>
                  <p class="m-0 text-body text-ink-2">Supporting ZurichJS this season.</p>
                  <LogoRow items={seasonSponsors.map((partner) => ({ partner }))} />
                </>
              )}
            </section>
          )
        }
      </div>
    </div>

    <section aria-labelledby="h-support" class="px-gut -mt-16 grid grid-cols-1 md:grid-cols-3 gap-4">
      <h2 id="h-support" class="m-0 text-subsection font-bold col-span-full">Keep ZurichJS going</h2>
      <Card title="Become a member" padding="lg">
        <p class="m-0 text-body">
          Join the {SITE.association}, the association (Verein) behind ZurichJS. Members fund the meetups and have a say in how the community grows.
        </p>
        <Button slot="footer" href="/membership" variant="primary">
          Become a member
        </Button>
      </Card>
      <Card title="Donate" padding="lg">
        <p class="m-0 text-body">Meetups are free and run by volunteers. A donation, once or monthly, pays for food, drinks and the tools behind them.</p>
        <Button slot="footer" href="/donate" variant="primary">
          Donate
        </Button>
      </Card>
      <Card title="Coming up" padding="lg">
        <p class="m-0 text-body">
          {after && afterP ? `${after.title}: ${afterP.dateLineShort}.` : 'The meetup after this one is being planned. It is announced on Meetup first.'}
        </p>
        <Button slot="footer" href={after ? eventHref(after) : '/events'} variant="primary">
          {after ? 'See that meetup' : 'See all events'}
        </Button>
      </Card>
    </section>


  </div>
</BaseLayout>
