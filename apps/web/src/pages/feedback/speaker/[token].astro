---
/**
 * Private speaker feedback (on demand, noindex). Speakers open the link
 * production emailed them; the token is checked and the ratings are read on
 * every request, so nothing personal is prerendered or cached.
 */
import { dateShort } from '@zurichjs/events';
import PageOpening from '@zurichjs/design/components/PageOpening.astro';
import Button from '@zurichjs/design/components/Button.astro';
import Card from '@zurichjs/design/components/Card.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { loadSpeakerFeedback, type TalkFeedback } from '~/server/speaker-feedback';

export const prerender = false;

const token = Astro.params.token ?? '';
const r = await loadSpeakerFeedback(token);
Astro.response.status = r.ok ? 200 : r.status === 502 ? 503 : 404;
Astro.response.headers.set('cache-control', 'private, no-store');
Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');
Astro.response.headers.set('referrer-policy', 'no-referrer');

const data = r.ok ? r.data : null;
const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;
const avg = (n: number | null) => (n === null ? '–' : n.toFixed(1));
const share = (t: TalkFeedback, i: number) => {
  const rated = t.distribution.reduce((a, b) => a + b, 0);
  const n = t.distribution[i] ?? 0;
  return rated ? Math.round((n * 100) / rated) : 0;
};
const sub = data
  ? data.total
    ? `${plural(data.total, 'response')} across ${plural(data.talks.length, 'talk')}. Only you can see this page.`
    : 'No one has rated your talks yet. Ratings and comments appear here as soon as they come in.'
  : r.ok
    ? ''
    : r.error;
---

<BaseLayout
  title={data ? `Feedback for ${data.speaker.name}` : 'Speaker feedback'}
  description="Private page where ZurichJS speakers read the ratings and comments the audience left for their talks."
  path="/feedback/speaker"
  noindex
>
  <PageOpening slot="opening" title={data ? `Feedback for ${data.speaker.name}` : 'Speaker feedback'} sub={sub} />

  <div class="px-gut py-section flex flex-col gap-section">
    {
      !data && (
        <Card as="section" surface="filled" padding="lg" level="h2" title={!r.ok && r.status === 502 ? 'Please try again soon' : 'Ask for a new link'} class="max-w-reading">
          <p class="m-0 text-body text-ink-2">
            {
              !r.ok && r.status === 502
                ? 'Your link is fine; we couldn’t reach the feedback right now.'
                : 'Feedback links stop working after a while. Email hello@zurichjs.com and an organiser will send you a fresh one.'
            }
          </p>
          <Button slot="footer" href="mailto:hello@zurichjs.com" variant="cta">
            Email the organisers
          </Button>
        </Card>
      )
    }

    {
      data && data.total > 0 && (
        <section aria-label="Summary" class="grid grid-cols-auto-sm gap-3">
          <Card surface="filled">
            <span class="text-section leading-none font-bold">{avg(data.average)}</span>
            <span class="text-body">average rating</span>
          </Card>
          <Card surface="filled">
            <span class="text-section leading-none font-bold">{data.total}</span>
            <span class="text-body text-ink-2">{data.total === 1 ? 'response' : 'responses'}</span>
          </Card>
          <Card surface="filled">
            <span class="text-section leading-none font-bold">{data.talks.reduce((n, t) => n + t.comments.length, 0)}</span>
            <span class="text-body text-ink-2">written comments</span>
          </Card>
        </section>
      )
    }

    {
      data?.talks.map((t) => (
        <section aria-labelledby={`t-${t.key}`} class="flex flex-col gap-5">
          <div class="flex flex-col gap-1.5">
            <h2 id={`t-${t.key}`} class="m-0 text-subsection font-bold text-pretty">
              {t.title}
            </h2>
            {(t.eventTitle || t.eventDate) && (
              <p class="m-0 text-body text-ink-2">
                {t.eventSlug ? (
                  <a href={`/events/${t.eventSlug}`} class="font-bold text-black underline">{t.eventTitle}</a>
                ) : (
                  t.eventTitle
                )}
                {t.eventDate && ` · ${dateShort(t.eventDate)}`}
              </p>
            )}
          </div>
          <div class="grid grid-cols-auto-md gap-8 items-start">
            <Card surface="filled">
              <div class="flex items-baseline gap-3 flex-wrap">
                <span class="text-section leading-none font-bold">{avg(t.average)}</span>
                <span class="text-body text-ink-2">
                  average from {plural(t.distribution.reduce((a, b) => a + b, 0), 'rating')}
                </span>
              </div>
              <ul class="m-0 p-0 list-none flex flex-col gap-2" aria-label="Ratings by stars">
                {[4, 3, 2, 1, 0].map((i) => (
                  <li class="grid grid-cols-[64px_minmax(0,1fr)_32px] gap-3 items-center text-compact">
                    <span>{i + 1} {i === 0 ? 'star' : 'stars'}</span>
                    <span class="h-2.5 rounded-pill bg-white overflow-hidden" aria-hidden="true">
                      <span class="block h-full rounded-pill bg-black" style={`width:${share(t, i)}%`} />
                    </span>
                    <span class="text-right font-bold">{t.distribution[i]}</span>
                  </li>
                ))}
              </ul>
            </Card>
            <div class="flex flex-col gap-3 min-w-0">
              <h3 class="m-0 text-card-title font-bold">Comments</h3>
              {t.comments.length === 0 ? (
                <p class="m-0 text-body text-ink-2">No written comments for this talk.</p>
              ) : (
                <ul class="m-0 p-0 list-none flex flex-col gap-2.5">
                  {t.comments.map((c) => (
                    <Card as="li" surface="filled" padding="sm">
                      <p class="m-0 text-body whitespace-pre-line wrap-break-word">“{c.text}”</p>
                      <span class="text-meta text-grey-text">
                        {[c.rating ? `${c.rating} ${c.rating === 1 ? 'star' : 'stars'}` : '', c.submittedAt ? dateShort(c.submittedAt) : ''].filter(Boolean).join(' · ')}
                      </span>
                    </Card>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </section>
      ))
    }

    {
      data && (
        <p class="m-0 text-body text-ink-2 max-w-reading">
          Questions about this feedback, or want to speak again? Email <a href="mailto:hello@zurichjs.com" class="font-bold text-black">hello@zurichjs.com</a> or <a href="/cfp" class="font-bold text-black">propose another talk</a>.
        </p>
      )
    }
  </div>
</BaseLayout>
