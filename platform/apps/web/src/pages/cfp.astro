---
import PageOpening from '~/components/layout/PageOpening.astro';
import CfpForm, { CFP_SUBS } from '~/components/islands/forms/CfpForm';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { confLink } from '~/lib/analytics';
import { content, nextMeetupHref } from '~/lib/content';

const { conference } = await content();
const nextHref = await nextMeetupHref();
---

<BaseLayout
  image="/og/cfp.png"
  title="Call for Papers"
  fullTitle="Call for Papers · Speak at a ZurichJS Meetup"
  description="Propose a talk for a ZurichJS meetup in Zurich: lightning, standard or deep dive. First-time speakers welcome, with mentoring from the organisers."
  keywords={['call for papers', 'CFP Zurich', 'speak at a meetup', 'JavaScript talk Zurich', 'tech talk proposal', 'ZurichJS speakers']}
>
  <PageOpening slot="opening" title="Speak at a meetup"><span slot="sub" id="cfp-sub">{CFP_SUBS[0]}</span></PageOpening>
  <div class="px-gut pt-[clamp(40px,5vw,72px)] pb-[clamp(64px,8vw,104px)]">
    <CfpForm client:load nextHref={nextHref} confHref={confLink('/cfp', 'cfp')} confCfp={conference.copy.cfp} confState={conference.state} />
  </div>
</BaseLayout>
