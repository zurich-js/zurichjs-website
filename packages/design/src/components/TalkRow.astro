---
/**
 * One past talk as a filled link card (Bogdan's review, 4th November 2026): the title as the strongest
 * element with the card's arrow, then the speaker, the date and the format. The whole card is one link to
 * the talk on its event page.
 */
import type { Speaker } from '@zurichjs/events';
import { monogramClass } from '../recipes';
import { avatarSrc } from '../images';
import Card from './Card.astro';

export interface TalkRowData {
  title: string;
  speakers: Speaker[];
  date: string; // "Sep 2026"
  format: string; // "Talk" | "Lightning talk"
  href: string;
}
interface Props {
  t: TalkRowData;
}
const { t } = Astro.props;
const lead = t.speakers[0];
---

<Card surface="filled" title={t.title} level="p" href={t.href}>
  <div class="mt-auto pt-2 flex items-center gap-3 min-w-0">
    {
      lead?.photo ? (
        <img src={avatarSrc(lead.photo.src, 40)} alt="" width="40" height="40" loading="lazy" decoding="async" class="size-10 rounded-full object-cover bg-grey flex-none" />
      ) : (
        <span aria-hidden="true" class={monogramClass('white', 'avatar', 'size-10 flex-none')}>
          {lead?.initials ?? '?'}
        </span>
      )
    }
    <span class="flex flex-col min-w-0 text-compact">
      <span class="font-bold truncate">{t.speakers.map((s) => s.name).join(', ')}</span>
      <span class="text-ink-2">{t.date} · {t.format}</span>
    </span>
  </div>
</Card>
