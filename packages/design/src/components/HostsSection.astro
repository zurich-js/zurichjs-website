---
/**
 * The companies behind ZurichJS, in three steps of attention (owner, 19th November 2026): the sponsors and hosts
 * who fund the meetups, in their own colours and framed, sized by tier; community and conference partners, faint
 * in a moving row; and everyone who supported us before, in a second row that moves the other way.
 */
import type { Partner } from '@zurichjs/events';
import Heading from './Heading.astro';
import LogoMarquee from './LogoMarquee.astro';
import LogoWall from './LogoWall.astro';

interface Props {
  /** Community and conference partners. */
  partners: Partner[];
  /** Current sponsors and hosts, highest tier first: the tier sets the size of their cell. */
  sponsors?: Partner[];
  /** Everyone who supported ZurichJS before. */
  past?: Partner[];
  heading?: string;
  link?: boolean;
}
const { partners, sponsors = [], past = [], heading = 'Companies who host and support ZurichJS', link = true } = Astro.props;
---

{
  sponsors.length + partners.length > 0 && (
    <section aria-labelledby="h-hosts" class="flex flex-col gap-8">
      <div class="px-gut max-w-reading box-content">
        <Heading id="h-hosts">{heading}</Heading>
      </div>
      {sponsors.length > 0 && (
        <div class="px-gut flex flex-col gap-3">
          <Heading as="h3" size="card">
            Thank you to everyone supporting us today
          </Heading>
          <LogoWall partners={sponsors} byTier tone="colour" label="Current sponsors and hosts" />
        </div>
      )}
      {/* The two rows span the screen (no gutter) and fade out at its edges; their headings stay in the column. */}
      {partners.length > 0 && (
        <div class="flex flex-col gap-3">
          <Heading as="h3" size="card" class="px-gut">
            Community and conference partners
          </Heading>
          <LogoMarquee partners={partners} label="Community and conference partners" />
        </div>
      )}
      {past.length > 0 && (
        <div class="flex flex-col gap-3">
          <Heading as="h3" size="card" class="px-gut">
            And thank you to everyone who helped us get here
          </Heading>
          <LogoMarquee partners={past} reverse label="Past supporters" />
        </div>
      )}
      {link && (
        <a href="/partners" class="mx-gut self-start font-bold text-body underline">
          Host a meetup or support the community
        </a>
      )}
    </section>
  )
}
