{
  "ci": {
    "collect": {
      "startServerCommand": "node tools/serve-dist.mjs 4330",
      "startServerReadyPattern": "serving",
      "url": ["http://localhost:4330/", "http://localhost:4330/events/2026-11-forms-types", "http://localhost:4330/speakers/anna-beispiel"],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--headless=new --no-sandbox --no-proxy-server" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
