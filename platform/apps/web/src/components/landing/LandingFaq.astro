---
/** The visible FAQ. Pass the same array to faqSchema() so the FAQPage JSON-LD matches it word for word. */
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Surface from '~/components/ui/Surface.astro';

interface Props {
  faqs: { question: string; answer: string }[];
}
const { faqs } = Astro.props;
---

<section aria-labelledby="h-faq" class="px-gut flex flex-col gap-7">
  <SectionHeading id="h-faq">Frequently asked questions</SectionHeading>
  <div class="flex flex-col gap-3 max-w-[880px]">
    {
      faqs.map((f) => (
        <Surface tone="soft" class="p-[clamp(20px,3vw,28px)] flex flex-col gap-2.5">
          <h3 class="m-0 text-[clamp(19px,1.8vw,22px)] leading-[1.3] font-bold text-pretty">{f.question}</h3>
          <p class="m-0 text-[17px] leading-[1.6] text-ink-2 text-pretty">{f.answer}</p>
        </Surface>
      ))
    }
  </div>
</section>
