---
/** A soft filled, rounded surface. Used only where grouping helps. */
import { surfaceClass, type SurfaceTone } from '~/lib/ui';
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'div'> & { tone?: SurfaceTone; as?: 'div' | 'section' | 'aside' | 'figure' | 'li' };
const { tone = 'grey', as: Tag = 'div', class: extra, ...rest } = Astro.props;
---

<Tag class={surfaceClass(tone, extra as string | undefined)} {...rest}><slot /></Tag>
