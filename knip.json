{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["vendor/**", "tools/*.d.mts"],
  "workspaces": {
    ".": {
      "entry": ["tools/**/*.{mjs,ts}", "e2e/**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/pages/**/*.{astro,ts}", "netlify/functions/*.mts", "scripts/*.mjs", "test/**/*.ts"],
      "project": ["src/**/*.{astro,ts,tsx,css}", "netlify/**/*.mts", "scripts/*.mjs"]
    },
    "packages/config": {
      "ignoreDependencies": ["preact"]
    },
    "packages/design": {
      "entry": ["scripts/*.mjs", "test/**/*.ts"],
      "project": ["src/**/*.{astro,ts,tsx}", "scripts/*.mjs"]
    },
    "packages/*": {
      "entry": ["test/**/*.ts"]
    }
  },
  "ignoreWorkspaces": ["apps/studio"]
}
