---
/** One template for the four policy pages: tabs, "On this page" on desktop, the text. */
import { getCollection, render } from 'astro:content';
import { dateShort } from '@zurichjs/events';
import { breadcrumbSchema } from '@zurichjs/seo';
import PageOpening from '@zurichjs/design/components/PageOpening.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/lib/content';
import { chipClass } from '@zurichjs/design/recipes';

export async function getStaticPaths() {
  const all = (await getCollection('policies')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}

const { entry, all } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings.filter((h) => h.depth === 2);
const isCoc = entry.id === 'code-of-conduct';
---

<BaseLayout title={entry.data.title} description={entry.data.description} jsonLd={[breadcrumbSchema([{ name: 'Policies', path: `/policies/${entry.id}` }, { name: entry.data.title, path: `/policies/${entry.id}` }])]}>
  <PageOpening slot="opening" title={entry.data.title} compact />
  <div class="px-gut py-section flex flex-col gap-10">
    <nav aria-label="Policies" class="flex gap-2 flex-wrap">
      {
        all.map((p) => (
          <a
            href={`/policies/${p.id}`}
            aria-current={p.id === entry.id ? 'page' : undefined}
            class={chipClass(p.id === entry.id)}
          >
            {p.data.tab}
          </a>
        ))
      }
    </nav>
    <div class="grid grid-cols-1 md:grid-cols-[220px_minmax(0,1fr)] gap-8 md:gap-16 items-start">
      <nav aria-label="On this page" class="hidden md:flex sticky top-28 flex-col gap-1">
        <div class="text-compact font-bold mb-1.5">On this page</div>
        {sections.map((s) => <a href={`#${s.slug}`} class="py-1.5 text-compact text-ink-2 no-underline hover:text-black hover:underline">{s.text}</a>)}
      </nav>
      <article class="flex flex-col gap-8 max-w-reading min-w-0">
        <div class="text-compact text-grey-text">Last updated {dateShort(entry.data.updated.toISOString())}</div>
        {
          isCoc && (
            <div class="bg-grey rounded-card p-card-md flex flex-col gap-2">
              <div class="text-card-title font-bold">Report a concern</div>
              <div class="text-body">
                At a meetup, talk to an organiser in a yellow ZurichJS T-shirt. Any other time, email{' '}
                <a href={`mailto:${SITE.email}`} class="font-bold">
                  {SITE.email}
                </a>
                . Reports are handled in confidence. In an emergency, call 112.
              </div>
            </div>
          )
        }
        <div class="prose">
          <Content />
        </div>
        <div class="text-compact text-ink-2">
          Questions about this policy? Email <a href={`mailto:${SITE.email}`} class="font-bold">{SITE.email}</a>.
        </div>
      </article>
    </div>
  </div>
</BaseLayout>
