{
  "name": "zurichjs-website",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter @zurichjs/web dev",
    "build": "pnpm --filter @zurichjs/web build",
    "preview": "pnpm --filter @zurichjs/web preview",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "seo:snapshot": "node tools/seo/snapshot.mjs",
    "seo:check": "node tools/seo/compare.mjs",
    "e2e": "playwright test",
    "agent": "tsx tools/agent-cli.ts",
    "speaker-link": "tsx tools/speaker-profile-link.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.3",
    "@zurichjs/agent": "workspace:*",
    "husky": "9.1.7",
    "knip": "6.43.0",
    "lint-staged": "15.5.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.73.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,mjs,ts,tsx,astro}": "oxlint --fix --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22.23.4",
    "pnpm": "11.x"
  },
  "packageManager": "pnpm@11.15.1"
}
