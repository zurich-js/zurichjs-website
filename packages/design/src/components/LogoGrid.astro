---
/**
 * Partner logos. Each links to the partner (new tab) and the image's alt is
 * the company name, so the link has an accessible name; without a logo the
 * name is shown as text. Sponsors who asked for referral analytics
 * (`allowReferrer`) get links without `noreferrer`. Renders nothing when empty.
 */
import type { Partner } from '@zurichjs/events';

interface Props {
  partners: Partner[];
  /** Shown under each logo, e.g. "Venue host" or the partner's own line. */
  caption?: (p: Partner) => string | undefined;
  /** Logo size; sponsorship tiers promise XL, large, medium and small logos. */
  size?: LogoSize;
}
type LogoSize = 'xl' | 'lg' | 'md' | 'sm';
const { partners, caption, size = 'md' } = Astro.props;
const SIZES: Record<LogoSize, { grid: string; box: string; img: string; w: number; h: number }> = {
  xl: { grid: 'grid-cols-[repeat(auto-fill,minmax(min(100%,300px),1fr))]', box: 'h-36 px-8', img: 'max-h-24', w: 240, h: 96 },
  lg: { grid: 'grid-cols-[repeat(auto-fill,minmax(min(100%,220px),1fr))]', box: 'h-28 px-6', img: 'max-h-16', w: 180, h: 64 },
  md: { grid: 'grid-cols-[repeat(auto-fill,minmax(min(100%,160px),1fr))]', box: 'h-20 px-4', img: 'max-h-12', w: 120, h: 48 },
  sm: { grid: 'grid-cols-[repeat(auto-fill,minmax(min(100%,130px),1fr))]', box: 'h-16 px-3', img: 'max-h-10', w: 100, h: 40 },
};
const z = SIZES[size];
const rel = (p: Partner) => (p.allowReferrer ? 'noopener' : 'noopener noreferrer');
---

{
  partners.length > 0 && (
    <ul class={`grid ${z.grid} gap-3 list-none m-0 p-0`}>
      {partners.map((p) => (
        <li class="flex flex-col gap-1.5">
          {p.url ? (
            <a href={p.url} target="_blank" rel={rel(p)} class={`${z.box} rounded-2xl bg-grey flex items-center justify-center no-underline text-black hover:bg-grey-soft`}>
              {p.logo ? (
                <img src={p.logo} alt={`${p.name} (opens in a new tab)`} width={z.w} height={z.h} loading="lazy" decoding="async" class={`${z.img} max-w-full w-auto object-contain`} />
              ) : (
                <span class="font-bold text-[16px] text-center">{p.name}</span>
              )}
            </a>
          ) : (
            <div class={`${z.box} rounded-2xl bg-grey flex items-center justify-center`}>
              {p.logo ? (
                <img src={p.logo} alt={p.name} width={z.w} height={z.h} loading="lazy" decoding="async" class={`${z.img} max-w-full w-auto object-contain`} />
              ) : (
                <span class="font-bold text-[16px] text-center">{p.name}</span>
              )}
            </div>
          )}
          {caption?.(p) && <span class="text-[14px] text-ink-2 px-1 leading-snug">{caption(p)}</span>}
        </li>
      ))}
    </ul>
  )
}
