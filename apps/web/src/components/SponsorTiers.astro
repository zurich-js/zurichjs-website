---
/**
 * Current sponsors by tier: each one a link card to the sponsor's site, with its logo at the size the tier
 * promises (XL, large, medium, small), its name and its own words. Sponsors who asked for referral analytics
 * (`allowReferrer`) get links without `noreferrer`.
 */
import { TIER_LABEL, type Partner, type SponsorTier } from '@zurichjs/events';
import Card from '@zurichjs/design/components/Card.astro';
import Heading from '@zurichjs/design/components/Heading.astro';
import { partnerRel } from '@zurichjs/design/logos';

interface Props {
  groups: { tier?: SponsorTier; partners: Partner[] }[];
}
const { groups } = Astro.props;
const LOGO: Record<SponsorTier | 'none', { box: string; img: string; cols: string }> = {
  champion: { box: 'h-28', img: 'max-h-20', cols: 'grid-cols-1' },
  builder: { box: 'h-24', img: 'max-h-16', cols: 'grid-cols-1' },
  friend: { box: 'h-16', img: 'max-h-14', cols: 'grid-cols-auto-md' },
  supporter: { box: 'h-14', img: 'max-h-12', cols: 'grid-cols-auto-md' },
  none: { box: 'h-14', img: 'max-h-12', cols: 'grid-cols-auto-md' },
};
---

<div class="flex flex-col gap-7 md:gap-10">
  {
    groups.map((g) => {
      const z = LOGO[g.tier ?? 'none'];
      return (
        <div class="flex flex-col gap-4">
          <Heading as="h3" size="card">
            {g.tier ? TIER_LABEL[g.tier] : 'Sponsors'}
          </Heading>
          <ul class={`grid ${z.cols} gap-4 list-none m-0 p-0`}>
            {g.partners.map((p) => (
              // The whole card is the link to the sponsor (Bogdan's review, 12th November 2026); the logo leads.
              <Card as="li" title={p.name} href={p.url} external linkAttrs={p.url ? { rel: partnerRel(p) } : undefined}>
                {p.logo && (
                  <div class={`${z.box} order-first flex items-center`}>
                    <img src={p.logo} alt="" width="240" height="96" loading="lazy" decoding="async" class={`${z.img} max-w-full w-auto object-contain`} />
                  </div>
                )}
                {(p.blurb || p.description) && <p class="m-0 text-body text-ink-2">{p.blurb ?? p.description}</p>}
              </Card>
            ))}
          </ul>
        </div>
      );
    })
  }
</div>
