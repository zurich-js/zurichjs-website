---
/**
 * Support ZurichJS at the production URL /donate (301s from /buy-us-a-coffee
 * and /support keep working, with their query strings).
 *
 * Online donations, one-time or monthly, go through Stripe Checkout (owner
 * decision 2026-11-01, docs/v2/DECISIONS.md). Twint (QR from Sanity Site
 * settings) and email stay as alternatives. Membership of the association is
 * separate: /membership.
 */
import DonateForm from '~/components/islands/forms/DonateForm';
import PageOpening from '@zurichjs/design/components/PageOpening.astro';
import Card from '@zurichjs/design/components/Card.astro';
import AutoGrid from '@zurichjs/design/components/AutoGrid.astro';
import Button from '@zurichjs/design/components/Button.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import RetiredNotice from '~/components/RetiredNotice.astro';
import { SITE, content } from '~/lib/content';

const { support } = await content();
const qr = support.twintQr;
const portalUrl = import.meta.env.PUBLIC_STRIPE_PORTAL_URL || process.env.PUBLIC_STRIPE_PORTAL_URL || undefined;

// The same list as membership (owner, 3rd November 2026). Speaker travel is not listed: meetup talks don't cover it.
const GOES = [
  ['Food and drinks', 'On the evenings that no host or sponsor covers.'],
  ['Subscriptions', 'Meetup.com and the tools that keep the community running.'],
  ['Team travel', 'Travel for the organising team.'],
];
const WAYS = [
  { h: 'Become a member', d: 'Join the Swiss JavaScript Group, the association behind ZurichJS.', href: '/membership' },
  { h: 'Host or sponsor a meetup', d: 'For companies: a room, food and drinks, or a contribution.', href: '/partners' },
  { h: 'Speak at a meetup', d: 'First-time speakers are welcome, and we help you prepare.', href: '/cfp' },
  { h: 'Volunteer', d: 'Help on the night or behind the scenes.', href: '/cfv' },
];
---

<BaseLayout
  title="Support ZurichJS"
  fullTitle="Support ZurichJS · Help the JavaScript Community in Zurich"
  description="Donate to ZurichJS once or monthly, or support it as a member, host, sponsor, speaker or volunteer. Meetups are free and run by volunteers."
  keywords={['donate ZurichJS', 'support ZurichJS', 'sponsor ZurichJS', 'JavaScript community Zurich', 'ZurichJS membership', 'non-profit meetup Switzerland']}
>
  <PageOpening slot="opening" title="Support ZurichJS" sub="Meetups are free to attend. We started on personal savings; donations, members and partners now cover the evenings.">
    <div class="flex flex-wrap gap-3 pt-1">
      <Button href="#donate" variant="cta" grow>Donate</Button>
      <Button href="/membership" variant="secondary" inverse grow>Become a member</Button>
    </div>
  </PageOpening>
  <RetiredNotice />
  <div class="px-gut pt-page-top pb-page-end flex flex-col gap-section max-w-wide">
    <section id="donate" aria-labelledby="h-donate" class="flex flex-col gap-4 scroll-mt-6 max-w-reading">
      <div class="flex flex-col gap-2">
        <h2 id="h-donate" class="m-0 text-subsection font-bold">Donate</h2>
        <p class="m-0 text-body text-ink-2 max-w-reading">
          A donation is a gift to ZurichJS; it doesn’t make you a member. To join the association with a vote, see <a href="/membership" class="font-bold text-black">membership</a>.
        </p>
      </div>
      <DonateForm client:load portalUrl={portalUrl} email={SITE.email} twint={!!qr} />
    </section>

    <section aria-labelledby="h-goes" class="flex flex-col gap-5">
      <h2 id="h-goes" class="m-0 text-subsection font-bold">What your donation pays for</h2>
      <AutoGrid min="sm">
        {
          GOES.map(([h, d]) => (
            <Card title={h}>
              <p class="m-0 text-body text-ink-2">{d}</p>
            </Card>
          ))
        }
      </AutoGrid>
    </section>

    <section id="other-ways" aria-labelledby="h-oneoff" class="flex flex-col gap-4 scroll-mt-6">
      <h2 id="h-oneoff" class="m-0 text-subsection font-bold">Other ways to give</h2>
      {
        qr && (
          <Card class="items-start">
            <img
              src={`${qr.src}?w=480&fm=png`}
              alt={qr.alt}
              width="240"
              height="240"
              loading="eager"
              decoding="async"
              class="size-60 rounded-(--radius-nested) bg-white p-3 box-border shrink-0"
              data-twint-qr
            />
            <div class="flex flex-col gap-1.5">
              <h3 class="m-0 text-card-title font-bold">Twint</h3>
              <p class="m-0 text-body text-ink-2">{support.twintNote ?? 'Scan with the Twint app. Any amount helps.'}</p>
            </div>
          </Card>
        )
      }
      <p class="m-0 text-body text-ink-2">
        {qr ? 'Or write to ' : 'For a bank transfer or anything else, write to '}
        <a href={`mailto:${SITE.email}`} class="font-bold text-black">{SITE.email}</a>.
        {portalUrl ? (
          <>
            {' '}
            Already giving monthly?{' '}
            <a href={portalUrl} class="font-bold text-black">
              Manage or cancel your donation
            </a>
            .
          </>
        ) : (
          <> To change or cancel a monthly donation, write to the same address.</>
        )}
      </p>
    </section>

    <section aria-labelledby="h-ways" class="flex flex-col gap-4">
      <h2 id="h-ways" class="m-0 mb-1 text-subsection font-bold">Ways to help</h2>
      <AutoGrid min="md" gap="sm">
        {
          WAYS.map((o) => (
            <Card href={o.href} title={o.h} surface="filled">
              <p class="m-0 text-compact text-ink-2">{o.d}</p>
            </Card>
          ))
        }
      </AutoGrid>
    </section>

    <section aria-labelledby="h-faq" class="flex flex-col gap-4">
      <h2 id="h-faq" class="m-0 text-subsection font-bold">Questions</h2>
      <div class="flex flex-col gap-1">
        <h3 class="m-0 text-card-title font-bold">Do I get a receipt?</h3>
        <p class="m-0 text-body text-ink-2">Yes. Stripe emails it to the address you give, here or on the payment page.</p>
      </div>
      <div class="flex flex-col gap-1" data-faq-cancel>
        <h3 class="m-0 text-card-title font-bold">How do I cancel a monthly donation?</h3>
        <p class="m-0 text-body text-ink-2">
          {
            portalUrl ? (
              <>
                At any time, <a href={portalUrl} class="font-bold text-black">in the Stripe customer portal</a>, or by writing to{' '}
              </>
            ) : (
              <>At any time: write to </>
            )
          }
          <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Cancel my monthly donation')}`} class="font-bold text-black">{SITE.email}</a> from the address you used,
          and we cancel it. No questions asked.
        </p>
      </div>
      <div class="flex flex-col gap-1">
        <h3 class="m-0 text-card-title font-bold">My company wants to sponsor. Is this the right place?</h3>
        <p class="m-0 text-body text-ink-2">
          This page is for individual donations. Sponsorship, with logo placement and other benefits, is on <a href="/partners" class="font-bold text-black">Host or sponsor</a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
