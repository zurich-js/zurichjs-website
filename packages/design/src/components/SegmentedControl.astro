---
/**
 * One pill with segments (billing cycle, one-time or monthly). Native radios, so it posts with the form
 * and arrow keys work without script. 48px in total, like a button: a 4px track around 40px options.
 * The Preact twin is islands/SegmentedControl.tsx.
 */
import { cx } from '../recipes.ts';

interface Props {
  name: string;
  legend: string;
  options: { value: string; label: string }[];
  value?: string;
  class?: string;
}
const { name, legend, options, value = options[0]?.value, class: extra } = Astro.props;
---

<fieldset class={cx('m-0 p-0 border-0 min-w-0', extra)}>
  <legend class="sr-only">{legend}</legend>
  <div class="inline-flex gap-1 h-control p-1 rounded-pill bg-grey">
    {
      options.map((o) => (
        <label class="relative inline-flex items-center justify-center h-full px-4 md:min-w-30 whitespace-nowrap rounded-pill font-bold text-compact cursor-pointer transition-colors hover:bg-grey-hover has-checked:bg-black has-checked:text-white has-focus-visible:outline-3 has-focus-visible:outline-blue has-focus-visible:outline-offset-2">
          {o.label}
          <input type="radio" name={name} value={o.value} checked={o.value === value} class="absolute inset-0 size-full m-0 opacity-0 cursor-pointer appearance-none" />
        </label>
      ))
    }
  </div>
</fieldset>
