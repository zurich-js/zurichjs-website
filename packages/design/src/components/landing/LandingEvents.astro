---
/**
 * Upcoming meetups for the landing pages, rendered from content at build time.
 * When nothing is scheduled, the most recent meetups take their place so the
 * section always links to real event pages.
 */
import { pastEvents, upcomingEvents, type Event, type TicketingProvider } from '@zurichjs/events';
import EventRow from '../EventRow.astro';
import Button from '../Button.astro';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  events: Event[];
  now: Date;
  ticketing?: TicketingProvider;
  meetupGroupUrl: string;
  id: string;
  title: string;
  sub: string;
  /** How many events to list. */
  limit?: number;
}
const { events, now, ticketing, meetupGroupUrl, id, title, sub, limit = 3 } = Astro.props;
const upcoming = upcomingEvents(events, now).slice(0, limit);
const list = upcoming.length ? upcoming : pastEvents(events, now).slice(0, limit);
---

{
  list.length > 0 && (
    <section aria-labelledby={id} class="px-gut flex flex-col gap-7">
      <SectionHeading id={id}>
        {upcoming.length ? title : 'Recent meetups in Zurich'}
        <Fragment slot="sub">{upcoming.length ? sub : 'The next date is announced on Meetup.com first. Here is what happened at the latest meetups.'}</Fragment>
        <Button slot="action" href="/events" variant="secondary">
          View all events
        </Button>
      </SectionHeading>
      <div class="flex flex-col gap-1 max-w-wide">
        {list.map((ev) => <EventRow ev={ev} now={now} ticketing={ticketing} />)}
      </div>
      <p class="m-0 text-body text-ink-2">
        <a href={meetupGroupUrl} target="_blank" rel="noopener" class="font-bold text-black">RSVP for every meetup in our Meetup.com group</a>
      </p>
    </section>
  )
}
