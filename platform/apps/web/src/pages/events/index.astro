---
/**
 * Event list. Both tabs (upcoming and past) are prerendered in full so every
 * event link is in the HTML; a small script switches tabs and filters by the
 * search text, keeping the state in the URL (?tab=past, ?q=…; ?search= is
 * accepted as an alias because the WebSite SearchAction points there).
 */
import { pastEvents, upcomingEvents, type Event } from '@zurichjs/events';
import { breadcrumbSchema } from '@zurichjs/seo';
import PageOpening from '@zurichjs/design/components/PageOpening.astro';
import EventRow from '@zurichjs/design/components/EventRow.astro';
import Button from '@zurichjs/design/components/Button.astro';
import Surface from '@zurichjs/design/components/Surface.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { BUILD_TIME, SITE, content, ticketing } from '~/lib/content';

const { events, speakers } = await content();
const byId = new Map(speakers.map((s) => [s.id, s.name]));
const upcoming = upcomingEvents(events, BUILD_TIME);
const past = pastEvents(events, BUILD_TIME);

/** Everything the search box matches: title, description, venue, talk titles and speaker names. */
const hay = (e: Event) =>
  [
    e.title,
    e.description,
    e.venue?.name,
    ...e.agenda.map((a) => a.title),
    ...e.agenda.flatMap((a) => (a.talk?.speakerIds ?? []).map((id) => byId.get(id))),
    ...(e.recap?.talks.flatMap((t) => [t.title, ...t.speakerIds.map((id) => byId.get(id))]) ?? []),
  ]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();

const TABS = [
  { k: 'upcoming', label: 'Upcoming', list: upcoming },
  { k: 'past', label: 'Past', list: past },
] as const;
---

<BaseLayout
  image="/og/events.png"
  title="Events"
  fullTitle="Upcoming and past JavaScript events in Zurich · ZurichJS"
  description="Upcoming and past ZurichJS meetups: JavaScript and TypeScript talks in Zurich for developers of all levels. Every event keeps its page, speakers and photos."
  keywords={['JavaScript meetup Zurich', 'TypeScript meetup Zurich', 'Zurich tech events', 'JavaScript events Switzerland', 'ZurichJS events']}
  jsonLd={[breadcrumbSchema([{ name: 'Events', path: '/events' }])]}
>
  <PageOpening slot="opening" title="Events" sub="JavaScript meetups in Zurich. Every past event keeps its page, speakers and photos, so the talks live on long after the night." compact />

  <div class="px-gut pt-[clamp(40px,5vw,72px)] pb-[clamp(64px,8vw,104px)] flex flex-col gap-7" data-events>
    <div class="flex flex-wrap gap-3 items-center">
      <div role="tablist" aria-label="When" class="flex gap-1 bg-grey rounded-pill p-1">
        {
          TABS.map((t, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${t.k}`}
              aria-controls={`panel-${t.k}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-tab={t.k}
              class="border-0 cursor-pointer min-h-[40px] px-[18px] rounded-pill font-bold text-[16px] bg-transparent text-black aria-selected:bg-black aria-selected:text-white"
            >
              {t.label}
            </button>
          ))
        }
      </div>
      <label class="flex-[1_1_240px] flex flex-col min-w-0">
        <span class="sr-only">Search events, talks and speakers</span>
        <input type="search" name="q" data-q placeholder="Search events, talks, speakers" autocomplete="off" class="min-h-[48px] border border-grey-line rounded-pill px-5 text-[17px] bg-white min-w-0" />
      </label>
    </div>

    {
      TABS.map((t, i) => (
        <div role="tabpanel" id={`panel-${t.k}`} aria-labelledby={`tab-${t.k}`} data-panel={t.k} hidden={i !== 0} class="flex flex-col gap-2 [[hidden]]:hidden">
          {t.list.map((e) => (
            <div data-hay={hay(e)}>
              <EventRow ev={e} now={BUILD_TIME} ticketing={ticketing} />
            </div>
          ))}
          <Surface class="p-7 flex flex-col gap-3 [[hidden]]:hidden" data-empty hidden={t.list.length > 0}>
            <h2 class="m-0 text-[24px] font-bold" data-empty-title>
              {t.k === 'upcoming' ? 'Nothing scheduled yet.' : 'No past events yet.'}
            </h2>
            <p class="m-0 text-[17px] text-ink-2" data-empty-sub>
              The next meetup is being planned. It is announced on Meetup first.
            </p>
            <div class="flex gap-2.5 flex-wrap">
              <Button variant="white" class="[[hidden]]:hidden" data-clear hidden>
                Clear search
              </Button>
              <Button variant="black" href={SITE.meetupGroupUrl}>
                Follow the group on Meetup
              </Button>
            </div>
          </Surface>
        </div>
      ))
    }
  </div>
</BaseLayout>

<script>
  type Tab = 'upcoming' | 'past';
  const root = document.querySelector<HTMLElement>('[data-events]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const input = root.querySelector<HTMLInputElement>('[data-q]')!;
    const params = new URLSearchParams(location.search);
    let tab: Tab = params.get('tab') === 'past' ? 'past' : 'upcoming';
    let q = params.get('q') ?? params.get('search') ?? '';
    input.value = q;

    const syncUrl = () => {
      const u = new URL(location.href);
      u.searchParams.delete('search');
      if (tab === 'past') u.searchParams.set('tab', 'past');
      else u.searchParams.delete('tab');
      if (q) u.searchParams.set('q', q);
      else u.searchParams.delete('q');
      history.replaceState(history.state, '', u.pathname + u.search + u.hash);
    };

    const render = () => {
      const needle = q.trim().toLowerCase();
      for (const t of tabs) {
        const on = t.dataset.tab === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      }
      for (const p of panels) {
        p.hidden = p.dataset.panel !== tab;
        let shown = 0;
        for (const row of p.querySelectorAll<HTMLElement>('[data-hay]')) {
          const match = !needle || (row.dataset.hay ?? '').includes(needle);
          row.hidden = !match;
          if (match) shown++;
        }
        const empty = p.querySelector<HTMLElement>('[data-empty]')!;
        empty.hidden = shown > 0;
        empty.querySelector('[data-empty-title]')!.textContent = needle ? `No events match “${q.trim()}”.` : p.dataset.panel === 'upcoming' ? 'Nothing scheduled yet.' : 'No past events yet.';
        empty.querySelector('[data-empty-sub]')!.textContent = needle ? 'Try a speaker name or a topic, or clear the search.' : 'The next meetup is being planned. It is announced on Meetup first.';
        empty.querySelector<HTMLElement>('[data-clear]')!.hidden = !needle;
      }
    };

    const select = (next: Tab, focus = false) => {
      tab = next;
      syncUrl();
      render();
      if (focus) tabs.find((t) => t.dataset.tab === next)?.focus();
    };

    for (const t of tabs) {
      t.addEventListener('click', () => select(t.dataset.tab as Tab));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight' && e.key !== 'Home' && e.key !== 'End') return;
        e.preventDefault();
        const i = tabs.indexOf(t);
        const j = e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : (i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;
        select(tabs[j]!.dataset.tab as Tab, true);
      });
    }
    input.addEventListener('input', () => {
      q = input.value;
      syncUrl();
      render();
    });
    for (const b of root.querySelectorAll<HTMLButtonElement>('[data-clear]')) {
      b.addEventListener('click', () => {
        q = '';
        input.value = '';
        syncUrl();
        render();
        input.focus();
      });
    }
    render();
  }
</script>
