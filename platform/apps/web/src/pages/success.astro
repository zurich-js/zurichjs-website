---
/**
 * Where Stripe Checkout returns after a donation (`?type=donation`) or a
 * pro-meetup ticket (`?type=ticket&event=<slug>&session_id=cs_...`). Static
 * and noindex; the island reads the query and checks ticket payments.
 */
import PageOpening from '~/components/layout/PageOpening.astro';
import CheckoutResult from '~/components/islands/checkout/CheckoutResult';
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="Thank you" description="Confirmation after paying for a ZurichJS meetup ticket or making a donation through Stripe Checkout." noindex>
  <PageOpening slot="opening" title="Thank you" compact />
  <div class="px-gut pt-[clamp(40px,5vw,72px)] pb-[clamp(64px,8vw,112px)]">
    <CheckoutResult client:load />
  </div>
</BaseLayout>
