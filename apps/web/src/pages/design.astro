---
/**
 * Design system gallery: every @zurichjs/design component in every variant, on black and on
 * white. Noindex, not in the sitemap or llms.txt, linked from nowhere. Rules: docs/design-system.md.
 * Rendered from fixtures, so it looks the same whatever content Sanity has.
 */
import type { Event, Speaker } from '@zurichjs/events';
import { breakpoints, colors, gutter, radii, spacing, text } from '@zurichjs/design/theme';
import { cx, type ButtonVariant, type MonogramTone, type TagTone } from '@zurichjs/design/recipes';
import AutoGrid from '@zurichjs/design/components/AutoGrid.astro';
import Button from '@zurichjs/design/components/Button.astro';
import Card from '@zurichjs/design/components/Card.astro';
import ChoiceCard from '@zurichjs/design/components/ChoiceCard.astro';
import ConferenceModule from '@zurichjs/design/components/ConferenceModule.astro';
import EventRow from '@zurichjs/design/components/EventRow.astro';
import Facts from '@zurichjs/design/components/Facts.astro';
import FilterChip from '@zurichjs/design/components/FilterChip.astro';
import LogoRow from '@zurichjs/design/components/LogoRow.astro';
import LogoWall from '@zurichjs/design/components/LogoWall.astro';
import Monogram from '@zurichjs/design/components/Monogram.astro';
import Notice from '@zurichjs/design/components/Notice.astro';
import PageOpening from '@zurichjs/design/components/PageOpening.astro';
import ProofSentence from '@zurichjs/design/components/ProofSentence.astro';
import Section from '@zurichjs/design/components/Section.astro';
import SegmentedControl from '@zurichjs/design/components/SegmentedControl.astro';
import SpeakCta from '@zurichjs/design/components/SpeakCta.astro';
import SpeakerCard from '@zurichjs/design/components/SpeakerCard.astro';
import Tag from '@zurichjs/design/components/Tag.astro';
import TagLink from '@zurichjs/design/components/TagLink.astro';
import TalkRow from '@zurichjs/design/components/TalkRow.astro';
import Text from '@zurichjs/design/components/Text.astro';
import IslandsDemo from '~/components/islands/design/IslandsDemo';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { content, ticketing } from '~/lib/content';

const { award, rating, conference, partners } = await content();

const VARIANTS: ButtonVariant[] = ['primary', 'secondary', 'cta', 'plain'];
const TAG_TONES: TagTone[] = ['grey', 'white', 'black'];
const SURFACES = ['outline', 'filled', 'plain'] as const;
const MONO_TONES: MonogramTone[] = ['grey', 'white', 'blue'];
/** Icon paths on a 24 by 24 grid. */
const PLUS = 'M12 5v14M5 12h14';

// One fixture event, shown in every state by changing its status and the reference clock.
const NOW = new Date('2026-11-01T12:00:00+01:00');
const base: Event = {
  id: 'design-demo',
  slug: 'design-demo',
  title: 'ZurichJS November: Signals, servers and the edge',
  status: 'scheduled',
  startsAt: '2026-11-19T18:00:00+01:00',
  endsAt: '2026-11-19T21:30:00+01:00',
  venue: { name: 'Example office', street: 'Bahnhofstrasse 1', zip: '8001', city: 'Zurich' },
  meetupUrl: 'https://www.meetup.com/zurich-js/',
  description: 'Two talks and a lightning talk.',
  agenda: [
    { time: '18:45', kind: 'talk', title: 'Signals', talk: { speakerIds: ['ada'], title: 'Signals', format: 'talk', durationMin: 25 } },
    { time: '19:20', kind: 'talk', title: 'Edge', talk: { speakerIds: ['grace'], title: 'Edge', format: 'talk', durationMin: 25 } },
  ],
  practical: [],
  photos: [],
};
const STATES: { label: string; ev: Event; now: Date }[] = [
  { label: 'Open', ev: base, now: NOW },
  { label: 'RSVP soon', ev: { ...base, status: 'rsvp-soon' }, now: NOW },
  { label: 'Full', ev: { ...base, status: 'full' }, now: NOW },
  { label: 'To be confirmed', ev: { ...base, status: 'tbc', startsAt: undefined, dateText: 'December 2026' }, now: NOW },
  { label: 'Postponed', ev: { ...base, status: 'postponed' }, now: NOW },
  { label: 'Cancelled', ev: { ...base, status: 'cancelled' }, now: NOW },
  { label: 'Today (live)', ev: base, now: new Date('2026-11-19T19:00:00+01:00') },
  { label: 'Past', ev: base, now: new Date('2026-12-01T12:00:00+01:00') },
];

const speaker: Speaker = {
  id: 'ada',
  name: 'Ada Example',
  role: 'Frontend engineer',
  company: 'Example AG',
  initials: 'AE',
  bio: 'Builds design systems.',
  topics: ['Signals'],
  tagline: 'Builds design systems.',
  links: [],
  talks: [{ title: 'Signals', format: 'Talk', tags: ['Signals'], eventSlugs: ['design-demo'] }],
};

const swatch = (c: string) => `background:${c}`;
/** The nine type roles, each with its class written out so Tailwind generates it. Headings bold, text regular. */
const TYPE: { role: string; cls: string; bold: boolean }[] = [
  { role: 'display', cls: 'text-display', bold: true },
  { role: 'title', cls: 'text-title', bold: true },
  { role: 'section', cls: 'text-section', bold: true },
  { role: 'subsection', cls: 'text-subsection', bold: true },
  { role: 'card-title', cls: 'text-card-title', bold: true },
  { role: 'lead', cls: 'text-lead', bold: false },
  { role: 'body', cls: 'text-body', bold: false },
  { role: 'compact', cls: 'text-compact', bold: false },
  { role: 'meta', cls: 'text-meta', bold: false },
];
---

<BaseLayout title="Design system" description="The ZurichJS design system: tokens, components and islands in every variant, for people working on the site." noindex>
  <PageOpening
    slot="opening"
    title="Design system"
    sub="Every component in @zurichjs/design, in every variant. Rules are in docs/design-system.md."
    crumb={{ label: 'Home', href: '/', here: 'Design system' }}
    pills={[{ text: 'Astro 7' }, { text: 'Tailwind 4' }, { text: 'Noindex' }]}
  />

  <div class="flex flex-col gap-section py-section">
    <Section id="d-colour" title="Colour">
      <Fragment slot="sub">#F1E271 is the only accent. Blue is for focus rings and the logo.</Fragment>
      <ul class="list-none m-0 p-0 grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
        {
          Object.entries(colors).map(([name, value]) => (
            <li class="flex flex-col gap-2">
              <span class={cx('block h-20 rounded-card', value === colors.white && 'border border-grey-frame')} style={swatch(value)} />
              <span class="text-compact font-bold">{name}</span>
              <code class="text-meta text-grey-text">{value}</code>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="d-type" title="Type">
      <Fragment slot="sub">Figtree, variable 300–900. Nine roles, each a size with its line height: pages pick a role, never a pixel value.</Fragment>
      <ul class="list-none m-0 p-0 flex flex-col gap-5">
        {
          TYPE.map(({ role, cls, bold }) => (
            <li class="flex flex-col gap-1">
              <code class="text-meta text-grey-text">
                {cls} · {text[role]?.size} / {text[role]?.lineHeight}
              </code>
              <span class={cx(cls, bold && 'font-bold')}>JavaScript in Zurich</span>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="d-shape" title="Space, radius, breakpoint and gutter">
      <ul class="list-none m-0 p-0 grid gap-2 grid-cols-auto-sm">
        {
          Object.entries(spacing).map(([k, v]) => (
            <li class="text-compact">
              <code class="font-bold">{k}</code> <code class="text-grey-text">{v}</code>
            </li>
          ))
        }
      </ul>
      <div class="grid gap-4 md:grid-cols-3">
        <div class="bg-grey rounded-pill px-6 py-4 font-bold">pill · {radii.pill}</div>
        <div class="bg-grey rounded-card px-6 py-4 font-bold">card · {radii.card}</div>
        <div class="bg-grey rounded-tag px-6 py-4 font-bold">tag · {radii.tag}</div>
      </div>
      <Text class="max-w-reading">
        One layout breakpoint at <code>{breakpoints.md}</code> (<code>md:</code>); <code>lg:</code> ({breakpoints.lg}) only for wide grids. The side gutter is {gutter.mobile} on phones and {gutter.desktop} from the breakpoint, centring
        content in a {gutter.column} column.
      </Text>
    </Section>

    <Section id="d-button" title="Button">
      <Fragment slot="sub">Four variants, one height (48px). An icon before or after the text, or alone. One yellow (cta) per view.</Fragment>
      {
        VARIANTS.map((v) => (
          <div class="flex flex-wrap gap-3 items-center">
            <Button variant={v} href="#d-button">
              {v}
            </Button>
            <Button variant={v} icon={PLUS}>
              {`${v} with an icon`}
            </Button>
            <Button variant={v} icon={PLUS} iconAt="end">
              Icon after
            </Button>
            <Button variant={v} icon={PLUS} label={`Add (${v})`} />
          </div>
        ))
      }
      <div class="on-black bg-black rounded-block p-card-lg flex flex-wrap gap-3">
        <Button variant="cta" href="#d-button">cta on black</Button>
        <Button variant="primary" inverse href="#d-button">primary inverse</Button>
        <Button variant="secondary" inverse href="https://www.meetup.com/zurich-js/">secondary inverse, external</Button>
      </div>
      <SegmentedControl name="d-cycle" legend="Billing" options={[{ value: 'yearly', label: 'Yearly' }, { value: 'quarterly', label: 'Quarterly' }]} />
    </Section>

    <Section id="d-tags" title="Tags and chips">
      <Fragment slot="sub">A tag is read, not pressed: 6px corners. A tag that links has a hover. A filter chip is a control: 44px, a pill.</Fragment>
      {
        TAG_TONES.map((tone) => (
          <div class={cx('flex flex-wrap gap-2 p-card-sm rounded-card', tone === 'white' && 'bg-grey')}>
            <Tag tone={tone}>{`${tone} · sm`}</Tag>
            <Tag tone={tone} size="md">{`${tone} · md`}</Tag>
          </div>
        ))
      }
      <div class="flex flex-wrap gap-2">
        <TagLink href="#d-tags">TagLink</TagLink>
        <TagLink href="#d-tags" size="md">TagLink md</TagLink>
      </div>
      <div class="flex flex-wrap gap-2">
        <FilterChip href="#d-tags" selected>All</FilterChip>
        <FilterChip href="#d-tags" count={12}>Frontend</FilterChip>
      </div>
    </Section>

    <Section id="d-cards" title="Cards">
      <Fragment slot="sub">One card: a surface (outline, filled, plain, white) and a behaviour (static, link, disclosure, action). The signifier sits on the title's first line.</Fragment>
      {
        SURFACES.map((surface) => (
          <AutoGrid min="sm">
            <Card surface={surface} title={`${surface} · static`}>
              <Facts slot="facts" items={[{ label: 'Time', value: '19:00', hideLabel: true, strong: true }, { label: 'Speaker', value: 'Ada Example' }]} />
              <Text size="compact">Nothing to do: no signifier.</Text>
            </Card>
            <Card surface={surface} title={`${surface} · link`} href="#d-cards">
              <Text size="compact">The whole card is one link.</Text>
            </Card>
            <Card surface={surface} title={`${surface} · disclosure`} disclosure>
              <Text size="compact">Opens in place.</Text>
            </Card>
            <Card surface={surface} title={`${surface} · action`}>
              <Text size="compact">The buttons are the signifier.</Text>
              <Button slot="footer" variant="secondary">
                Action
              </Button>
            </Card>
          </AutoGrid>
        ))
      }
      <div class="on-black bg-black rounded-block p-card-lg">
        <Card surface="white" title="white · link, on black" href="#d-cards">
          <Text size="compact">For cards on black or grey.</Text>
        </Card>
      </div>
      <AutoGrid min="md">
        <ChoiceCard name="d-choice" value="a" title="ChoiceCard, chosen" checked>
          <Text size="compact">A native radio: arrow keys move the choice.</Text>
        </ChoiceCard>
        <ChoiceCard name="d-choice" value="b" title="Another choice">
          <Text size="compact">The dot fills yellow when chosen.</Text>
        </ChoiceCard>
      </AutoGrid>
      <AutoGrid min="md">
        <Notice title="A note">Important, but not a result.</Notice>
        <Notice tone="success" title="Thanks, we got it">Green only for success.</Notice>
        <Notice tone="danger" title="That did not send">Red only for errors.</Notice>
      </AutoGrid>
    </Section>

    <Section id="d-mono" title="Monogram">
      <div class="grid gap-4 grid-cols-2 md:grid-cols-4 items-start">
        {MONO_TONES.map((tone) => <Monogram initials="ZJ" tone={tone} size="tile" label={`${tone} tile`} />)}
        <Monogram initials="AE" size="portrait" />
      </div>
      <div class="flex gap-4 items-center">
        {MONO_TONES.map((tone) => <Monogram initials="AE" tone={tone} size="avatar" class="size-control" />)}
      </div>
    </Section>

    <Section id="d-events" title="EventRow in every state">
      <Fragment slot="sub">State comes from the editorial status and the clock (@zurichjs/events).</Fragment>
      <ul class="list-none m-0 p-0 flex flex-col gap-4">
        {
          STATES.map((s) => (
            <li class="flex flex-col gap-2">
              <code class="text-meta text-grey-text">{s.label}</code>
              <EventRow ev={s.ev} now={s.now} ticketing={ticketing} />
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="d-talks" title="TalkRow and SpeakerCard">
      <TalkRow t={{ title: 'Signals without the hype', speakers: [speaker], date: 'Sep 2026', format: 'Talk', href: '#d-talks' }} />
      <div class="grid gap-4 grid-cols-2 md:grid-cols-4">
        <SpeakerCard speaker={speaker} meta="1 talk" />
        <SpeakerCard speaker={{ ...speaker, id: 'grace', name: 'Grace Example', initials: 'GE' }} meta="2 talks" />
      </div>
    </Section>

    <Section id="d-proof" title="ProofSentence and logos">
      <Fragment slot="sub">Rating and award in one sentence. Logo walls: grey cells, black logos, colour on hover. Inline logos keep their colours.</Fragment>
      <div class="on-black bg-black text-white rounded-block p-card-lg"><ProofSentence rating={rating} award={award} /></div>
      <LogoWall partners={partners.filter((p) => !p.delisted).slice(0, 6)} label="Example logo wall" />
      <LogoRow items={partners.filter((p) => !p.delisted).slice(0, 3).map((partner) => ({ partner, caption: partner.name }))} />
    </Section>

    <Section id="d-islands" title="Islands (Preact)">
      <Fragment slot="sub">StarRating, fields with hint and error, Button and Modal.</Fragment>
      <IslandsDemo client:visible />
    </Section>

    <ConferenceModule conference={conference} placement="design" />
    <div class="px-gut"><SpeakCta /></div>
  </div>
</BaseLayout>

<style>
  /* Token values in Figtree, not a system monospace, so the gallery renders the same on every machine (visual baselines). */
  code {
    font-family: var(--font-sans);
    font-variant-numeric: tabular-nums;
  }
</style>
