---
/** The visible FAQ. Pass the same array to faqSchema() so the FAQPage JSON-LD matches it word for word. */
import SectionHeading from '../SectionHeading.astro';
import Card from '../Card.astro';

interface Props {
  faqs: { question: string; answer: string }[];
}
const { faqs } = Astro.props;
---

<section aria-labelledby="h-faq" class="px-gut flex flex-col gap-7">
  <SectionHeading id="h-faq">Frequently asked questions</SectionHeading>
  <div class="flex flex-col gap-3 max-w-wide">
    {
      faqs.map((f) => (
        <Card surface="filled" title={f.question}>
          <p class="m-0 text-body text-ink-2 text-pretty">{f.answer}</p>
        </Card>
      ))
    }
  </div>
</section>
