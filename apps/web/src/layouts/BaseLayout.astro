---
/**
 * Every page: <head> with the full SEO and LLM surface (@zurichjs/seo), the
 * black opening (header + slot "opening"), white content, black footer.
 */
import { buildMeta, type MetaInput } from '@zurichjs/seo';
import Footer from '@zurichjs/design/components/Footer.astro';
import Header from '@zurichjs/design/components/Header.astro';
import { Font } from 'astro:assets';
import { PREVIEW, SITE, content } from '~/lib/content';
import { cardForPath } from '~/lib/og';
import '~/styles/global.css';

type Props = Omit<MetaInput, 'path' | 'title'> & {
  /** Page name; becomes "<title> · ZurichJS". Use fullTitle to set the whole <title>. */
  title: string;
  fullTitle?: string;
  path?: string;
  jsonLd?: (Record<string, unknown> | null)[];
};

// build.format 'file' renders /events/x as events/x.html; the public URL has no extension.
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const { title, fullTitle, path = cleanPath, jsonLd = [], ...meta } = Astro.props;
const docTitle = fullTitle ?? (title === 'ZurichJS' ? 'ZurichJS · JavaScript meetups in Zurich' : `${title} · ZurichJS`);
// Draft preview builds are never indexed, whatever the page says.
// Every page shares a generated card: its own, or the policies or default card (lib/og.ts).
const pageCard = cardForPath(path);
const image = meta.image ?? `/og/${pageCard.name}.png`;
const imageAlt = meta.imageAlt ?? (meta.image ? undefined : pageCard.title === 'ZurichJS' ? pageCard.title : `${pageCard.title} · ZurichJS`);
// Deploy previews point share images at themselves; production and CI builds use zurichjs.com.
const assetOrigin = process.env.CONTEXT && process.env.CONTEXT !== 'production' ? process.env.DEPLOY_PRIME_URL : undefined;
const head = buildMeta({ ...meta, image, imageAlt, assetOrigin, noindex: meta.noindex || PREVIEW, title: docTitle, path });
const c = await content();
// NEXT_PUBLIC_* are the production site's existing variable names.
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY ?? process.env.PUBLIC_POSTHOG_KEY ?? process.env.NEXT_PUBLIC_POSTHOG_KEY;
const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST ?? process.env.PUBLIC_POSTHOG_HOST ?? process.env.NEXT_PUBLIC_POSTHOG_HOST ?? 'https://eu.i.posthog.com';
const SOCIAL = [
  { kind: 'meetup', label: 'Meetup', href: SITE.meetupGroupUrl },
  { kind: 'linkedin', label: 'LinkedIn', href: SITE.linkedinUrl },
  { kind: 'instagram', label: 'Instagram', href: SITE.instagramUrl },
  { kind: 'bluesky', label: 'Bluesky', href: SITE.blueskyUrl },
  { kind: 'x', label: 'X', href: SITE.xUrl },
] as const;
const schemas = jsonLd.filter((j): j is Record<string, unknown> => !!j);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{head.title}</title>
    <link rel="canonical" href={head.canonical} />
    {head.meta.map((m) => <meta name={m.name} property={m.property} http-equiv={m.httpEquiv} content={m.content} />)}
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/logo-square.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo-square.png" />
    <Font cssVariable="--font-figtree" preload />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
    <link rel="sitemap" href="/sitemap.xml" />
    {schemas.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(schemas.length === 1 ? schemas[0] : schemas)} />}
    {c.source === 'sample' && <meta name="zurichjs-content" content="sample" />}
    {
      posthogKey && (
        <script is:inline define:vars={{ posthogKey, posthogHost }}>
          window.addEventListener('load', () => {
            const s = document.createElement('script');
            s.src = posthogHost.replace('.i.posthog.com', '-assets.i.posthog.com') + '/static/array.js';
            s.async = true;
            s.onload = () => window.posthog?.init(posthogKey, { api_host: posthogHost, person_profiles: 'identified_only' });
            document.head.appendChild(s);
          });
        </script>
      )
    }
  </head>
  <body class="min-h-screen flex flex-col bg-white text-black">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-3 focus:left-3 focus:bg-yellow focus:text-black focus:px-4 focus:py-2 focus:rounded-pill focus:font-bold">Skip to content</a>
    {
      PREVIEW && (
        <div role="status" class="bg-white text-black text-center text-meta font-bold px-gut py-2">
          Draft preview: unpublished changes from Sanity. Not the live site.
        </div>
      )
    }
    <Header social={SOCIAL} />
    <main id="main" class="flex-1">
      {/* The opening starts at the top of the page, under the header (which overlaps it), and is padded by the header's height. */}
      <div class="on-black bg-black text-white pt-header">
        <slot name="opening" />
      </div>
      <slot />
    </main>
    <Footer site={SITE} confState={c.conference.state} />
    <script>
      // One delegated listener for data-track="<event>" elements (see lib/analytics.ts).
      document.addEventListener('click', (e) => {
        const el = (e.target as Element | null)?.closest<HTMLElement>('[data-track]');
        if (!el) return;
        const props: Record<string, string> = {};
        for (const [k, v] of Object.entries(el.dataset)) if (k.startsWith('track') && k !== 'track' && v) props[k.slice(5).toLowerCase()] = v;
        (window as unknown as { posthog?: { capture: (n: string, p: object) => void } }).posthog?.capture(el.dataset.track!, props);
      });
    </script>
  </body>
</html>
