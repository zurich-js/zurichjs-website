---
/** The sponsor portal: sign in by email link, start or manage a company's sponsorship (docs/v2/SPONSORSHIP.md). Private, not indexed. */
import PageOpening from '@zurichjs/design/components/PageOpening.astro';
import SponsorAccount from '~/components/islands/SponsorAccount';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/lib/content';
---

<BaseLayout title="Your sponsorship" description="Start or manage your company's sponsorship of ZurichJS." noindex>
  <PageOpening slot="opening" title="Your sponsorship" sub="Manage your company's sponsorship of ZurichJS: the plan, payment, details, logo and colleagues." />
  <div class="px-gut pt-10 pb-16 md:pt-16 md:pb-28">
    <SponsorAccount client:load contactEmail={SITE.email} />
  </div>
</BaseLayout>
