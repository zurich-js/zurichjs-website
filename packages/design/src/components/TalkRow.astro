---
/**
 * One past talk, one row: the title is the strongest element (Bogdan's review). A grey card on phones,
 * as the conference's talk cards are; a white row with a hover highlight and an arrow on desktop.
 */
import type { Speaker } from '@zurichjs/events';
import { monogramClass } from '../recipes';
import { avatarSrc } from '../images';

export interface TalkRowData {
  title: string;
  speakers: Speaker[];
  date: string; // "Sep 2026"
  format: string; // "Talk" | "Lightning talk"
  href: string;
}
interface Props {
  t: TalkRowData;
}
const { t } = Astro.props;
const lead = t.speakers[0];
---

<a
  href={t.href}
  class="no-underline text-black grid grid-cols-[40px_minmax(0,1fr)] md:grid-cols-[52px_minmax(0,1fr)_auto] gap-3.5 md:gap-[18px] items-start p-4 md:py-4 md:px-[18px] rounded-[20px] bg-grey-soft md:bg-white md:hover:bg-grey md:mx-[-18px] box-border w-full md:w-[calc(100%+36px)]"
>
  {
    lead?.photo ? (
      <img src={avatarSrc(lead.photo.src, 52)} alt="" width="52" height="52" loading="lazy" decoding="async" class="w-10 h-10 md:w-[52px] md:h-[52px] rounded-full object-cover bg-grey" />
    ) : (
      <span aria-hidden="true" class={monogramClass('grey', 'avatar', 'w-10 h-10 md:w-[52px] md:h-[52px] bg-white! md:bg-grey!')}>
        {lead?.initials ?? '?'}
      </span>
    )
  }
  <span class="flex flex-col gap-1.5 min-w-0">
    <span class="text-[19px] md:text-[23px] font-bold leading-[1.25] text-pretty wrap-anywhere">{t.title}</span>
    <span class="text-[15px] md:text-[16px] leading-[1.4] text-ink-2">{t.speakers.map((s) => s.name).join(', ')} · {t.date} · {t.format}</span>
  </span>
  <span aria-hidden="true" class="hidden md:flex w-10 h-10 rounded-pill bg-grey items-center justify-center font-bold self-center">→</span>
</a>
