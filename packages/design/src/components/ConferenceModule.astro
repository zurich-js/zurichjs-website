---
/** The one contextual conference module. Copy follows the conference lifecycle; no invented dates or prices. */
import Button from './Button.astro';
import Tag from './Tag.astro';
import { confLink, trackAttrs } from '../analytics';
import type { ConferenceCopy, ConferenceState } from '@zurichjs/events';

interface Props {
  conference: { state: ConferenceState; copy: ConferenceCopy };
  /** Analytics placement, e.g. "home". */
  placement?: string;
  /** A development preview, not shown on the public site: says so above the heading. */
  preview?: boolean;
}
const { conference, placement = 'home', preview = false } = Astro.props;
---

<section aria-labelledby="h-conf-module" class="on-black mx-gut bg-ink text-white rounded-block p-[clamp(28px,4.4vw,64px)] flex flex-col gap-6 max-w-[960px]">
  {
    preview && (
      <Tag tone="white" class="self-start font-bold">
        Preview only: not shown on the public site
      </Tag>
    )
  }
  <div class="flex flex-col gap-3">
    <h2 id="h-conf-module" class="m-0 flex flex-col gap-3">
      <img src="/images/logo/wordmark-conf-white.svg" alt="ZurichJS Conf" width="300" height="40" loading="lazy" class="h-[clamp(24px,2.4vw,30px)] w-auto max-w-full self-start" />
      <span class="text-subsection font-bold text-balance">{conference.copy.headline}</span>
    </h2>
    <p class="m-0 text-body text-grey max-w-form text-pretty">{conference.copy.body}</p>
  </div>
  <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
    <Button href={confLink('/', placement)} variant="cta" {...trackAttrs('conf_outbound_click', { placement, confstate: conference.state })}>{conference.copy.cta}</Button>
    <span class="text-compact text-grey-mid">conf.zurichjs.com</span>
  </div>
</section>
