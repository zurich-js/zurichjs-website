---
/**
 * The button: four variants and one height (48px, like form fields). An icon goes before or after the
 * text, or alone (round; `label` is then required). Links to other sites open in a new tab.
 * Variants and colours: recipes.ts (buttonClass). The Preact twin is islands/Button.tsx.
 */
import { buttonClass, opensNewTab, type ButtonVariant } from '../recipes';
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'class' | 'type'> & {
  href?: string;
  variant?: ButtonVariant;
  /** On a black surface: the same roles, mirrored. */
  inverse?: boolean;
  /** Full width on phones, its own width from 800px. */
  grow?: boolean;
  /** An SVG path on a 24 by 24 viewBox. */
  icon?: string;
  iconAt?: 'start' | 'end';
  /** The accessible name when there is no text. */
  label?: string;
  class?: string;
  external?: boolean;
  type?: 'button' | 'submit';
};
const { href, variant = 'primary', inverse = false, grow = false, icon, iconAt = 'start', label, class: extra, external, type = 'button', ...rest } = Astro.props;
const iconOnly = !Astro.slots.has('default');
const cls = buttonClass({ variant, inverse, iconOnly, grow }, extra);
const ext = href ? (external ?? opensNewTab(href)) : false;
const a11y = iconOnly ? { 'aria-label': label } : {};
const Tag = href ? 'a' : 'button';
const attrs = href ? { href, ...(ext ? { target: '_blank', rel: 'noopener' } : {}) } : { type };
---

<Tag class={cls} {...attrs} {...a11y} {...rest}>
  {
    icon && iconAt === 'start' && (
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 flex-none" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d={icon} />
      </svg>
    )
  }
  <slot />
  {
    icon && iconAt === 'end' && (
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 flex-none" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d={icon} />
      </svg>
    )
  }
</Tag>
