---
/**
 * Volunteer with ZurichJS. Laid out like conf.zurichjs.com/volunteer (owner, 3rd November 2026):
 * what you get, where you could help, how much time, how it works, then the form.
 * Only what is true for the meetups: no conference perks.
 */
import PageOpening from '@zurichjs/design/components/PageOpening.astro';
import Photo from '@zurichjs/design/components/Photo.astro';
import Card from '@zurichjs/design/components/Card.astro';
import AutoGrid from '@zurichjs/design/components/AutoGrid.astro';
import Tag from '@zurichjs/design/components/Tag.astro';
import Button from '@zurichjs/design/components/Button.astro';
import VolunteerForm from '~/components/islands/forms/VolunteerForm';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { content, nextMeetupHref } from '~/lib/content';
import { PAGE_PHOTOS } from '~/lib/photos';
import { VOLUNTEER_AVAILABILITY } from '@zurichjs/forms/client';

const nextHref = await nextMeetupHref();
const { award } = await content();

// Production's /cfv wording (origin/main src/pages/cfv.tsx), shortened.
const GAINS = [
  {
    h: 'Professional growth',
    d: 'Develop new skills in tech, marketing or event management, build your portfolio with real projects, and gain leadership experience in community initiatives.',
  },
  { h: 'Networking', d: 'Connect with tech leaders, build relationships with local tech companies and become part of a supportive community of peers.' },
  { h: 'Community impact', d: 'Help shape the local tech ecosystem, contribute to educational initiatives and create opportunities for others in tech.' },
];
// The areas in the form, each with one plain line.
const ROLES = [
  ['Event organisation', 'Welcome people on the night, set up and help the evening run.'],
  ['Community management', 'Look after the Meetup group, Slack and the people in them.'],
  ['Partnership and speaker outreach', 'Find speakers, hosts and sponsors, and keep in touch with them.'],
  ['Social media', 'Announce meetups and share what happened.'],
  ['Content creation', 'Write recaps, newsletters and posts.'],
  ['Photography and video', 'Capture the evenings for the archive.'],
  ['Graphic design', 'Slides, visuals and the look of our events.'],
  ['Platform development', 'Work on this website and the tools behind it.'],
];
const STEPS = [
  ['Apply', 'Tell us about you, how you’d like to help and how much time you have.'],
  ['We reply within 7 days', 'Someone from the organising team emails you to talk about next steps.'],
  ['Start helping', 'At the next meetup, or behind the scenes, at your own pace.'],
];
const h2 = 'm-0 text-subsection font-bold';
---

<BaseLayout
  title="Volunteer With Us"
  description="Volunteer with ZurichJS on meetup nights, with photos and video, or with the website. Help us grow the JavaScript community in Zurich."
  keywords={['volunteer Zurich', 'ZurichJS volunteer', 'JavaScript community Zurich', 'tech meetup volunteer']}
>
  <PageOpening
    slot="opening"
    title="Volunteer with us"
    sub="ZurichJS is community-driven and run entirely by volunteers. Help with the evenings, outreach, design, content or the website."
  >
    <Button href="#apply" variant="cta" class="self-start">Apply to volunteer</Button>
  </PageOpening>
  <div class="px-gut pt-[clamp(56px,7vw,104px)] pb-[clamp(64px,8vw,112px)] flex flex-col gap-[clamp(48px,6vw,88px)]">
    <Card surface="filled" padding="lg" title="You’d be joining an award-winning community" level="h2">
      <p class="m-0 text-body max-w-reading">
        ZurichJS won the JavaScript Open Source Award for {award.category} in 2026. We’re a registered nonprofit, and every volunteer helps make that happen.
      </p>
      <Button slot="footer" href="https://conf.zurichjs.com/blog/how-zurichjs-got-here" variant="primary" external>Read the full story</Button>
    </Card>

    <section aria-labelledby="h-gain" class="flex flex-col gap-[18px]">
      <h2 id="h-gain" class={h2}>What you get out of it</h2>
      <AutoGrid min="md">
        {
          GAINS.map((g) => (
            <Card title={g.h}>
              <p class="m-0 text-body text-ink-2">{g.d}</p>
            </Card>
          ))
        }
      </AutoGrid>
    </section>

    <section aria-labelledby="h-roles" class="flex flex-col gap-[18px]">
      <div class="flex flex-col gap-2 max-w-[760px]">
        <h2 id="h-roles" class={h2}>Where you could help</h2>
        <p class="m-0 text-body text-ink-2">Pick one or more in the form. We match you by your experience, your time and what the next meetups need.</p>
      </div>
      <AutoGrid as="ul" min="sm" gap="sm">
        {
          ROLES.map(([h, d]) => (
            <Card as="li" padding="sm" title={h} level="p">
              <p class="m-0 text-compact text-ink-2">{d}</p>
            </Card>
          ))
        }
      </AutoGrid>
    </section>

    <section aria-labelledby="h-time" class="flex flex-col gap-[18px]">
      <div class="flex flex-col gap-2 max-w-[760px]">
        <h2 id="h-time" class={h2}>You choose how much time you give</h2>
        <p class="m-0 text-body text-ink-2">
          Volunteering is unpaid: ZurichJS is run by volunteers and can’t offer financial compensation. We try to make it an experience that helps you grow professionally and
          personally.
        </p>
      </div>
      <ul class="m-0 p-0 list-none flex flex-wrap gap-2">
        {Object.values(VOLUNTEER_AVAILABILITY).map((v) => (
          <Tag as="li" size="md">
            {v}
          </Tag>
        ))}
      </ul>
    </section>

    <section aria-labelledby="h-how" class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] gap-[clamp(32px,5vw,72px)] items-center">
      <div class="flex flex-col gap-5">
        <h2 id="h-how" class={h2}>How it works</h2>
        <ol class="m-0 p-0 list-none flex flex-col gap-4">
          {
            STEPS.map(([h, d], i) => (
              <li class="grid grid-cols-[40px_minmax(0,1fr)] gap-3.5 items-start">
                <span class={`w-10 h-10 rounded-full flex items-center justify-center font-bold ${i === 0 ? 'bg-black text-white' : 'bg-grey'}`}>{i + 1}</span>
                <span class="flex flex-col gap-0.5 pt-1.5">
                  <span class="text-body font-bold">{h}</span>
                  <span class="text-body text-ink-2">{d}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
      <Photo photo={PAGE_PHOTOS.team} class="aspect-4/3 w-full" />
    </section>

    <section id="apply" aria-labelledby="h-apply" class="flex flex-col gap-[18px] scroll-mt-6">
      <h2 id="h-apply" class={h2}>Apply to volunteer</h2>
      <VolunteerForm client:load nextHref={nextHref} />
    </section>
  </div>
</BaseLayout>
