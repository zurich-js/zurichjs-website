---
/** A cover-cropped photo with rounded corners. Fills its parent, so give the parent an aspect ratio. */
import type { Photo } from '@zurichjs/events';
import { srcFor, srcsetFor } from '~/lib/images';
import { cx } from '~/lib/ui';

interface Props {
  photo: Photo;
  class?: string;
  /** Above the fold: load eagerly with high priority. */
  priority?: boolean;
  /** The `sizes` attribute: how wide the photo is rendered. */
  sizes?: string;
}
const { photo, class: extra, priority = false, sizes = '(min-width: 800px) 50vw, 100vw' } = Astro.props;
---

<span class={cx('relative block overflow-hidden rounded-card bg-grey', extra)}>
  <img
    src={srcFor(photo.src)}
    srcset={srcsetFor(photo.src)}
    sizes={sizes}
    alt={photo.alt}
    width={photo.width}
    height={photo.height}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover"
    style={{ objectPosition: photo.position ?? 'center' }}
  />
</span>
