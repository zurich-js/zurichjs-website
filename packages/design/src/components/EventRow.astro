---
/**
 * One event in a list: the home hero's next-meetup card (owner, 12th November 2026). A link card with the
 * image flush to its edges on the left (Card mediaLayout="row"): the event's cover (its promotional artwork),
 * else the first photo from the evening, else a grey tile with the date. The title, then one line of facts that
 * leads with the date (date, "RSVP open" while it is, talks, venue). The arrow sits on the title's first line.
 * `dim` (past meetups in a list): the whole card at lower opacity, full again on hover or focus (owner, 12th
 * November 2026). Artwork and text keep their colours.
 */
import { dateParts, dateShort, eventHref, presentEvent, talkCount, type Event, type TicketingProvider } from '@zurichjs/events';
import { srcFor, srcsetFor } from '../images';
import Card from './Card.astro';
import Facts from './Facts.astro';

interface Props {
  ev: Event;
  /** Reference clock (build time). */
  now: Date;
  ticketing?: TicketingProvider;
  /** Lower opacity until hovered or focused (past meetups). */
  dim?: boolean;
}
const { ev, now, ticketing, dim = false } = Astro.props;
const p = presentEvent(ev, { now, ticketing });
const upcoming = p.state !== 'past';
const image = ev.cover ?? ev.photos[0];
const parts = ev.startsAt ? dateParts(ev.startsAt) : { mon: ev.dateText?.slice(0, 3) ?? 'TBC', day: '?', suffix: '', year: ev.dateText?.slice(-4) ?? '' };
const n = talkCount(ev);
// Date, "RSVP open" only while it is (no other status), the number of talks (none when there are none), the venue (owner, 12th November 2026).
const facts = [
  { label: 'Date', value: ev.startsAt ? dateShort(ev.startsAt) : (ev.dateText ?? 'Date to be confirmed'), hideLabel: true, strong: true },
  ...(upcoming && p.stateLabel === 'RSVP open' ? [{ label: 'Status', value: p.stateLabel, hideLabel: true }] : []),
  ...(n > 0 ? [{ label: 'Talks', value: `${n} talk${n === 1 ? '' : 's'}`, hideLabel: true }] : []),
  ...(ev.venue ? [{ label: 'Venue', value: p.venueShort, hideLabel: true }] : []),
];
---

<Card level="h3" mediaLayout="row" title={ev.title} href={eventHref(ev)} dim={dim} linkAttrs={{ 'data-event-row': '', 'data-upcoming': String(upcoming) }}>
  {
    image ? (
      <img slot="media" src={srcFor(image.src)} srcset={srcsetFor(image.src)} sizes="(min-width: 800px) 240px, 33vw" alt="" loading="lazy" decoding="async" />
    ) : (
      <span slot="media">
        <span class="flex items-center justify-center bg-grey text-card-title font-bold">
          {parts.day}
          {parts.suffix} {parts.mon}
        </span>
      </span>
    )
  }
  <Facts slot="facts" items={facts} />
</Card>
