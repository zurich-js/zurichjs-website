---
/**
 * Rating and award in one plain sentence, after the main action. The rating part
 * disappears when the record has no score; the award stays. Never prints the scale.
 */
import type { AwardRecord, RatingRecord } from '@zurichjs/events';

interface Props {
  /** null hides the rating; the award stays. */
  rating: RatingRecord | null;
  award: AwardRecord;
}
const { rating, award } = Astro.props;
---

<p class="m-0 text-[clamp(18px,1.6vw,20px)] leading-[1.6] text-white max-w-[560px] text-pretty">
  {
    rating && (
      <span>
        Rated <b class="text-yellow">{rating.score}</b> on Meetup from{' '}
        <a href={rating.url} target="_blank" rel="noopener" title={`${rating.source}, checked ${rating.checkedAt}`}>
          {rating.count} ratings</a
        >, and{' '}
      </span>
    )
  }
  <span>
    {rating ? 'winner' : 'Winner'} of the <b class="text-yellow">2026 Open Source Award</b> for{' '}
    <a href={award.url} target="_blank" rel="noopener">{award.category}</a>.
  </span>
</p>
