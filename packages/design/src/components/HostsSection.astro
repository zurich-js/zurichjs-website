---
/**
 * The companies behind ZurichJS as logo walls: current sponsors (sized by tier) and hosts and partners in
 * one wall, then everyone who supported us before in a second wall.
 */
import type { Partner } from '@zurichjs/events';
import Heading from './Heading.astro';
import LogoWall from './LogoWall.astro';
import Section from './Section.astro';

interface Props {
  /** Venue hosts and other partners, shown at the standard size. */
  partners: Partner[];
  /** Current sponsors, highest tier first: the tier sets the size of their cell. */
  sponsors?: Partner[];
  /** Everyone who supported ZurichJS before. */
  past?: Partner[];
  heading?: string;
  link?: boolean;
}
const { partners, sponsors = [], past = [], heading = 'Companies who host and support ZurichJS', link = true } = Astro.props;
const current = [...sponsors, ...partners];
---

{
  current.length > 0 && (
    <Section id="h-hosts" title={heading}>
      <div class="flex flex-col gap-3">
        {past.length > 0 && (
          <Heading as="h3" size="card">
            Thank you to everyone supporting us today
          </Heading>
        )}
        <LogoWall partners={current} byTier label="Current hosts and sponsors" />
      </div>
      {past.length > 0 && (
        <div class="flex flex-col gap-3">
          <Heading as="h3" size="card">
            And thank you to everyone who helped us get here
          </Heading>
          <LogoWall partners={past} label="Past supporters" />
        </div>
      )}
      {link && (
        <a href="/partners" class="self-start font-bold text-body underline underline-offset-4">
          Host a meetup or support the community
        </a>
      )}
    </Section>
  )
}
