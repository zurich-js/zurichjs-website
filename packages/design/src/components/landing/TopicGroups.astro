---
/** Grouped lists of topics as tags, one card per group: grey tags on a white card, so they stay visible. */
import AutoGrid from '../AutoGrid.astro';
import Card from '../Card.astro';
import Tag from '../Tag.astro';

interface Props {
  groups: { title: string; items: string[] }[];
  /** Heading level of each group title, to keep the production outline. */
  level?: 'h3' | 'h4';
  /** Narrowest column in px: up to 260 gives the small grid, above it the medium one. */
  min?: number;
}
const { groups, level = 'h4', min = 260 } = Astro.props;
---

<AutoGrid min={min <= 260 ? 'sm' : 'md'} gap="sm">
  {
    groups.map((g) => (
      <Card title={g.title} level={level}>
        <ul class="m-0 p-0 list-none flex flex-wrap gap-2">
          {g.items.map((it) => (
            <Tag as="li" size="md">
              {it}
            </Tag>
          ))}
        </ul>
      </Card>
    ))
  }
</AutoGrid>
