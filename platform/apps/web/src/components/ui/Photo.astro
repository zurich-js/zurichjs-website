---
/** A cover-cropped photo with rounded corners. Fills its parent, so give the parent an aspect ratio. */
import type { Photo } from '@zurichjs/events';
import { cx } from '~/lib/ui';

interface Props {
  photo: Photo;
  class?: string;
  /** Above the fold: load eagerly with high priority. */
  priority?: boolean;
  /** Width hint for Sanity CDN images. */
  width?: number;
}
const { photo, class: extra, priority = false, width = 1200 } = Astro.props;
const src = photo.src.startsWith('https://cdn.sanity.io/') ? `${photo.src}?w=${width}&auto=format&fit=max` : photo.src;
---

<span class={cx('relative block overflow-hidden rounded-card bg-grey', extra)}>
  <img
    src={src}
    alt={photo.alt}
    width={photo.width}
    height={photo.height}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover"
    style={{ objectPosition: photo.position ?? 'center' }}
  />
</span>
