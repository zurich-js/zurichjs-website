{
  "name": "zurichjs-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @zurichjs/web dev",
    "build": "pnpm --filter @zurichjs/web build",
    "preview": "pnpm --filter @zurichjs/web preview",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "seo:snapshot": "node tools/seo/snapshot.mjs",
    "seo:check": "node tools/seo/compare.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.3",
    "knip": "6.43.0",
    "oxfmt": "0.51.0",
    "oxlint": "1.73.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22.23.1 <23",
    "pnpm": "11.x"
  },
  "packageManager": "pnpm@11.15.1"
}
