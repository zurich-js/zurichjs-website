---
/** Rounded pill button or link. Links to other sites open in a new tab. */
import { buttonClass, isExternal, type ButtonSize, type ButtonVariant } from '../recipes';
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'class' | 'type'> & {
  href?: string;
  variant?: ButtonVariant;
  size?: ButtonSize;
  grow?: boolean;
  class?: string;
  external?: boolean;
  type?: 'button' | 'submit';
};
const { href, variant = 'yellow', size = 'md', grow = false, class: extra, external, type = 'button', ...rest } = Astro.props;
const cls = buttonClass(variant, size, grow, extra);
const ext = href ? (external ?? isExternal(href)) : false;
---

{
  href ? (
    <a href={href} class={cls} {...(ext && !href.startsWith('mailto:') ? { target: '_blank', rel: 'noopener' } : {})} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={cls} {...rest}>
      <slot />
    </button>
  )
}
