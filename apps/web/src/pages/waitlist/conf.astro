---
import PageOpening from '@zurichjs/design/components/PageOpening.astro';
import WaitlistForm from '~/components/islands/forms/WaitlistForm';
import ConferenceModule from '@zurichjs/design/components/ConferenceModule.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { confLink } from '@zurichjs/design/analytics';
import { content } from '~/lib/content';

const { conference } = await content();

const WHAT = [
  ['A focused day of JavaScript', 'One day of talks in Zurich from people who build with JavaScript every day.'],
  ['Made by the community', 'Run by the same volunteers as the ZurichJS meetups, as a non-profit.'],
  ['First to hear', 'The waitlist hears about tickets, speakers and dates as soon as they are public.'],
];
---

<BaseLayout
  title="Conference waitlist"
  fullTitle="ZurichJS Conference Waitlist · JavaScript Conference in Zurich"
  description="Join the ZurichJS Conference waitlist and get an email when tickets, speakers and dates for the next JavaScript conference in Zurich are announced."
  keywords={['ZurichJS Conference', 'JavaScript conference Zurich', 'tech conference Switzerland', 'ZurichJS Conf waitlist']}
>
  <PageOpening
    slot="opening"
    title="ZurichJS Conference waitlist"
    sub="The community’s JavaScript conference in Zurich. Leave your email and we’ll tell you when tickets, speakers and dates are announced."
  />
  <div class="pt-[clamp(56px,7vw,104px)] pb-[clamp(64px,8vw,112px)] flex flex-col gap-[clamp(56px,7vw,96px)]">
    <div class="px-gut grid grid-cols-[repeat(auto-fit,minmax(min(100%,360px),1fr))] gap-[clamp(40px,5vw,80px)] items-start">
      <section aria-labelledby="h-wl" class="flex flex-col gap-[18px]">
        <h2 id="h-wl" class="m-0 text-[clamp(26px,2.8vw,36px)] leading-[1.15] font-bold">Join the waitlist</h2>
        <WaitlistForm client:load />
      </section>
      <section aria-labelledby="h-what" class="flex flex-col gap-[18px]">
        <h2 id="h-what" class="m-0 text-[clamp(26px,2.8vw,36px)] leading-[1.15] font-bold">What to expect</h2>
        {
          WHAT.map(([h, d]) => (
            <div class="flex flex-col gap-1">
              <h3 class="m-0 text-[19px] font-bold">{h}</h3>
              <p class="m-0 text-[17px] leading-[1.55] text-ink-2">{d}</p>
            </div>
          ))
        }
        <p class="m-0 text-[17px] leading-[1.55] text-ink-2">
          Dates, tickets and the programme live on <a href={confLink('/', 'waitlist')} target="_blank" rel="noopener" class="font-bold text-black">conf.zurichjs.com</a>.
        </p>
      </section>
    </div>
    <ConferenceModule conference={conference} placement="waitlist" />
  </div>
</BaseLayout>
