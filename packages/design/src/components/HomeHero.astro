---
/**
 * Black hero on the same surface as the header. Headline, one sentence, the next
 * meetup once (title, date, venue, status, action), then the rating and award,
 * with a three-photo mosaic beside it (after it on phones).
 * A tile can carry a short silent `video` loop: its photo is the poster and first paint,
 * and the loop only plays for visitors who allow motion and aren't saving data.
 */
import { eventHref, presentEvent, type AwardRecord, type Event, type Photo, type RatingRecord, type TicketingProvider } from '@zurichjs/events';
import Button from './Button.astro';
import ProofSentence from './ProofSentence.astro';
import { trackAttrs } from '../analytics';
import { srcFor, srcsetFor } from '../images';
type HeroTile = Photo & { video?: string };
interface Props {
  /** The next meetup, if one is scheduled. */
  next?: Event;
  now: Date;
  ticketing?: TicketingProvider;
  photos: { audience: HeroTile; speaker: HeroTile; conversation: HeroTile };
  rating: RatingRecord | null;
  award: AwardRecord;
  meetupGroupUrl: string;
}
const { next, now, ticketing, photos: PHOTOS, rating, award, meetupGroupUrl } = Astro.props;
const p = next ? presentEvent(next, { now, ticketing }) : null;
const handoff = p && (p.cta.kind === 'rsvp' || p.cta.kind === 'waitlist');
// `sizes` follows the rendered width of a landscape photo covering each tile (the tall tile needs about
// three times its own width), so phones and retina screens get a sharp file.
const mosaic: { photo: HeroTile; cls: string; sizes: string }[] = [
  { photo: PHOTOS.audience, cls: '', sizes: '(min-width: 800px) 31vw, 67vw' },
  { photo: { ...PHOTOS.speaker, position: PHOTOS.speaker.position ?? 'center 25%' }, cls: 'row-span-2', sizes: '(min-width: 800px) 67vw, 140vw' },
  { photo: PHOTOS.conversation, cls: '', sizes: '(min-width: 800px) 31vw, 67vw' },
];
---

<section class="relative px-gut pt-[clamp(24px,5vw,72px)] pb-[clamp(40px,6vw,88px)] grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-[clamp(36px,5vw,72px)] items-center">
  <div class="relative z-1 flex flex-col gap-[clamp(28px,3.4vw,44px)] min-w-0">
    <div class="flex flex-col gap-[18px]">
      <h1 class="m-0 text-[clamp(40px,6.4vw,84px)] leading-[1.05] font-bold text-balance">Shaping the Zurich tech scene.</h1>
      <p class="m-0 text-[clamp(22px,2.4vw,32px)] leading-[1.2] font-bold text-yellow text-balance">JavaScript meets Zurich.</p>
      <p class="m-0 text-[clamp(18px,1.6vw,21px)] leading-normal max-w-[540px] text-pretty">
        Come for the talks. Stay for the people: juniors to CTOs, every framework, and a room full of developers you wouldn’t otherwise meet.
      </p>
    </div>

    {
      next && p ? (
        <div class="flex flex-col gap-4">
          <div class="flex flex-col gap-1.5">
            <div class="text-[17px] font-bold text-yellow">{p.dateLineShort}</div>
            <div class="text-[clamp(22px,2.2vw,28px)] leading-[1.2] font-bold text-pretty">{next.title}</div>
            <div class="text-[17px] leading-normal text-grey-mid">
              {p.venueShort} · Free · {p.stateLabel}
            </div>
          </div>
          <div class="flex flex-wrap gap-3 items-center">
            {p.cta.href && p.cta.kind !== 'next' && (
              <Button href={p.cta.kind === 'feedback' || p.cta.kind === 'buy' ? `${eventHref(next)}${p.cta.href}` : p.cta.href} variant="yellow" {...(handoff ? trackAttrs('rsvp_handoff_click', { eventid: next.id }) : {})}>
                {p.cta.label}
              </Button>
            )}
            <Button href={eventHref(next)} variant="outline-white">
              Event details
            </Button>
          </div>
          {handoff && <div class="text-[15px] text-grey-mid">Opens Meetup in a new tab. Your RSVP is confirmed there.</div>}
        </div>
      ) : (
        <div class="flex flex-col gap-3.5">
          <div class="text-[clamp(22px,2.2vw,28px)] leading-[1.2] font-bold">The next meetup is being planned.</div>
          <div class="text-[17px] leading-normal text-grey-mid">We announce it on Meetup first. Follow the group there, or catch up on past talks.</div>
          <div class="flex flex-wrap gap-3">
            <Button href={meetupGroupUrl} variant="yellow">
              Follow ZurichJS on Meetup
            </Button>
            <Button href="/events?tab=past" variant="outline-white">
              Past events
            </Button>
          </div>
        </div>
      )
    }

    <ProofSentence rating={rating} award={award} />
  </div>

  <div class="grid grid-cols-2 grid-rows-2 gap-[clamp(8px,1vw,12px)] w-full aspect-square md:aspect-[1/1.05]" aria-label="Photos from ZurichJS meetups" role="group">
    {
      mosaic.map(({ photo, cls, sizes }, i) => (
        <span class={`relative block min-h-0 rounded-[20px] overflow-hidden bg-ink ${cls}`}>
          <img src={srcFor(photo.src)} srcset={photo.srcset ?? srcsetFor(photo.src)} sizes={sizes} alt={photo.alt} loading={i < 2 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} decoding="async" class="absolute inset-0 h-full w-full object-cover" style={{ objectPosition: photo.position ?? 'center' }} />
          {photo.video && (
            <video data-hero-video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700" style={{ objectPosition: photo.position ?? 'center' }}>
              <source src={photo.video} type="video/mp4" />
            </video>
          )}
        </span>
      ))
    }
  </div>
</section>

<script>
  // Play the hero loop after the page has loaded, only when motion is welcome and data isn't being saved.
  // Until it plays (or if it never does) the photo underneath shows.
  const start = () => {
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    if (calm || saveData) return;
    for (const v of document.querySelectorAll<HTMLVideoElement>('video[data-hero-video]')) {
      v.addEventListener('playing', () => v.classList.remove('opacity-0'), { once: true });
      v.play().catch(() => {});
    }
  };
  if (document.readyState === 'complete') start();
  else addEventListener('load', start, { once: true });
</script>
