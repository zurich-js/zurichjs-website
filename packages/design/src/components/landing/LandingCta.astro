---
/** Closing call to action of a landing page: heading, one line, two actions (default slot). */
import Heading from '../Heading.astro';

interface Props {
  id: string;
  title: string;
  text: string;
}
const { id, title, text } = Astro.props;
---

<section aria-labelledby={id} class="mx-gut bg-grey rounded-block p-7 md:p-12 lg:p-16 flex flex-col gap-5">
  <Heading id={id} class="max-w-wide">{title}</Heading>
  <p class="m-0 text-lead max-w-reading text-pretty">{text}</p>
  <div class="flex flex-wrap gap-3 pt-1"><slot /></div>
</section>
