---
/**
 * Every page: <head> with the full SEO and LLM surface (@zurichjs/seo), the
 * black opening (header + slot "opening"), white content, black footer.
 */
import { buildMeta, type MetaInput } from '@zurichjs/seo';
import Footer from '~/components/layout/Footer.astro';
import Header from '~/components/layout/Header.astro';
import { content, nextMeetupHref } from '~/lib/content';
import '~/styles/global.css';

type Props = Omit<MetaInput, 'path' | 'title'> & {
  /** Page name; becomes "<title> · ZurichJS". Use fullTitle to set the whole <title>. */
  title: string;
  fullTitle?: string;
  path?: string;
  jsonLd?: (Record<string, unknown> | null)[];
};

const { title, fullTitle, path = Astro.url.pathname, jsonLd = [], ...meta } = Astro.props;
const docTitle = fullTitle ?? (title === 'ZurichJS' ? 'ZurichJS · JavaScript meetups in Zurich' : `${title} · ZurichJS`);
const head = buildMeta({ ...meta, title: docTitle, path });
const nextHref = await nextMeetupHref();
const c = await content();
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;
const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST ?? 'https://eu.i.posthog.com';
const schemas = jsonLd.filter((j): j is Record<string, unknown> => !!j);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{head.title}</title>
    <link rel="canonical" href={head.canonical} />
    {head.meta.map((m) => <meta name={m.name} property={m.property} http-equiv={m.httpEquiv} content={m.content} />)}
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/logo-square.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo-square.png" />
    <link rel="preload" href="/fonts/figtree-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
    <link rel="sitemap" href="/sitemap.xml" />
    {schemas.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(schemas.length === 1 ? schemas[0] : schemas)} />}
    {c.source === 'sample' && <meta name="zurichjs-content" content="sample" />}
    {
      posthogKey && (
        <script is:inline define:vars={{ posthogKey, posthogHost }}>
          window.addEventListener('load', () => {
            const s = document.createElement('script');
            s.src = posthogHost.replace('.i.posthog.com', '-assets.i.posthog.com') + '/static/array.js';
            s.async = true;
            s.onload = () => window.posthog?.init(posthogKey, { api_host: posthogHost, person_profiles: 'identified_only' });
            document.head.appendChild(s);
          });
        </script>
      )
    }
  </head>
  <body class="min-h-screen flex flex-col bg-white text-black">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-3 focus:left-3 focus:bg-yellow focus:text-black focus:px-4 focus:py-2 focus:rounded-pill focus:font-bold">Skip to content</a>
    <div class="on-black bg-black text-white">
      <Header nextHref={nextHref} />
      <slot name="opening" />
    </div>
    <main id="main" class="flex-1"><slot /></main>
    <Footer />
    <script>
      // One delegated listener for data-track="<event>" elements (see lib/analytics.ts).
      document.addEventListener('click', (e) => {
        const el = (e.target as Element | null)?.closest<HTMLElement>('[data-track]');
        if (!el) return;
        const props: Record<string, string> = {};
        for (const [k, v] of Object.entries(el.dataset)) if (k.startsWith('track') && k !== 'track' && v) props[k.slice(5).toLowerCase()] = v;
        (window as unknown as { posthog?: { capture: (n: string, p: object) => void } }).posthog?.capture(el.dataset.track!, props);
      });
    </script>
  </body>
</html>
