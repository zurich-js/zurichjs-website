---
/**
 * A whole card that is one choice (membership tier, sponsorship package). A native radio or checkbox,
 * so arrow keys move between radios without script. Frame: 3px grey, yellow when chosen (same width,
 * so nothing shifts). The dot sits on the title's first line and fills yellow when chosen.
 * The Preact twin is islands/ChoiceCard.tsx.
 */
import { choiceCardClass, choiceDotClass } from '../recipes';
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'input'>, 'type' | 'class'> & {
  name: string;
  value: string;
  title: string;
  type?: 'radio' | 'checkbox';
  checked?: boolean;
  /** Heading level of the title, when the choices are sections of the page. */
  level?: 'h3' | 'h4' | 'span';
  /** An id for the title (the input is labelled by it). */
  titleId?: string;
  class?: string;
};
const { name, value, title, type = 'radio', checked = false, level: Title = 'span', titleId, class: extra, ...rest } = Astro.props;
---

<label class={choiceCardClass(extra)}>
  <input type={type} name={name} value={value} checked={checked} class="sr-only" aria-labelledby={titleId} {...rest} />
  <span class="flex items-start gap-4">
    <Title id={titleId} class="m-0 flex-1 min-w-0 font-bold text-balance text-card-title">{title}</Title>
    <span aria-hidden="true" class="flex-none flex items-center h-lh text-card-title">
      <span class={choiceDotClass}>
        <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"></path></svg>
      </span>
    </span>
  </span>
  <slot />
</label>
