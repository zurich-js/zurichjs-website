---
/** About: what ZurichJS is about, the name, the story (a timeline), values, the team, the nonprofit, quotes and ways to take part. */
import { normalizeSearch, zurichDay } from '@zurichjs/events';
import { BEGINNINGS, PARTNERS_TO_DATE, REACH_AS_OF, mediaForEvent, mediaTagged, speakersWithTalks } from '@zurichjs/content';
import { mediaHref } from '~/lib/media';
import { breadcrumbSchema, organizationSchema } from '@zurichjs/seo';
import PageOpening from '@zurichjs/design/components/PageOpening.astro';
import Button from '@zurichjs/design/components/Button.astro';
import Photo from '@zurichjs/design/components/Photo.astro';
import SectionHeading from '@zurichjs/design/components/SectionHeading.astro';
import Card from '@zurichjs/design/components/Card.astro';
import AutoGrid from '@zurichjs/design/components/AutoGrid.astro';
import Heading from '@zurichjs/design/components/Heading.astro';
import Monogram from '@zurichjs/design/components/Monogram.astro';
import StatsPanel from '~/components/about/StatsPanel.astro';
import MilestoneLinks from '~/components/about/MilestoneLinks.astro';
import type { StoryRow } from '~/components/about/story';
import Facts from '@zurichjs/design/components/Facts.astro';
import Tag from '@zurichjs/design/components/Tag.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE, content, nextMeetupHref, slackLink } from '~/lib/content';
import { buttonClass } from '@zurichjs/design/recipes';
import { SocialIcon, socialKind } from '@zurichjs/design/islands/SocialLabel';

const { events, milestones, team, volunteers, quotes, settings, speakers, media } = await content();
const slack = slackLink(settings);
// A milestone links to its event: by slug, or the event held on that day.
const eventsBySlug = new Map(events.map((e) => [e.slug, e]));
const eventOn = (iso: string) => (/^\d{4}-\d{2}-\d{2}$/.test(iso) ? events.find((e) => e.startsAt && zurichDay(e.startsAt) === iso) : undefined);
const milestoneRows = [...milestones]
  .sort((a, b) => a.iso.localeCompare(b.iso))
  .map((m) => {
    const ev = (m.eventSlug && eventsBySlug.get(m.eventSlug)) || eventOn(m.iso);
    const tagged = mediaTagged(media.items, `milestone:${m.iso}`).find((x) => x.kind === 'photo');
    const photo = tagged ? { src: tagged.src, alt: tagged.alt } : m.photo;
    return { m, ev, photo, gallery: ev && mediaForEvent(media.items, ev.slug).length > 0 ? mediaHref(ev.slug) : undefined };
  });
// Organisers who have spoken at ZurichJS link to their speaker profile.
// An explicit speakerId wins (Bogdan's profile is "Bogdan Ilie"); otherwise match by name.
const speakerFor = (m: { name: string; speakerId?: string }) =>
  (m.speakerId && speakers.find((x) => x.id === m.speakerId)) || speakers.find((x) => normalizeSearch(x.name) === normalizeSearch(m.name));
const GROUPS = [
  { k: 'organisers', h: 'Meetup organisers' },
  { k: 'conference', h: 'ZurichJS Conf team' },
  { k: 'contributors', h: 'Contributors' },
] as const;
const nextHref = await nextMeetupHref();

const VALUES = [
  ['Trust', 'We act responsibly with the trust that members place in us to execute on our mission.'],
  ['Authenticity', 'Everyone should feel included. We only promote partners we believe in ourselves.'],
  ['Quality', 'Conference-level experiences in a relaxed meetup space.'],
] as const;

const SUPPORT = [
  { h: 'Become a member', d: 'Join the Swiss JavaScript Group association.', href: '/membership' },
  { h: 'Other ways to help', d: 'Speak, volunteer or support the association.', href: '/donate' },
  { h: 'Host or sponsor a meetup', d: 'Offer a room, food or a contribution.', href: '/partners' },
];

const TOUCH = [
  { label: 'Meetup', href: SITE.meetupGroupUrl },
  { label: slack.external ? 'Slack' : 'Slack (ask for an invite)', href: slack.href },
  { label: 'LinkedIn', href: SITE.linkedinUrl },
  { label: 'Instagram', href: SITE.instagramUrl },
  { label: 'Bluesky', href: SITE.blueskyUrl },
];

const INVOLVE = [
  { h: 'Come to a meetup', d: 'Free, in English, and fine to come alone.', cta: 'See the next meetup', href: nextHref, main: true },
  { h: 'Give a talk', d: 'It doesn’t have to be about JavaScript. First-time speakers get help preparing.', cta: 'Propose a talk', href: '/cfp', main: false },
  { h: 'Volunteer', d: 'After almost every event, someone new offers to help. On the night, with photos, or with the website.', cta: 'Volunteer with us', href: '/cfv', main: false },
  { h: 'Meet the speakers', d: 'Everyone who has spoken so far, and what they talked about.', cta: 'Browse speakers', href: '/speakers', main: false },
];

const isExt = (href: string) => /^https?:/.test(href);

// Then and now [prospectus]: where we started in November 2024, and where we are. The speaker count comes from content.
const speakerCount = speakersWithTalks(speakers).length;
const NOW = [
  { value: '1K+', label: 'Meetup members' },
  { value: '1.6K+', label: 'social media followers' },
  { value: PARTNERS_TO_DATE, label: 'partners and sponsors' },
  { value: String(speakerCount), label: 'speakers' },
];
// The story, oldest first and grouped by year: the beginnings in their place in November 2024, today's reach after the last year.
type Row = StoryRow;
// "Where we started" sits at November 2024, before the first meetup that month.
const sortKey = (r: { key: string }) => (r.key === 'start' ? '2024-11' : r.key);
const rows: Row[] = [
  { key: 'start', title: 'Where we started', date: 'November 2024', stats: BEGINNINGS },
  ...milestoneRows.map(({ m, ev, photo, gallery }) => ({ key: m.iso, title: m.title, date: m.date, text: m.text, photo, ev, gallery, link: m.link })),
].sort((a, b) => sortKey(a).localeCompare(sortKey(b)));
const yearOf = (r: Row) => (r.key === 'start' ? '2024' : r.key.slice(0, 4));
const now: Row = { key: 'now', title: 'Where we are now', date: REACH_AS_OF, stats: NOW };
const years = [...new Set(rows.map(yearOf))].map((y) => ({ y, rows: rows.filter((r) => yearOf(r) === y) }));
---

<BaseLayout
  title="About ZurichJS"
  fullTitle="About ZurichJS · JavaScript community in Zurich"
  description="ZurichJS is the volunteer-run JavaScript community in Zurich since 2024. Who runs it, how it started on personal savings, and how you can take part."
  keywords={['ZurichJS', 'JavaScript community Zurich', 'developer community Switzerland', 'Swiss JavaScript Group', 'JavaScript meetup Zurich']}
  jsonLd={[organizationSchema(), breadcrumbSchema([{ name: 'About', path: '/about' }])]}
>
  <PageOpening
    slot="opening"
    title="A community of developers around JavaScript in Zurich"
    sub="We run meetups and workshops for real networking, where everybody feels welcome and included. Our first event was on 14th November 2024, powered only by personal savings, donated time, and a lot of late nights."
  >
    <div class="flex flex-wrap gap-3 pt-1.5">
      <Button href={nextHref} variant="cta" grow>See the next meetup</Button>
      <Button href="#story" variant="secondary" inverse grow>Read our story</Button>
    </div>
  </PageOpening>

  <div class="flex flex-col gap-section py-section">
    <section aria-labelledby="h-why" class="px-gut grid grid-cols-auto-lg gap-8 md:gap-16 items-start">
      <div class="flex flex-col gap-4">
        <h2 id="h-why" class="m-0 text-section font-bold">Why it’s called ZurichJS</h2>
        <p class="m-0 text-body text-ink-2">People ask this surprisingly often.</p>
        <div class="flex flex-wrap gap-2">
          {['Why not ZurichTS?', 'Why not Zurich Web?', 'Why not Zurich Tech?'].map((q) => <span class="text-body text-ink-2 italic">{q}</span>)}
        </div>
        <p class="m-0 text-card-title font-bold text-black">The short answer is simple: JavaScript is the common ground that brought us together.</p>
      </div>
      <div class="flex flex-col gap-4 text-body text-ink-2 max-w-reading">
        <p class="m-0">Bogdan and Faris first crossed paths at the Zürich ReactJS Meetup. React is a library. Angular is a framework. All of them orbit the same gravity well. JavaScript.</p>
        <p class="m-0">At the time, it was mostly practical. A neutral home base that wasn’t tied to one framework, and most importantly, the Meetup.com group was free!</p>
        <p class="m-0">In the beginning, ZurichJS was just a name. Now it’s a philosophy: accessibility, experimentation, cross-stack thinking, and a welcoming entry point into software.</p>
        <p class="m-0 text-black font-bold">JavaScript just happens to be the banner we stand under. And it turns out that banner is wide enough to welcome everyone.</p>
        <Button href="/about/why-zurichjs" variant="secondary" class="self-start mt-1">Read the full story</Button>
      </div>
    </section>

    <section id="story" aria-labelledby="h-story" class="px-gut flex flex-col gap-7 scroll-mt-6">
      <div class="flex flex-col gap-3">
        <div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
          <Heading as="h2" size="section" id="h-story" class="max-w-wide">From a free Meetup group to a Swiss nonprofit and a conference</Heading>
          <a href="/events?tab=past" class="font-bold text-body underline">
            Browse all past events
          </a>
        </div>
        <p class="m-0 text-body text-ink-2 text-pretty max-w-reading">
          We started with personal financial investments, a LinkedIn page, an inactive Meetup group with no past events, and good relationships that allowed us to host events. Here’s what happened next.
        </p>
      </div>
      {
        years.map(({ y, rows }) => (
          <div class="flex flex-col gap-3">
            <Heading as="h3" size="subsection">{y}</Heading>
            <ol class="m-0 p-0 list-none flex flex-col gap-2">
              {rows.map((r) =>
                r.stats ? (
                  // The beginnings: a full-width panel with the numbers, unlike the milestones around it.
                  <li id={`story-${r.key}`} class="py-3 scroll-mt-6">
                    <StatsPanel row={r} />
                  </li>
                ) : (
                  // The photo takes the first quarter; text always sits in the second column, so every entry lines up.
                  <li id={`story-${r.key}`} class="grid grid-cols-[1fr_minmax(0,3fr)] gap-4 md:gap-6 items-start py-3 scroll-mt-6">
                    {r.photo && (
                      <span class="relative block w-full aspect-video overflow-hidden rounded-nested-min bg-grey">
                        <Photo photo={r.photo} class="absolute inset-0 size-full" sizes="25vw" />
                      </span>
                    )}
                    {r.key === '2024-07' ? (
                      // How it began, told like the testimonials: a card with the words set larger.
                      <Card class="col-span-2" title={r.title} level="h4">
                        <Facts slot="facts" items={[{ label: 'Date', value: r.date, hideLabel: true, strong: true }]} />
                        {r.text && <p class="m-0 text-lead text-pretty">{r.text}</p>}
                        <MilestoneLinks row={r} />
                      </Card>
                    ) : (
                      <div class="col-start-2 flex flex-col gap-1.5 min-w-0">
                        <h4 class="m-0 text-card-title font-bold text-pretty">{r.title}</h4>
                        <Facts items={[{ label: 'Date', value: r.date, hideLabel: true, strong: true }]} />
                        {r.text && <p class="m-0 text-body text-ink-2 text-pretty max-w-reading">{r.text}</p>}
                        <MilestoneLinks row={r} />
                      </div>
                    )}
                  </li>
                ),
              )}
            </ol>
          </div>
        ))
      }
      <div id="story-now" class="scroll-mt-6">
        <StatsPanel row={now} />
      </div>
    </section>

    <section id="values" aria-labelledby="h-values" class="px-gut flex flex-col gap-7 scroll-mt-6">
      <SectionHeading id="h-values">
        Values
        <Fragment slot="sub">A healthy developer community relies on three pillars.</Fragment>
      </SectionHeading>
      <dl class="m-0 grid grid-cols-auto-sm gap-x-10 gap-y-8">
        {
          VALUES.map(([h, d]) => (
            <div class="flex flex-col gap-2 max-w-reading">
              <dt class="text-card-title font-bold">{h}</dt>
              <dd class="m-0 text-body text-ink-2 text-pretty">{d}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id="team" aria-labelledby="h-team" class="px-gut flex flex-col gap-7 scroll-mt-6">
      <SectionHeading id="h-team">
        The people who run it
        <Fragment slot="sub">We’ve built everything by volunteering our time and effort. Say hello at the next meetup; we’re the ones in yellow T-shirts.</Fragment>
      </SectionHeading>
      {
        GROUPS.map((g) => {
          const people = team.filter((m) => m.group === g.k);
          if (!people.length) return null;
          return (
            <div class="flex flex-col gap-4">
              <h3 class="m-0 text-card-title font-bold">{g.h}</h3>
              <ul class="m-0 p-0 list-none grid grid-cols-auto-sm gap-4">
                {people.map((m) => {
                  const sp = speakerFor(m);
                  // No team photo: reuse the person's speaker photo when they have one.
                  const pic = m.photo ?? (sp?.photo ? { ...sp.photo, alt: m.name } : undefined);
                  const social = m.links ?? [];
                  return (
                    // One card per person: with a speaker profile, the whole card opens it in a new tab (the arrow says so).
                    <Card as="li" padding="md" title={m.name} level="h4" href={sp ? `/speakers/${sp.id}` : undefined} external={sp ? true : undefined} mediaLayout="stack" mediaRatio="square">
                      {pic ? <Photo slot="media" photo={pic} sizes="(min-width: 800px) 30vw, 100vw" /> : <Monogram slot="media" initials={m.initials} size="portrait" label={m.name} />}
                      <p class="m-0 text-compact text-ink-2">{m.role}</p>
                      {m.bio && <p class="m-0 text-compact text-ink-2 line-clamp-3">{m.bio.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')}</p>}
                      {social.length > 0 && (
                        // Above the card's link, so each one is its own link.
                        <ul slot="footer" class="relative z-10 m-0 p-0 list-none flex flex-wrap gap-2" aria-label={`${m.name}: links`}>
                          {social.map((l) => {
                            const kind = socialKind(l.label);
                            return (
                              <li>
                                <a href={l.url} target="_blank" rel="noopener" title={l.label} aria-label={`${m.name} on ${l.label} (opens in a new tab)`} class={buttonClass({ variant: 'secondary', iconOnly: !!kind })}>
                                  {kind ? <SocialIcon kind={kind} size={17} /> : l.label}
                                </a>
                              </li>
                            );
                          })}
                        </ul>
                      )}
                    </Card>
                  );
                })}
              </ul>
            </div>
          );
        })
      }
      {
        volunteers.length > 0 && (
          <div class="flex flex-col gap-2.5">
            <h3 class="m-0 text-card-title font-bold">Volunteers</h3>
            <p class="m-0 text-body text-ink-2 max-w-reading">
              ZurichJS Conf 2026 happened thanks to {volunteers.length} volunteers. And after almost every meetup, someone new offers to help.
            </p>
            <ul class="m-0 p-0 list-none flex flex-wrap gap-2 max-w-wide" aria-label="Volunteers at ZurichJS Conf 2026">
              {volunteers.map((v) => (
                <Tag as="li" size="md">{v}</Tag>
              ))}
            </ul>
          </div>
        )
      }
      <div class="flex flex-col items-start gap-4">
        <p class="m-0 text-body text-ink-2 max-w-reading">On the night, with photos, or with the website: there’s room for you too.</p>
        <Button href="/cfv" variant="primary">Volunteer with us</Button>
      </div>
    </section>

    <section id="association" aria-labelledby="h-verein" class="mx-gut border border-grey-frame rounded-block p-6 md:p-14 grid grid-cols-auto-lg gap-x-12 gap-y-7 items-start scroll-mt-6">
      <div class="flex flex-col gap-3.5">
        <h2 id="h-verein" class="m-0 text-subsection font-bold">A nonprofit, run by volunteers</h2>
        <p class="m-0 text-body text-ink-2 text-pretty">
          ZurichJS is a registered non-profit under the Swiss JavaScript Group. All revenue we make goes directly into the conference or venues, speaker travel, workshops, experiences, and the infrastructure that keeps the meetup community running.
        </p>
        <p class="m-0 text-body text-ink-2 text-pretty">Members fund the association and have a say in it. Coming to meetups is free and never needs a membership.</p>
      </div>
      <div class="flex flex-col gap-3">
        {
          SUPPORT.map((x) => (
            <Card href={x.href} title={x.h} surface="filled">
              <p class="m-0 text-compact text-ink-2">{x.d}</p>
            </Card>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="h-quotes" class="px-gut flex flex-col gap-7">
      <h2 id="h-quotes" class="m-0 text-section font-bold">What people tell us afterwards</h2>
      <AutoGrid min="md">
        {
          // Harshil's quote is the one highlighted on the home page; here the others.
          quotes.filter((q) => q.name !== 'Harshil Agrawal').map((q) => (
            <Card>
              <figure class="m-0 flex-1 flex flex-col gap-4 justify-between">
              <blockquote class="m-0 text-lead text-pretty">“{q.text}”</blockquote>
              <figcaption class="text-compact">
                <b>{q.name}</b>
                <br />
                <span class="text-ink-2">{q.role}</span>
                {q.url && (
                  <>
                    <br />
                    <a href={q.url} target="_blank" rel="noopener" class="inline-block mt-1.5 text-compact font-bold underline">
                      Read the post on LinkedIn ↗
                    </a>
                  </>
                )}
              </figcaption>
              </figure>
            </Card>
          ))
        }
      </AutoGrid>
    </section>

    <section id="get-involved" aria-labelledby="h-involved" class="px-gut flex flex-col gap-7 scroll-mt-6">
      <h2 id="h-involved" class="m-0 text-section font-bold">Ways to take part</h2>
      <AutoGrid min="sm">
        {
          INVOLVE.map((w) => (
            <Card title={w.h}>
              <p class="m-0 text-body text-ink-2">{w.d}</p>
              <Button slot="footer" href={w.href} variant={w.main ? 'primary' : 'secondary'}>
                {w.cta}
              </Button>
            </Card>
          ))
        }
      </AutoGrid>
    </section>

    <section aria-labelledby="h-touch" class="px-gut grid grid-cols-auto-lg gap-x-12 gap-y-6 items-center">
      <div class="flex flex-col gap-2.5">
        <h2 id="h-touch" class="m-0 text-section font-bold">Stay in touch between meetups</h2>
        <p class="m-0 text-body text-ink-2">Meetup.com announces every event. Slack is where the conversation keeps going in between.</p>
      </div>
      <div class="flex flex-wrap gap-2.5">
        {
          TOUCH.map((t) => (
            <a
              href={t.href}
              {...(isExt(t.href) ? { target: '_blank' } : {})}
              rel="noopener"
              aria-label={isExt(t.href) ? `ZurichJS on ${t.label} (opens in a new tab)` : undefined}
              class={buttonClass({ variant: 'secondary', grow: true })}
            >
              {/* One colour scheme for every network: outlined, with the brand's own small mark (Bogdan's review). */}
              {socialKind(t.label.split(' ')[0]!) && <SocialIcon kind={socialKind(t.label.split(' ')[0]!)!} size={18} />}
              {t.label}
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
