---
/** A list of points with a bold lead, as filled cards in a grid ("Consistent rhythm: monthly events …"). */
import AutoGrid from '../AutoGrid.astro';
import Card from '../Card.astro';

interface Props {
  items: { t: string; d: string }[];
  /** Narrowest column in px: up to 260 gives the small grid, above it the medium one. */
  min?: number;
  class?: string;
}
const { items, min = 300, class: extra } = Astro.props;
---

<AutoGrid as="ul" min={min <= 260 ? 'sm' : 'md'} gap="sm" class={extra}>
  {
    items.map((it) => (
      <Card as="li" surface="filled">
        <strong class="text-body">{it.t}</strong>
        <span class="text-body text-ink-2 text-pretty">{it.d}</span>
      </Card>
    ))
  }
</AutoGrid>
