---
import { eventHref, monthYear, nextMeetup, pastEvents, eventTalks, talkAnchor, groupPartners } from '@zurichjs/events';
import { localBusinessSchema, organizationSchema, websiteSchema } from '@zurichjs/seo';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ConferenceModule from '@zurichjs/design/components/ConferenceModule.astro';
import HomeHero from '@zurichjs/design/components/HomeHero.astro';
import HostsSection from '@zurichjs/design/components/HostsSection.astro';
import SpeakCta from '@zurichjs/design/components/SpeakCta.astro';
import { SpeakerDeck, type DeckSpeaker } from '~/components/islands/home/SpeakerDeck';
import { sizedSrc, srcsetFor } from '@zurichjs/design/images';
import { speakersWithTalks } from '@zurichjs/content';
import TalkRow, { type TalkRowData } from '@zurichjs/design/components/TalkRow.astro';
import Photo from '@zurichjs/design/components/Photo.astro';
import { BUILD_TIME, PHOTOS, SITE, content, ticketing } from '~/lib/content';
import { pickFeatured } from '@zurichjs/content';

const { events, speakers, rating, award, conference, partners, media } = await content();
const next = nextMeetup(events, BUILD_TIME);
const byId = new Map(speakers.map((s) => [s.id, s]));

const LIKE = [
  {
    t: 'Talks, then time to talk',
    d: 'Two to four talks, a mix of full-length and lightning, on what’s new and on ideas that stand the test of time. Not always about JavaScript, and always open to everyone. Then food, drinks and meeting who else is building things in your city.',
  },
  { t: 'Every framework, every level', d: 'Juniors to CTOs, frontend to infrastructure. JavaScript is the common ground, and the banner is wide enough for everyone.' },
  {
    t: 'A mini-conference in a meetup room',
    d: 'Speakers from Zurich and well beyond, and every practical detail on the event page before you go: cost, language, how to get there, who to ask.',
  },
];

// The latest past talks, each linking straight to the talk on its event page.
const talks: TalkRowData[] = [];
outer: for (const ev of pastEvents(events, BUILD_TIME)) {
  for (const t of eventTalks(ev)) {
    talks.push({
      title: t.title,
      speakers: t.speakerIds.map((id) => byId.get(id)).filter((s) => !!s),
      date: ev.startsAt ? monthYear(ev.startsAt) : '',
      format: t.format === 'lightning' ? 'Lightning talk' : t.format === 'deep-dive' ? 'Deep dive' : 'Talk',
      href: `${eventHref(ev)}#${talkAnchor(t)}`,
    });
    if (talks.length === 4) break outer;
  }
}
// The deck: speakers who gave a talk at an event, most recent first, photos sized for the card.
const lastTalk = (s: (typeof speakers)[number]) => s.talks.flatMap((t) => t.eventSlugs.map((x) => events.find((e) => e.slug === x)?.startsAt ?? '')).sort().pop() ?? '';
const deck: DeckSpeaker[] = speakersWithTalks(speakers)
  .sort((a, b) => lastTalk(b).localeCompare(lastTalk(a)) || a.name.localeCompare(b.name))
  .slice(0, 24)
  .map((s) => ({
    id: s.id,
    name: s.name,
    meta: s.tagline || s.role,
    initials: s.initials,
    photo: s.photo ? { src: sizedSrc(s.photo.src, 720), srcset: srcsetFor(s.photo.src), alt: s.photo.alt, position: s.photo.position } : undefined,
  }));
// Home photos: editors pick them in ImageKit (tag "featured-home"); the defaults fill any gap. No repeats.
const featured = pickFeatured(media.items, 'featured-home', 3);
const asPhoto = (m?: (typeof featured)[number]) => (m ? { src: m.src, alt: m.alt, width: m.width, height: m.height } : undefined);
const heroPhotos = { audience: asPhoto(featured[0]) ?? PHOTOS.audience, speaker: asPhoto(featured[1]) ?? PHOTOS.speaker, conversation: asPhoto(featured[2]) ?? PHOTOS.conversation };
// Current sponsors (only those marked current) at their tier's logo size, then venue hosts and current partners.
const partnerGroups = groupPartners(partners);
---

<BaseLayout
  title="ZurichJS"
  fullTitle="ZurichJS · JavaScript & TypeScript meetups in Zurich, Switzerland"
  description="The JavaScript and TypeScript community in Zurich: free monthly meetups with talks on React, Node.js, Vue, Angular, AI and the web, run by volunteers."
  keywords={['JavaScript meetup Zurich', 'TypeScript meetup Zurich', 'Zurich tech events', 'React Zurich', 'Node.js Zurich', 'Vue Zurich', 'Angular Zurich', 'web development Zurich', 'developer community Switzerland', 'tech talks Zurich', 'ZurichJS']}
  geo
  image="/og/home.png"
  jsonLd={[organizationSchema(), websiteSchema(), localBusinessSchema()]}
>
  <HomeHero slot="opening" next={next} now={BUILD_TIME} ticketing={ticketing} photos={heroPhotos} rating={rating} award={award} meetupGroupUrl={SITE.meetupGroupUrl} />
  <div class="flex flex-col gap-[clamp(64px,8vw,112px)] pt-[clamp(56px,7vw,104px)] pb-[clamp(64px,8vw,112px)]">
    <section aria-labelledby="h-like" class="px-gut grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] gap-[clamp(32px,5vw,72px)] items-center">
      <Photo photo={PHOTOS.speaker} class="aspect-4/3 w-full" />
      <div class="flex flex-col gap-7">
        <h2 id="h-like" class="m-0 text-[clamp(30px,3.4vw,48px)] leading-[1.1] font-bold">What happens at a meetup</h2>
        {
          LIKE.map((l) => (
            <div class="flex flex-col gap-1.5">
              <h3 class="m-0 text-[21px] font-bold">{l.t}</h3>
              <p class="m-0 text-[18px] leading-[1.55] text-ink-2 text-pretty">{l.d}</p>
            </div>
          ))
        }
        <figure class="m-0 flex flex-col gap-2.5">
          <blockquote class="m-0 text-[clamp(20px,1.9vw,24px)] leading-[1.45] font-bold text-pretty">“It felt like a large group of friends because folks knew each other, and were also very welcoming.”</blockquote>
          <figcaption class="text-[16px] text-ink-2">Harshil Agrawal, Dev Educator at Cloudflare</figcaption>
        </figure>
      </div>
    </section>

    {
      talks.length > 0 && (
        <section aria-labelledby="h-talks" class="px-gut flex flex-col gap-7">
          <div class="flex justify-between items-baseline gap-4 flex-wrap">
            <h2 id="h-talks" class="m-0 text-[clamp(30px,3.4vw,48px)] leading-[1.1] font-bold">
              Talks from past meetups
            </h2>
            <a href="/events?tab=past" class="font-bold text-[18px] underline underline-offset-4">
              All past events
            </a>
          </div>
          <div class="flex flex-col gap-2">
            {talks.map((t) => (
              <TalkRow t={t} />
            ))}
          </div>
        </section>
      )
    }

    <ConferenceModule conference={conference} />

    <section aria-labelledby="h-speakers" class="px-gut flex flex-col gap-7 overflow-x-clip">
      <div class="flex justify-between items-baseline gap-4 flex-wrap">
        <h2 id="h-speakers" class="m-0 text-[clamp(30px,3.4vw,48px)] leading-[1.1] font-bold">Meet the speakers</h2>
        <a href="/speakers" class="font-bold text-[18px] underline underline-offset-4">All speakers</a>
      </div>
      <SpeakerDeck client:visible speakers={deck} />
      <SpeakCta />
    </section>

    <HostsSection sponsors={partnerGroups.currentSponsors} partners={[...partnerGroups.venues, ...partnerGroups.conferences, ...partnerGroups.communities, ...partnerGroups.supporting]} />
  </div>
</BaseLayout>
