---
/**
 * Navigation in the conference's pattern (Bogdan's review, 4th November 2026): sticky, flat on the black
 * opening at the top of the page and a floating black pill once the page scrolls. Desktop: links, the
 * "Get involved" menu, social icons, a divider and the one action. Phones: an icon button that opens a
 * full-screen menu (a modal <dialog>: focus stays inside, Escape closes it, the page behind can't scroll,
 * and focus returns to the button).
 */
import { buttonClass, cx } from '../recipes';
import { SocialIcon, type Social } from '../islands/SocialLabel';

interface Props {
  /** Social links shown in the bar (desktop) and at the bottom of the phone menu. */
  social?: readonly { kind: Social; label: string; href: string }[];
}
const { social = [] } = Astro.props;

// The header's one action: submitting a talk (owner, 4th November 2026).
const CTA = { label: 'Submit a talk', href: '/cfp' };
const NAV = [
  { label: 'Events', href: '/events', match: ['/events', '/feedback', '/today'] },
  { label: 'Speakers', href: '/speakers', match: ['/speakers'] },
  { label: 'Media', href: '/media', match: ['/media'] },
  { label: 'About', href: '/about', match: ['/about'] },
];
/** Ways to take part. On desktop they sit behind "Get involved"; the phone menu lists them. */
const INVOLVED = [
  { label: 'Speak at a meetup', href: '/cfp' },
  { label: 'Membership', href: '/membership' },
  { label: 'Volunteer', href: '/cfv' },
  { label: 'Host or sponsor', href: '/partners' },
  { label: 'Donate', href: '/donate' },
  { label: 'Contact', href: '/contact' },
];
const path = Astro.url.pathname.replace(/\.html$/, '');
const isCurrent = (m: string[]) => m.some((p) => path === p || path.startsWith(p + '/'));
const involvedCurrent = isCurrent(INVOLVED.map((i) => i.href));
const barSocial = social.filter((s) => ['linkedin', 'instagram', 'bluesky'].includes(s.kind));
// White marks as on conf.zurichjs.com: 24px glyphs in a 40px round hit area (for the focus ring).
const iconLink = 'w-10 h-10 rounded-full flex items-center justify-center text-white hover:opacity-70';
---

<!-- Scrolled once this leaves the viewport. It sits outside the header, so the header's own height can't flip the state back. -->
<div data-scroll-sentinel aria-hidden="true" class="absolute top-10 left-0 w-px h-px pointer-events-none"></div>
<header data-site-header class="site-header on-black sticky top-0 z-50 bg-black text-white">
  <div data-bar class="bar flex items-center justify-between gap-4 py-4 px-gut">
    <a href="/" aria-label="ZurichJS home" class="flex shrink-0">
      <img src="/images/logo/wordmark-white.svg" alt="ZurichJS" width="274" height="40" class="block w-30 h-auto" />
    </a>

    <nav aria-label="Main" class="hidden md:flex items-center gap-[clamp(14px,1.9vw,28px)] text-[clamp(15px,1.45vw,17px)] whitespace-nowrap">
      {
        NAV.map((n) => (
          <a href={n.href} aria-current={isCurrent(n.match) ? 'page' : undefined} class={cx('py-1.5 font-bold no-underline hover:text-grey-mid', isCurrent(n.match) ? 'text-white underline decoration-2 underline-offset-8' : 'text-white')}>
            {n.label}
          </a>
        ))
      }
      <div class="relative" data-involved>
        <button
          type="button"
          data-involved-toggle
          aria-expanded="false"
          aria-controls="involved-menu"
          class={cx('flex items-center gap-1.5 py-1.5 bg-transparent border-0 p-0 font-bold text-[length:inherit] cursor-pointer hover:text-grey-mid', involvedCurrent ? 'text-white underline decoration-2 underline-offset-8' : 'text-white')}
        >
          Get involved
          <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" class="shrink-0 transition-transform [[aria-expanded=true]>&]:rotate-180"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <ul id="involved-menu" hidden class="absolute right-0 top-full z-50 mt-3 w-60 list-none m-0 p-3 bg-black rounded-card [&:not([hidden])]:block">
          {
            INVOLVED.map((i) => (
              <li>
                <a href={i.href} aria-current={isCurrent([i.href]) ? 'page' : undefined} class={cx('block px-3 py-2.5 rounded-pill font-bold no-underline hover:text-grey-mid', isCurrent([i.href]) ? 'text-white underline decoration-2 underline-offset-4' : 'text-white')}>
                  {i.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      {
        barSocial.length > 0 && (
          <>
            <ul class="hidden lg:flex m-0 p-0 list-none items-center gap-0.5" aria-label="ZurichJS on social media">
              {barSocial.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener" aria-label={`ZurichJS on ${s.label} (opens in a new tab)`} title={s.label} class={iconLink}>
                    <SocialIcon kind={s.kind} size={24} tone="white" />
                  </a>
                </li>
              ))}
            </ul>
            <span aria-hidden="true" class="hidden lg:block w-px h-6 bg-grey-text" />
          </>
        )
      }
      <a href={CTA.href} class={buttonClass('yellow', 'md', false, 'min-h-0! py-2.5 px-[clamp(16px,1.6vw,22px)] text-[length:inherit]')}>{CTA.label}</a>
    </nav>

    <button type="button" data-menu-open aria-haspopup="dialog" aria-controls="mobile-nav" aria-label="Open menu" class="md:hidden inline-flex items-center justify-center w-11 h-11 -mr-2 bg-transparent border-0 text-white cursor-pointer hover:text-grey-mid">
      <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
  </div>
</header>

<dialog id="mobile-nav" aria-label="Menu" class="mobile-nav on-black m-0 p-0 w-full max-w-none h-dvh max-h-none bg-black text-white border-0">
  <div class="flex flex-col min-h-full">
    <div class="flex items-center justify-between py-4 px-gut">
      <a href="/" aria-label="ZurichJS home" class="flex"><img src="/images/logo/wordmark-white.svg" alt="ZurichJS" width="274" height="40" class="block w-30 h-auto" /></a>
      <button type="button" data-menu-close aria-label="Close menu" class="inline-flex items-center justify-center w-11 h-11 -mr-2 bg-transparent border-0 text-white cursor-pointer hover:text-grey-mid">
        <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <nav aria-label="Main" class="flex-1 flex flex-col justify-center gap-1 px-gut py-6">
      {
        NAV.map((n) => (
          <a href={n.href} aria-current={isCurrent(n.match) ? 'page' : undefined} class={cx('py-2 text-[28px] font-bold no-underline', isCurrent(n.match) ? 'text-white underline decoration-2 underline-offset-8' : 'text-white')}>
            {n.label}
          </a>
        ))
      }
      <p id="mobile-involved" class="mt-5 mb-1 text-[17px] text-grey-mid">Get involved</p>
      <ul aria-labelledby="mobile-involved" class="list-none m-0 p-0 flex flex-col">
        {
          INVOLVED.map((i) => (
            <li>
              <a href={i.href} aria-current={isCurrent([i.href]) ? 'page' : undefined} class={cx('block py-1.5 text-[20px] font-bold no-underline', isCurrent([i.href]) ? 'text-white underline decoration-2 underline-offset-4' : 'text-white')}>
                {i.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={CTA.href} class={buttonClass('yellow', 'md', false, 'mt-6 self-start text-[17px]')}>{CTA.label}</a>
    </nav>
    {
      social.length > 0 && (
        <ul class="m-0 p-0 list-none flex flex-wrap gap-2 px-gut pb-8" aria-label="ZurichJS on social media">
          {social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener" aria-label={`ZurichJS on ${s.label} (opens in a new tab)`} class="w-11 h-11 rounded-full flex items-center justify-center text-white hover:opacity-70">
                <SocialIcon kind={s.kind} size={24} tone="white" />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</dialog>

<style>
  /*
   * Scrolled: the bar floats as a black pill with space around it (the conference's nav).
   * The header keeps the same height in both states (8 + 12 + 12 = 16 + 16), so the page below never moves,
   * and only the colours, the corners, the shadow and the side inset animate.
   */
  .site-header {
    overflow-anchor: none;
  }
  .site-header[data-scrolled] {
    background-color: transparent;
    padding: 8px var(--gut) 0;
  }
  .site-header[data-scrolled] .bar {
    background-color: #000;
    border-radius: 40px;
    padding-top: 12px;
    padding-bottom: 12px;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.18);
  }
  @media (max-width: 799px) {
    /* Phones: the bar stays full width and flat. */
    .site-header[data-scrolled] {
      background-color: #000;
      padding: 0;
    }
    .site-header[data-scrolled] .bar {
      border-radius: 0;
      padding-top: 16px;
      padding-bottom: 16px;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .site-header {
      transition:
        background-color 300ms ease,
        padding-inline 300ms ease;
    }
    .site-header .bar {
      transition:
        background-color 300ms ease,
        border-radius 300ms ease,
        box-shadow 300ms ease;
    }
  }
  .mobile-nav::backdrop {
    background: #000;
  }
  :global(html:has(dialog.mobile-nav[open])) {
    overflow: hidden;
  }
</style>

<script>
  // Sticky bar: flat at the top of the page, a floating pill once the sentinel 40px down has scrolled out of view.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const sentinel = document.querySelector('[data-scroll-sentinel]');
  if (header && sentinel) {
    new IntersectionObserver((entries) => {
      const e = entries.at(-1);
      if (e) header.toggleAttribute('data-scrolled', !e.isIntersecting && e.boundingClientRect.top < 0);
    }).observe(sentinel);
  }

  // Phone menu: a modal dialog (focus stays inside, Escape closes it, focus returns to the button).
  const dialog = document.getElementById('mobile-nav') as HTMLDialogElement | null;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  openBtn?.addEventListener('click', () => {
    dialog?.showModal();
    openBtn.setAttribute('aria-expanded', 'true');
  });
  dialog?.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('close', () => {
    openBtn?.setAttribute('aria-expanded', 'false');
    openBtn?.focus();
  });
  // A link to a section on the same page closes the menu as it navigates.
  dialog?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => dialog.close()));
  // Wider than 800px the menu isn't needed.
  matchMedia('(min-width: 800px)').addEventListener('change', (e) => e.matches && dialog?.open && dialog.close());

  // "Get involved" disclosure: click toggles; Escape, a click outside or tabbing away closes it.
  const wrap = document.querySelector<HTMLElement>('[data-involved]');
  const toggle = wrap?.querySelector<HTMLButtonElement>('[data-involved-toggle]');
  const menu = document.getElementById('involved-menu');
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    if (menu) menu.hidden = !open;
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  wrap?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
  wrap?.addEventListener('focusout', (e) => {
    if (!wrap.contains(e.relatedTarget as Node | null)) setOpen(false);
  });
  document.addEventListener('click', (e) => {
    if (wrap && !wrap.contains(e.target as Node)) setOpen(false);
  });
</script>
