---
/**
 * "Speak at a meetup": the home page's only large yellow section (Bogdan's review, 4th November 2026),
 * on the scale of the conference's ticket section: full width, centred, one clear action.
 */
import Button from './Button.astro';
import Heading from './Heading.astro';
---

<section aria-labelledby="h-speak" class="bg-yellow text-black px-gut py-18 md:py-24 lg:py-36">
  <div class="mx-auto max-w-reading flex flex-col items-center text-center gap-4 lg:gap-6">
    <Heading id="h-speak" size="title">Speak at a meetup</Heading>
    <p class="m-0 text-lead text-pretty">
      Does it have to be about JavaScript? Not really. We’ve had talks on Laravel, careers, infrastructure and observability. A 10-minute lightning talk or a 20-minute full talk. First-time speakers are welcome, and we help you prepare.
    </p>
    <Button href="/cfp" variant="primary" class="mt-2">Propose a talk</Button>
  </div>
</section>
