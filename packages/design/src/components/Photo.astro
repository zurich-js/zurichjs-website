---
/**
 * A cover-cropped photo with rounded corners. With `ratio` it is as wide as its parent and that shape (a speaker's
 * square); without, it fills its parent, so give the parent a size (16:9 below 1100px when the parent has none).
 * It fades in once loaded, over the grey (motion.load).
 */
import type { Photo } from '@zurichjs/events';
import { srcFor, srcsetFor } from '../images';
import { cx, motion } from '../recipes';

interface Props {
  photo: Photo;
  class?: string;
  /** Above the fold: load eagerly with high priority. */
  priority?: boolean;
  /** The `sizes` attribute: how wide the photo is rendered. */
  sizes?: string;
  /** Its own shape, full width: speakers are square. Without it, the photo fills its parent. */
  ratio?: 'square' | 'video' | 'landscape' | 'wide';
  /** Crops in 10% closer (speaker cards: more face, less background). */
  zoom?: boolean;
}
const { photo, class: extra, priority = false, sizes = '(min-width: 800px) 50vw, 100vw', ratio, zoom = false } = Astro.props;
const RATIO = { square: 'aspect-square', video: 'aspect-video', landscape: 'aspect-4/3', wide: 'aspect-3/2' };
---

<span class={cx('relative isolate block overflow-hidden rounded-card bg-grey', ratio ? cx('w-full', RATIO[ratio]) : 'size-full max-lg:aspect-video', extra)}>
  <img
    src={srcFor(photo.src)}
    srcset={srcsetFor(photo.src)}
    sizes={sizes}
    alt={photo.alt}
    width={photo.width}
    height={photo.height}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
    class={cx(motion.load, 'absolute inset-0 size-full object-cover', zoom && 'scale-110')}
    style={{ objectPosition: photo.position ?? 'center' }}
  />
</span>
