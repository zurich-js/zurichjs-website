---
/**
 * One event in the list: date tile, title, then one line of facts (status, talks, venue). The whole row
 * is one link, with the card's arrow on the title's first line.
 */
import { dateParts, eventHref, presentEvent, talkCount, type Event, type TicketingProvider } from '@zurichjs/events';
import { cx } from '../recipes';
import Facts from './Facts.astro';

interface Props {
  ev: Event;
  /** Reference clock (build time). */
  now: Date;
  ticketing?: TicketingProvider;
}
const { ev, now, ticketing } = Astro.props;
const p = presentEvent(ev, { now, ticketing });
const upcoming = p.state !== 'past';
const parts = ev.startsAt ? dateParts(ev.startsAt) : { mon: ev.dateText?.slice(0, 3) ?? 'TBC', day: '?', suffix: '', year: ev.dateText?.slice(-4) ?? '' };
const status = upcoming ? p.stateLabel : ev.recap ? 'Recap' : 'Past';
const n = talkCount(ev);
const facts = [
  { label: 'Status', value: status, hideLabel: true, strong: true },
  { label: 'Type', value: 'Meetup', hideLabel: true },
  { label: 'Talks', value: `${n} talk${n === 1 ? '' : 's'}`, hideLabel: true },
  ...(upcoming ? [{ label: 'Venue', value: p.venueShort, hideLabel: true }, { label: 'Cost', value: 'Free', hideLabel: true }] : ev.photos.length ? [{ label: 'Media', value: 'Photos', hideLabel: true }] : []),
];
---

<a
  href={eventHref(ev)}
  data-event-row
  data-upcoming={String(upcoming)}
  data-search={`${ev.title} ${ev.description} ${ev.venue?.name ?? ''}`.toLowerCase()}
  class="group no-underline text-black w-full text-left rounded-card bg-white hover:bg-grey-soft transition-colors grid grid-cols-[80px_minmax(0,1fr)] gap-[clamp(16px,2vw,28px)] items-center p-3.5 -mx-3.5 box-content"
>
  <span class={cx('flex flex-col items-center justify-center h-20 rounded-nested-min', upcoming ? 'bg-black text-white' : 'bg-grey')}>
    <span class="text-meta font-bold">{parts.mon}</span>
    <span class="text-[30px] font-bold leading-none">{parts.day}<span class="text-meta align-top">{parts.suffix}</span></span>
    <span class="text-meta">{parts.year}</span>
  </span>
  <div class="flex flex-col gap-1.5 min-w-0">
    <div class="flex items-start gap-4">
      <span class="flex-1 min-w-0 text-card-title font-bold text-pretty">{ev.title}</span>
      <span aria-hidden="true" class="text-card-title flex-none flex items-center h-lh">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 flex-none transition-transform group-hover:translate-x-1">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </span>
    </div>
    <Facts items={facts} />
  </div>
</a>
